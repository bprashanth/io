@@ -0,0 +1,173 @@
+import { useCallback, useMemo, useRef, useState } from "react";
+import { Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { useFetchQuery } from "@/data/query";
+import { PressHighlight } from "@/components/ui/press-highlight";
+import { useHostRuntimeClient } from "@/runtime/host-runtime";
+import { useToast } from "@/contexts/toast-context";
+import {
+  IDLI_MINIS_URL,
+  IdliMinisSchema,
+  miniDate,
+  miniDisplayText,
+  miniMessage,
+  type IdliMini,
+} from "@/utils/idli-minis";
+
+interface MiniListProps {
+  onSubmit: (text: string) => Promise<void>;
+  disabled?: boolean;
+}
+
+export function IdliMiniCartridges(props: MiniListProps | { serverId: string; agentId: string }) {
+  if ("onSubmit" in props) return <MiniCartridgeList {...props} />;
+  return <AgentMiniCartridges {...props} />;
+}
+
+function AgentMiniCartridges({ serverId, agentId }: { serverId: string; agentId: string }) {
+  const client = useHostRuntimeClient(serverId);
+  const submit = useCallback(
+    async (text: string) => {
+      if (!client) throw new Error("Reconnect to your host, then try again.");
+      await client.sendAgentMessage(agentId, text);
+    },
+    [client, agentId],
+  );
+  return <MiniCartridgeList onSubmit={submit} />;
+}
+
+function MiniCartridgeList({ onSubmit, disabled = false }: MiniListProps) {
+  const toast = useToast();
+  const sending = useRef(false);
+  const [selectedId, setSelectedId] = useState<string | null>(null);
+  const minis = useFetchQuery({
+    queryKey: ["idli-minis-public"],
+    queryFn: async ({ signal }) => {
+      const response = await fetch(IDLI_MINIS_URL, { signal, credentials: "omit" });
+      if (!response.ok) throw new Error("Could not load Minis");
+      return IdliMinisSchema.parse(await response.json());
+    },
+    staleTimeMs: 60_000,
+    refetchInterval: 15_000,
+    dataShape: "list",
+  });
+  const refetch = minis.refetch;
+  const retry = useCallback(() => {
+    void refetch();
+  }, [refetch]);
+  const openMini = useCallback(
+    async (mini: IdliMini) => {
+      if (sending.current || disabled) return;
+      sending.current = true;
+      setSelectedId(mini.id);
+      try {
+        await onSubmit(miniMessage(mini));
+        // Keep rows disabled until the timeline removes them after delivery.
+      } catch {
+        sending.current = false;
+        setSelectedId(null);
+        toast.error("Could not open this Mini. Try again.");
+      }
+    },
+    [onSubmit, disabled, toast],
+  );
+
+  return (
+    <View style={styles.list} testID="idli-mini-cartridges">
+      {selectedId ? <Text style={styles.status}>Opening Mini</Text> : null}
+      {minis.isPending ? <Text style={styles.status}>Loading Minis</Text> : null}
+      {minis.error ? (
+        <View style={styles.feedback}>
+          <Text style={styles.status}>Could not load Minis</Text>
+          <PressHighlight accessibilityRole="button" onPress={retry}>
+            <Text style={styles.retry}>Try again</Text>
+          </PressHighlight>
+        </View>
+      ) : null}
+      {minis.data?.length === 0 ? (
+        <Text style={styles.status}>Your saved Minis will appear here.</Text>
+      ) : null}
+      {minis.data?.map((mini) => (
+        <MiniRow
+          key={mini.id}
+          mini={mini}
+          selectedId={selectedId}
+          disabled={disabled}
+          onOpen={openMini}
+        />
+      ))}
+    </View>
+  );
+}
+
+function MiniRow({
+  mini,
+  selectedId,
+  disabled,
+  onOpen,
+}: {
+  mini: IdliMini;
+  selectedId: string | null;
+  disabled: boolean;
+  onOpen: (mini: IdliMini) => Promise<void>;
+}) {
+  const onPress = useCallback(() => void onOpen(mini), [onOpen, mini]);
+  const accessibilityState = useMemo(
+    () => ({ disabled: disabled || selectedId !== null, busy: selectedId === mini.id }),
+    [disabled, selectedId, mini.id],
+  );
+  return (
+    <PressHighlight
+      accessibilityRole="button"
+      disabled={disabled || selectedId !== null}
+      accessibilityState={accessibilityState}
+      onPress={onPress}
+      highlightStyle={styles.highlight}
+    >
+      <View style={[styles.row, selectedId === mini.id && styles.pending]}>
+        <Text style={styles.summary} numberOfLines={1}>
+          <Text style={styles.name}>{miniDisplayText(mini.name)}</Text>
+          {" - "}
+          {miniDisplayText(mini.heading)}
+        </Text>
+        <Text style={styles.metadata} numberOfLines={1}>
+          {[miniDate(mini.date), miniDisplayText(mini.author)]
+            .filter((part) => part.trim())
+            .join(" - ")}
+        </Text>
+      </View>
+    </PressHighlight>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  list: { width: "100%", paddingVertical: theme.spacing[2], gap: theme.spacing[1] },
+  status: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm },
+  feedback: { gap: theme.spacing[2] },
+  retry: { color: theme.colors.accent, fontSize: theme.fontSize.sm },
+  row: {
+    _web: { _hover: { borderColor: theme.colors.accent } },
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+    paddingHorizontal: theme.spacing[3],
+    paddingVertical: theme.spacing[2],
+    borderRadius: theme.borderRadius.md,
+    borderWidth: 1,
+    borderColor: theme.colors.border,
+    borderLeftWidth: 4,
+    borderLeftColor: theme.colors.accent,
+    backgroundColor: theme.colors.surface1,
+  },
+  highlight: { backgroundColor: theme.colors.surface1 },
+  pending: { opacity: 0.5 },
+  summary: { flex: 1, minWidth: 0, color: theme.colors.foreground, fontSize: theme.fontSize.sm },
+  name: { fontWeight: theme.fontWeight.bold },
+  metadata: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+    maxWidth: "38%",
+    textAlign: "right",
+    flexShrink: 0,
+  },
+}));

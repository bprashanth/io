@@ -0,0 +1,35 @@
+import { useMemo } from "react";
+import { useSessionStore } from "@/stores/session-store";
+import { collectAllTabs, useWorkspaceLayoutStore } from "@/stores/workspace-layout-store";
+import { buildWorkspaceTabPersistenceKey } from "@/workspace-tabs/model";
+import { isDriveyDraft } from "@/utils/idli-claude-workspace";
+import { isDriveyLeft, isDriveyProject } from "@/utils/idli-drivey";
+
+export function useDriveyWorkspace(serverId: string, workspaceId: string): boolean {
+  const workspace = useSessionStore((state) =>
+    state.sessions[serverId]?.workspaces.get(workspaceId),
+  );
+  const agents = useSessionStore((state) => state.sessions[serverId]?.agents);
+  const details = useSessionStore((state) => state.sessions[serverId]?.agentDetails);
+  const matchesSession = useMemo(() => {
+    if (isDriveyProject(workspace)) return true;
+    for (const collection of [agents, details]) {
+      if (!collection) continue;
+      for (const agent of collection.values()) {
+        if (agent.workspaceId === workspaceId && isDriveyLeft(agent)) return true;
+      }
+    }
+    return false;
+  }, [workspace, workspaceId, agents, details]);
+  const key = buildWorkspaceTabPersistenceKey({ serverId, workspaceId });
+  const layout = useWorkspaceLayoutStore((state) =>
+    key ? state.layoutByWorkspace[key] : undefined,
+  );
+  const hasDraft = useMemo(() => {
+    if (!layout) return false;
+    return collectAllTabs(layout.root).some(
+      (tab) => tab.target.kind === "draft" && isDriveyDraft(tab.target.draftId),
+    );
+  }, [layout]);
+  return matchesSession || hasDraft;
+}

diff --git a/packages/app/src/components/markdown/idli-chart/embed.web.tsx b/packages/app/src/components/markdown/idli-chart/embed.web.tsx
new file mode 100644
index 00000000..199cdb42
--- /dev/null
+++ b/packages/app/src/components/markdown/idli-chart/embed.web.tsx
@@ -0,0 +1,161 @@
+import { useCallback, useEffect, useReducer, useState } from "react";
+import { Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { Button } from "@/components/ui/button";
+import { Modal } from "@/components/ui/modal";
+import { ChartSurface } from "./surface";
+import type { IdliChartEmbedProps } from "./types";
+import { idliPageHeight } from "./markdown";
+
+type ChartState = "loading" | "ready" | "enlarged";
+type ChartAction = "loaded" | "enlarge" | "close";
+
+function chartState(state: ChartState, action: ChartAction): ChartState {
+  if (action === "enlarge") return "enlarged";
+  if (action === "close") return "ready";
+  return state === "loading" ? "ready" : state;
+}
+
+export function IdliChartEmbed({
+  url,
+  title,
+  onFailed,
+  height = 320,
+  enlarge: canEnlarge = true,
+  page = false,
+  noScroll = false,
+}: IdliChartEmbedProps) {
+  const [state, dispatch] = useReducer(chartState, "loading");
+  const [pageHeight, setPageHeight] = useState(height);
+  const resize = useCallback((px: number) => {
+    const next = idliPageHeight(px);
+    if (next !== null) setPageHeight(next);
+  }, []);
+  const loaded = useCallback(() => dispatch("loaded"), []);
+  const enlarge = useCallback(() => dispatch("enlarge"), []);
+  const close = useCallback(() => dispatch("close"), []);
+  const failed = useCallback(() => onFailed(url), [onFailed, url]);
+  useEffect(() => {
+    if (state !== "loading") return;
+    const timeout = window.setTimeout(failed, 5_000);
+    return () => window.clearTimeout(timeout);
+  }, [failed, state]);
+  return (
+    <View style={styles.container} testID="idli-chart">
+      <View style={[styles.frame, noScroll && styles.driveyFrame, { height: pageHeight }]}>
+        <ChartSurface
+          url={url}
+          title={title}
+          onLoad={loaded}
+          onError={failed}
+          onHeight={resize}
+          page={page}
+          noScroll={noScroll}
+        />
+      </View>
+      <View style={styles.toolbar}>
+        {state === "loading" ? (
+          <Text style={styles.status}>Opening {title.toLowerCase()}</Text>
+        ) : null}
+        {canEnlarge ? (
+          <Button variant="ghost" size="sm" onPress={enlarge} disabled={state === "loading"}>
+            Enlarge
+          </Button>
+        ) : null}
+      </View>
+      {state === "enlarged" ? (
+        <EnlargedChart url={url} title={title} onClose={close} onFailed={failed} page={page} />
+      ) : null}
+    </View>
+  );
+}
+
+interface EnlargedChartProps {
+  page: boolean;
+  url: string;
+  title: string;
+  onClose: () => void;
+  onFailed: () => void;
+}
+
+function EnlargedChart({ url, title, onClose, onFailed, page }: EnlargedChartProps) {
+  const [ready, loaded] = useReducer(() => true, false);
+  useEffect(() => {
+    if (ready) return;
+    const timeout = window.setTimeout(onFailed, 5_000);
+    return () => window.clearTimeout(timeout);
+  }, [onFailed, ready]);
+  useEffect(() => {
+    function keydown(event: KeyboardEvent) {
+      if (event.key !== "Escape") return;
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      onClose();
+    }
+    window.addEventListener("keydown", keydown, true);
+    return () => window.removeEventListener("keydown", keydown, true);
+  }, [onClose]);
+  return (
+    <Modal visible transparent animationType="fade" onRequestClose={onClose}>
+      <View style={styles.backdrop}>
+        <View style={styles.dialog} role="dialog" aria-label={title} testID="idli-chart-enlarged">
+          <View style={styles.header}>
+            <Text style={styles.title} numberOfLines={1}>
+              {title}
+            </Text>
+            <Button variant="ghost" size="sm" onPress={onClose}>
+              Close
+            </Button>
+          </View>
+          <View style={styles.largeFrame}>
+            <ChartSurface
+              url={url}
+              title={title}
+              onLoad={loaded}
+              onError={onFailed}
+              onEscape={onClose}
+              page={page}
+            />
+          </View>
+        </View>
+      </View>
+    </Modal>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  container: { width: "100%", minWidth: 0 },
+  frame: { height: 320, width: "100%", backgroundColor: theme.colors.surface0 },
+  driveyFrame: { minWidth: 0, overflow: "hidden" },
+  toolbar: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "flex-end",
+    gap: theme.spacing[2],
+  },
+  status: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm },
+  backdrop: {
+    flex: 1,
+    alignItems: "center",
+    justifyContent: "center",
+    padding: theme.spacing[6],
+    backgroundColor: "rgba(0, 0, 0, 0.6)",
+  },
+  dialog: {
+    width: "100%",
+    height: "90%",
+    maxWidth: 1440,
+    backgroundColor: theme.colors.surface0,
+    borderRadius: theme.borderRadius.lg,
+    overflow: "hidden",
+  },
+  header: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+    gap: theme.spacing[2],
+    padding: theme.spacing[3],
+  },
+  title: { flex: 1, color: theme.colors.foreground, fontSize: theme.fontSize.base },
+  largeFrame: { flex: 1, minHeight: 0 },
+}));
diff --git a/packages/app/src/components/markdown/idli-chart/markdown.test.ts b/packages/app/src/components/markdown/idli-chart/markdown.test.ts

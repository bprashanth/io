+import {
+  isDriveyLeft,
+  isDriveyProject,
+  isIdliDashboardUrl,
+  openedMiniName,
+  driveyVisibleItems,
+} from "./idli-drivey";
+import { describe, expect, it } from "vitest";
+import type { StreamItem } from "@/types/stream";
+import {
+  hasOnlyDriveyOpening,
+  IDLI_DRIVEY_OPENING,
+  IdliMinisSchema,
+  miniDate,
+  miniDisplayText,
+  miniMessage,
+  shouldShowIdliMinis,
+} from "./idli-minis";
+
+const timestamp = new Date("2026-11-14T00:00:00Z");
+const opening: StreamItem[] = [
+  { kind: "user_message", id: "start", text: "Start Drivey", timestamp },
+  { kind: "assistant_message", id: "reply", text: IDLI_DRIVEY_OPENING, timestamp },
+];
+
+describe("Drivey Mini cartridges", () => {
+  it("shows only during the opening exchange, including a streaming greeting", () => {
+    expect(hasOnlyDriveyOpening(opening)).toBe(true);
+    expect(hasOnlyDriveyOpening(opening.slice(0, 1))).toBe(true);
+    expect(
+      hasOnlyDriveyOpening([
+        ...opening.slice(0, 1),
+        { kind: "assistant_message", id: "partial", text: "Ask about", timestamp },
+      ]),
+    ).toBe(true);
+    expect(hasOnlyDriveyOpening([])).toBe(false);
+  });
+  it("hides for a Mini, manual prompt, chart, or another assistant response", () => {
+    for (const text of [
+      "Open Mini: Sales [sales]",
+      "Find @Drive/Sales",
+      "Chart from Claude: Sales",
+    ]) {
+      expect(
+        hasOnlyDriveyOpening([...opening, { kind: "user_message", id: "next", text, timestamp }]),
+      ).toBe(false);
+    }
+    expect(hasOnlyDriveyOpening([...opening, opening[1]])).toBe(false);
+    expect(
+      hasOnlyDriveyOpening([
+        { kind: "user_message", id: "other", text: "Something else", timestamp },
+      ]),
+    ).toBe(false);
+  });
+  it("requires the left label, complete history and no pending prompt", () => {
+    const input = {
+      isLeft: true,
+      readOnly: false,
+      historyReady: true,
+      hasOlder: false,
+      pendingCount: 0,
+      tail: opening,
+      head: undefined,
+    };
+    expect(shouldShowIdliMinis(input)).toBe(true);
+    expect(shouldShowIdliMinis({ ...input, isLeft: false })).toBe(false);
+    expect(shouldShowIdliMinis({ ...input, readOnly: true })).toBe(false);
+    expect(shouldShowIdliMinis({ ...input, historyReady: false })).toBe(false);
+    expect(shouldShowIdliMinis({ ...input, hasOlder: true })).toBe(false);
+    expect(shouldShowIdliMinis({ ...input, pendingCount: 1 })).toBe(false);
+    expect(
+      shouldShowIdliMinis({
+        ...input,
+        head: [{ kind: "user_message", id: "next", text: "Sales", timestamp }],
+      }),
+    ).toBe(false);
+  });
+  it("validates public records and sends exactly the named Mini", () => {
+    const [mini] = IdliMinisSchema.parse([
+      {
+        id: "sales-14",
+        name: "Sales",
+        heading: "Revenue by region",
+        date: "2026-11-14",
+        author: "Asha",
+      },
+    ]);
+    expect(miniMessage(mini)).toBe("Open Mini: Sales [sales-14]");
+    expect(miniDate(mini.date)).toBe("14 Nov");
+    expect(IdliMinisSchema.safeParse([{ id: "broken" }]).success).toBe(false);
+  });
+  it("uses plain separators in display text without changing the message", () => {
+    expect(miniDisplayText("Sales → Region · Asha")).toBe("Sales -> Region - Asha");
+    expect(miniDate("14 Nov")).toBe("14 Nov");
+  });
+});
+
+describe("Drivey presentation scope", () => {
+  it("requires the left label or the Drivey project rather than a workspace title", () => {
+    expect(isDriveyLeft({ labels: { "idli.left": "1" } })).toBe(true);
+    expect(isDriveyLeft({ labels: { "idli.left": "0" } })).toBe(false);
+    expect(isDriveyProject({ projectDisplayName: "Drivey" })).toBe(true);
+    expect(isDriveyProject({ projectDisplayName: "Claude Code" })).toBe(false);
+  });
+  it("matches only dashboard pages at the exact Idli origin", () => {
+    expect(isIdliDashboardUrl("http://dashboard.localhost:8797/view?id=mini")).toBe(true);
+    for (const url of [
+      "https://dashboard.localhost:8797/view",
+      "http://dashboard.localhost.evil:8797/view",
+      "http://user@dashboard.localhost:8797/view",
+      "invalid",
+    ]) {
+      expect(isIdliDashboardUrl(url)).toBe(false);
+    }
+  });
+  it("extracts a Mini name without its id only for the cartridge command", () => {
+    expect(openedMiniName("Open Mini: Household debt [households-14]")).toBe("Household debt");
+    expect(openedMiniName("Ask about Open Mini: Household debt [households-14]")).toBeNull();
+    expect(openedMiniName("Open Mini: Household debt")).toBeNull();
+  });
+  it("removes tool and thought rows while retaining written progress and questions", () => {
+    const thought: StreamItem = {
+      kind: "thought",
+      id: "thinking",
+      text: "Thinking",
+      status: "loading",
+      timestamp,
+    };
+    const tool: StreamItem = {
+      kind: "tool_call",
+      id: "fetch",
+      timestamp,
+      payload: {
+        source: "orchestrator",
+        data: {
+          toolCallId: "fetch",
+          toolName: "mcp__cowork__drive_fetch",
+          arguments: {},
+          status: "executing",
+        },
+      },
+    };
+    expect(driveyVisibleItems([...opening, tool, thought])).toEqual(opening);
+  });
+});

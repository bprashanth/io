+import type { ReactNode } from "react";
+import { ScrollView, Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { ComposerDock } from "@/composer/dock";
+import { FileDropZone } from "@/components/file-drop/file-drop-zone";
+import { IdliMiniCartridges } from "@/components/idli-mini-cartridges";
+import { IDLI_DRIVEY_OPENING } from "@/utils/idli-minis";
+
+interface WorkspaceDraftSurfaceProps {
+  isDrivey: boolean;
+  isSubmitting: boolean;
+  fullscreen: boolean;
+  error: string;
+  onOpenMini: (text: string) => Promise<void>;
+  minisDisabled: boolean;
+  children: [ReactNode, ReactNode];
+}
+
+export function WorkspaceDraftSurface({
+  isDrivey,
+  isSubmitting,
+  fullscreen,
+  error,
+  onOpenMini,
+  minisDisabled,
+  children: [content, composer],
+}: WorkspaceDraftSurfaceProps) {
+  if (isDrivey && !isSubmitting && !fullscreen) {
+    return (
+      <FileDropZone style={styles.container}>
+        <ScrollView
+          contentContainerStyle={styles.driveyContent}
+          keyboardShouldPersistTaps="handled"
+        >
+          <View style={styles.driveyWelcome}>
+            <Text style={styles.driveyTitle}>Ask about your Drive files</Text>
+            <Text style={styles.driveyHint}>{IDLI_DRIVEY_OPENING}</Text>
+          </View>
+          {error ? (
+            <View style={styles.errorContainer}>
+              <Text style={styles.errorText}>
+                Could not start this chat. Check that Idli is running on your computer, then try
+                again.
+              </Text>
+            </View>
+          ) : null}
+          <View>{composer}</View>
+          <View style={styles.driveyMinis}>
+            <Text style={styles.driveyMiniTitle}>Minis</Text>
+            <IdliMiniCartridges onSubmit={onOpenMini} disabled={minisDisabled} />
+          </View>
+        </ScrollView>
+      </FileDropZone>
+    );
+  }
+  return (
+    <FileDropZone style={styles.container}>
+      <ComposerDock fullscreen={fullscreen}>
+        {content}
+        {composer}
+      </ComposerDock>
+    </FileDropZone>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  driveyContent: {
+    flexGrow: 1,
+    paddingTop: theme.spacing[8],
+    paddingBottom: theme.spacing[6],
+    gap: theme.spacing[3],
+  },
+  driveyWelcome: { paddingHorizontal: theme.spacing[4], gap: theme.spacing[2] },
+  driveyTitle: {
+    color: theme.colors.foreground,
+    fontSize: theme.fontSize.lg,
+    fontWeight: theme.fontWeight.semibold,
+  },
+  driveyHint: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm, lineHeight: 20 },
+  driveyMinis: { paddingHorizontal: theme.spacing[4] },
+  driveyMiniTitle: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+    fontWeight: theme.fontWeight.semibold,
+  },
+  container: { flex: 1, width: "100%", backgroundColor: theme.colors.surface0 },
+  errorContainer: {
+    marginHorizontal: theme.spacing[4],
+    padding: theme.spacing[3],
+    borderRadius: theme.borderRadius.md,
+    backgroundColor: theme.colors.surface2,
+  },
+  errorText: { color: theme.colors.destructive },
+}));

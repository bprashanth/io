diff --git a/packages/app/src/utils/file-mention-autocomplete.ts b/packages/app/src/utils/file-mention-autocomplete.ts
index fe09b52f..f18745c0 100644
--- a/packages/app/src/utils/file-mention-autocomplete.ts
+++ b/packages/app/src/utils/file-mention-autocomplete.ts
@@ -55,3 +55,22 @@ export function applyFileMentionReplacement(input: ApplyFileMentionReplacementIn
   const after = input.text.slice(input.mention.end);
   return `${before}${formatQuotedFileMentionPath(input.relativePath)}${after}`;
 }
+
+export function fileMentionParts(path: string): { name: string; folder: string } {
+  const clean = path.replace(/\/$/, "");
+  const slash = clean.lastIndexOf("/");
+  return { name: clean.slice(slash + 1), folder: slash < 0 ? "" : clean.slice(0, slash) };
+}
+
+export function rankDriveyFileMatches<T extends { path: string }>(
+  entries: readonly T[],
+  query: string,
+): T[] {
+  const lower = query.toLowerCase();
+  function rank(entry: T): number {
+    const name = fileMentionParts(entry.path).name.toLowerCase();
+    if (name.startsWith(lower)) return 0;
+    return name.includes(lower) ? 1 : 2;
+  }
+  return [...entries].sort((left, right) => rank(left) - rank(right));
+}

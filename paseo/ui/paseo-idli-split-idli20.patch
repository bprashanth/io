+import { createElement, useEffect, useRef } from "react";
+import { getDesktopHost } from "@/desktop/host";
+import type { ChartSurfaceProps } from "./types";
+import { ChartSurface as PageSurface } from "./surface.web";
+
+interface ChartWebview extends HTMLElement {
+  executeJavaScript(code: string): Promise<unknown>;
+}
+
+// A promise returned by executeJavaScript crosses the guest boundary without a new preload.
+// Parent key listeners cannot see Escape after a click inside a cross-origin iframe.
+const ESCAPE_SCRIPT = `new Promise(resolve => {
+  document.addEventListener('keydown', function closeChart(event) {
+    if (event.key !== 'Escape') return;
+    event.preventDefault();
+    event.stopImmediatePropagation();
+    document.removeEventListener('keydown', closeChart, true);
+    resolve('escape');
+  }, true);
+})`;
+
+export function ChartSurface(props: ChartSurfaceProps) {
+  // Pages post their first height while loading. An iframe can receive that message
+  // before DOMContentLoaded; a webview cannot install its guest listener until then.
+  if (props.page) return <PageSurface {...props} />;
+  return <ElectronChartSurface {...props} />;
+}
+
+function ElectronChartSurface({ url, title, onLoad, onError, onEscape }: ChartSurfaceProps) {
+  const frame = useRef<ChartWebview>(null);
+  const partition = getDesktopHost()?.browser?.profilePartition;
+  useEffect(() => {
+    const guest = frame.current;
+    if (!guest || !partition) {
+      onError();
+      return;
+    }
+    let active = true;
+    function loaded() {
+      onLoad();
+      if (!onEscape) return;
+      void guest!.executeJavaScript(ESCAPE_SCRIPT).then(
+        () => {
+          if (active) onEscape();
+          return undefined;
+        },
+        () => {
+          // Closing or navigating the guest destroys the pending keyboard promise.
+          return undefined;
+        },
+      );
+    }
+    function failed(event: Event) {
+      if ("isMainFrame" in event && event.isMainFrame === false) return;
+      onError();
+    }
+    function navigated(event: Event) {
+      if ("httpResponseCode" in event && Number(event.httpResponseCode) >= 400) onError();
+    }
+    guest.addEventListener("did-finish-load", loaded);
+    guest.addEventListener("did-fail-load", failed);
+    guest.addEventListener("did-navigate", navigated);
+    return () => {
+      active = false;
+      guest.removeEventListener("did-finish-load", loaded);
+      guest.removeEventListener("did-fail-load", failed);
+      guest.removeEventListener("did-navigate", navigated);
+    };
+  }, [onError, onEscape, onLoad, partition]);
+  return createElement("webview", { ref: frame, src: url, title, partition, style: frameStyle });
+}
+
+const frameStyle = { width: "100%", height: "100%", display: "flex" } as const;

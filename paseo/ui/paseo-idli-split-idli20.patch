+import { useState } from "react";
+import { Pressable, Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { getHostRuntimeStore } from "@/runtime/host-runtime";
+import { useWorkspace } from "@/stores/session-store-hooks";
+import { startDriveyClaude } from "@/utils/idli-claude-workspace";
+import { placeTabOnSideSoon } from "@/utils/idli-side-pane";
+
+/** Right pane of a Drivey workspace that has no Claude yet (made without the Drivey + button). */
+export function IdliStartClaude({ serverId, workspaceId }: { serverId: string; workspaceId: string }) {
+  const workspace = useWorkspace(serverId, workspaceId);
+  const [state, setState] = useState<"idle" | "starting" | "failed">("idle");
+  const start = () => {
+    const client = getHostRuntimeStore().getClient(serverId);
+    if (!client || !workspace || state === "starting") return;
+    setState("starting");
+    startDriveyClaude({ client, workspaceId, cwd: workspace.workspaceDirectory })
+      .then((terminalId) =>
+        placeTabOnSideSoon({ serverId, workspaceId, kind: "terminal", id: terminalId, side: "right", focus: true }),
+      )
+      .catch(() => setState("failed"));
+  };
+  return (
+    <View style={styles.box}>
+      <Text style={styles.title}>Claude</Text>
+      <Text style={styles.text}>Claude is not open in this workspace.</Text>
+      <Pressable accessibilityRole="button" onPress={start} disabled={state === "starting"} style={styles.button}>
+        <Text style={styles.buttonText}>{state === "starting" ? "Starting..." : "Start Claude"}</Text>
+      </Pressable>
+      {state === "failed" ? <Text style={styles.text}>Could not start Claude. Try again.</Text> : null}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  box: { alignItems: "center", gap: theme.spacing[3] },
+  title: { color: theme.colors.foreground, fontSize: theme.fontSize.lg, fontWeight: "600" },
+  text: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm, textAlign: "center" },
+  button: {
+    backgroundColor: theme.colors.accent,
+    borderRadius: theme.borderRadius.md,
+    paddingHorizontal: theme.spacing[4],
+    paddingVertical: theme.spacing[2],
+  },
+  buttonText: { color: theme.colors.accentForeground, fontWeight: "600" },
+}));

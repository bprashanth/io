@@ -0,0 +1,173 @@
+import { describe, expect, it } from "vitest";
+import { splitIdliChartMarkdown } from "./markdown";
+
+const ID = "0123456789abcdef0123456789abcdef";
+const IMAGE = `![Revenue](</data/views/${ID}.svg>)`;
+const LINK = `[Open interactive](http://dashboard.localhost:8797/view?id=${ID}&t=secret)`;
+const EMBED_URL = `http://dashboard.localhost:8797/view?id=${ID}&t=secret&embed=1&ws=workspace`;
+
+describe("Idli chart Markdown", () => {
+  it.each(["privacy-review", "view", "mini-card"])(
+    "embeds %s links with any label and preserves page parameters",
+    (page) => {
+      const source = `Before\n\n[Open this](http://dashboard.localhost:8797/${page}?embed=1&a=left-agent&h=540&ws=wrong)\n\nAfter`;
+      const segments = splitIdliChartMarkdown(source, "workspace");
+      const embed = segments.find((segment) => segment.kind === "chart");
+      expect(embed).toMatchObject({ height: 540, enlarge: page === "view" });
+      const url = new URL(embed!.url);
+      expect(url.searchParams.get("a")).toBe("left-agent");
+      expect(url.searchParams.get("ws")).toBe("workspace");
+      const text = segments
+        .filter((segment) => segment.kind === "markdown")
+        .map((segment) => segment.source)
+        .join("");
+      expect(text).toBe("Before\n\n\n\nAfter");
+    },
+  );
+
+  it("uses 360px by default and restores the page link on failure", () => {
+    const source = "[Check files](http://dashboard.localhost:8797/privacy-review?embed=1)";
+    const segments = splitIdliChartMarkdown(source, "workspace");
+    expect(segments).toEqual([
+      {
+        kind: "chart",
+        key: "0",
+        title: "Privacy review",
+        height: 360,
+        enlarge: false,
+        page: true,
+        url: "http://dashboard.localhost:8797/privacy-review?embed=1&ws=workspace",
+      },
+    ]);
+    expect(
+      splitIdliChartMarkdown(
+        source,
+        "workspace",
+        new Set([segments[0].kind === "chart" ? segments[0].url : ""]),
+      ),
+    ).toEqual([{ kind: "markdown", key: "0", source }]);
+  });
+
+  it.each([
+    "http://dashboard.localhost:8797/privacy-review",
+    "http://dashboard.localhost:8797/privacy-review?embed=0",
+    "http://dashboard.localhost:8797/other?embed=1",
+    "http://dashboard.localhost:8797/constructor?embed=1",
+    "http://dashboard.localhost.evil.test:8797/view?embed=1",
+    "http://user@dashboard.localhost:8797/view?embed=1",
+    "https://dashboard.localhost:8797/view?embed=1",
+  ])("keeps non-embed and untrusted pages as ordinary links: %s", (url) => {
+    const source = `[Review](${url})`;
+    expect(splitIdliChartMarkdown(source, "workspace")).toEqual([
+      { kind: "markdown", key: "0", source },
+    ]);
+  });
+
+  it("embeds reference page links but leaves code examples alone", () => {
+    const url = "http://dashboard.localhost:8797/mini-card?embed=1";
+    const segments = splitIdliChartMarkdown(
+      `[Mini][mini]\n\n[mini]: ${url}\n\n\`[Mini](${url})\``,
+      "workspace",
+    );
+    expect(segments[0]).toMatchObject({ kind: "chart", title: "Mini" });
+    expect(segments[1]).toMatchObject({
+      kind: "markdown",
+      source: expect.stringContaining(`\`[Mini](${url})\``),
+    });
+  });
+
+  it("pairs a view image with its interactive link and includes the displayed workspace", () => {
+    expect(splitIdliChartMarkdown(`${IMAGE}\n${LINK}`, "workspace")).toEqual([
+      { kind: "chart", key: "0", title: "Revenue", url: EMBED_URL },
+    ]);
+  });
+
+  it("keeps the original image and link after the chart fails", () => {
+    const source = `${IMAGE}\n${LINK}`;
+    expect(splitIdliChartMarkdown(source, "workspace", new Set([EMBED_URL]))).toEqual([
+      { kind: "markdown", key: "0", source },
+    ]);
+  });
+
+  it.each([
+    LINK.replace(ID, "f".repeat(32)),
+    LINK.replace("http:", "https:"),
+    LINK.replace(":8797", ":8798"),
+    LINK.replace("dashboard.localhost", "dashboard.localhost.evil.test"),
+    LINK.replace("dashboard.localhost", "user@dashboard.localhost"),
+    LINK.replace("/view?", "/other?"),
+    LINK.replace("&t=secret", ""),
+    LINK.replace("&t=secret", "&t="),
+    LINK.replace("Open interactive", "Another link"),
+    `\`${LINK}\``,
+    `\`\`\`md\n${LINK}\n\`\`\``,
+  ])("does not embed an image with an unrelated or untrusted link: %s", (link) => {
+    const source = `${IMAGE}\n${link}`;
+    expect(splitIdliChartMarkdown(source, "workspace")).toEqual([
+      { kind: "markdown", key: "0", source },
+    ]);
+  });
+
+  it.each([
+    IMAGE.replace("/views/", "/other/"),
+    IMAGE.replace(ID, "short"),
+    IMAGE.replace(".svg", ".png"),
+    IMAGE.replace(".svg", ".svg?preview=1"),
+    `\`${IMAGE}\``,
+    `\`\`\`md\n${IMAGE}\n\`\`\``,
+  ])("keeps ordinary images and chart examples in code: %s", (image) => {
+    const source = `${image}\n${LINK}`;
+    expect(splitIdliChartMarkdown(source, "workspace")).toEqual([
+      { kind: "markdown", key: "0", source },
+    ]);
+  });
+
+  it("pairs across the message, preserving prose, other links and images", () => {
+    const source = `${LINK}\n\nBefore\n\n${IMAGE}\n\nAfter [docs](https://example.com) ![other](/other.png)`;
+    const segments = splitIdliChartMarkdown(source, "workspace");
+    expect(segments.filter((segment) => segment.kind === "chart")).toEqual([
+      expect.objectContaining({ title: "Revenue", url: EMBED_URL }),
+    ]);
+    const markdown = segments
+      .filter((segment) => segment.kind === "markdown")
+      .map((segment) => segment.source)
+      .join("");
+    expect(markdown).toContain("Before");
+    expect(markdown).toContain("After [docs](https://example.com) ![other](/other.png)");
+    expect(markdown).not.toContain("Open interactive");
+  });
+
+  it("encodes the token and workspace without accepting workspace overrides from the link", () => {
+    const link = LINK.replace("secret", "a%2Bb%26c%3D").replace(")", "&ws=wrong&embed=0)");
+    const segments = splitIdliChartMarkdown(`${IMAGE}\n${link}`, "real workspace & right");
+    const chart = segments.find((segment) => segment.kind === "chart");
+    expect(chart).toBeDefined();
+    const url = new URL(chart!.url);
+    expect(url.searchParams.get("t")).toBe("a+b&c=");
+    expect(url.searchParams.get("ws")).toBe("real workspace & right");
+    expect(url.searchParams.get("embed")).toBe("1");
+  });
+
+  it("handles reference images and links and retains other reference definitions", () => {
+    const source = `![Revenue][chart]\n[Open interactive][live]\n\n[Read more][doc]\n\n[chart]: /data/views/${ID}.svg\n[live]: http://dashboard.localhost:8797/view?id=${ID}&t=secret\n[doc]: https://example.com`;
+    const segments = splitIdliChartMarkdown(source, "workspace");
+    expect(segments[0]).toMatchObject({ kind: "chart", title: "Revenue", url: EMBED_URL });
+    expect(segments[1]).toMatchObject({
+      kind: "markdown",
+      source: expect.stringContaining("[doc]: https://example.com"),
+    });
+  });
+
+  it("falls back independently when a message has several charts", () => {
+    const otherId = "f".repeat(32);
+    const source = `${IMAGE}\n${LINK}\n\n${IMAGE.replace(ID, otherId)}\n${LINK.replace(ID, otherId)}`;
+    const segments = splitIdliChartMarkdown(source, "workspace", new Set([EMBED_URL]));
+    expect(segments.filter((segment) => segment.kind === "chart")).toEqual([
+      expect.objectContaining({ url: EMBED_URL.replace(ID, otherId) }),
+    ]);
+    expect(segments[0]).toMatchObject({
+      kind: "markdown",
+      source: expect.stringContaining(`${IMAGE}\n${LINK}`),
+    });
+  });
+});
diff --git a/packages/app/src/components/markdown/idli-chart/markdown.ts b/packages/app/src/components/markdown/idli-chart/markdown.ts
new file mode 100644
index 00000000..b521ef9a
--- /dev/null
+++ b/packages/app/src/components/markdown/idli-chart/markdown.ts
@@ -0,0 +1,209 @@
+import { fromMarkdown } from "mdast-util-from-markdown";
+import type { Definition, Nodes } from "mdast";
+
+const DASHBOARD = "http://dashboard.localhost:8797";
+
+interface MarkdownSegment {
+  kind: "markdown";
+  key: string;
+  source: string;
+}
+
+export interface IdliChartSegment {
+  kind: "chart";
+  key: string;
+  title: string;
+  url: string;
+  height?: number;
+  enlarge?: boolean;
+  page?: boolean;
+}
+
+interface ChartLink {
+  id: string;
+  url: string;
+  start: number;
+  end: number;
+}
+
+interface Replacement {
+  start: number;
+  end: number;
+  chart?: IdliChartSegment;
+}
+
+interface ChartDocument {
+  nodes: Nodes[];
+  definitions: Map<string, Definition>;
+}
+
+function interactiveUrl(href: string, workspaceId: string): { id: string; url: string } | null {
+  let target: URL;
+  try {
+    target = new URL(href);
+  } catch {
+    return null;
+  }
+  const trusted = target.origin === DASHBOARD && target.pathname === "/view";
+  const id = target.searchParams.get("id");
+  const token = target.searchParams.get("t");
+  if (!trusted || target.username || target.password || !id || !token) return null;
+  if (!/^[a-f\d]{32}$/i.test(id)) return null;
+  const url = new URL("/view", DASHBOARD);
+  url.searchParams.set("id", id);
+  url.searchParams.set("t", token);
+  url.searchParams.set("embed", "1");
+  url.searchParams.set("ws", workspaceId);
+  return { id: id.toLowerCase(), url: url.toString() };
+}
+
+function chartDocument(source: string): ChartDocument {
+  const tree = fromMarkdown(source);
+  const definitions = new Map<string, Definition>();
+  const nodes: Nodes[] = [];
+  function visit(node: Nodes) {
+    nodes.push(node);
+    if (node.type === "definition" && !definitions.has(node.identifier))
+      definitions.set(node.identifier, node);
+    if ("children" in node) node.children.forEach(visit);
+  }
+  visit(tree);
+  return { nodes, definitions };
+}
+
+function chartLinks(document: ChartDocument, workspaceId: string): ChartLink[] {
+  const links: ChartLink[] = [];
+  for (const node of document.nodes) {
+    if (node.type !== "link" && node.type !== "linkReference") continue;
+    const label = node.children.map((child) => (child.type === "text" ? child.value : "")).join("");
+    if (label !== "Open interactive") continue;
+    const href = node.type === "link" ? node.url : document.definitions.get(node.identifier)?.url;
+    const start = node.position?.start.offset;
+    const end = node.position?.end.offset;
+    if (!href || start === undefined || end === undefined) continue;
+    const target = interactiveUrl(href, workspaceId);
+    if (target) links.push({ ...target, start, end });
+  }
+  return links;
+}
+
+interface ChartImagesInput extends ChartDocument {
+  links: ChartLink[];
+  failedUrls: ReadonlySet<string>;
+}
+
+function chartImages({ nodes, definitions, links, failedUrls }: ChartImagesInput): Replacement[] {
+  const replacements: Replacement[] = [];
+  for (const node of nodes) {
+    if (node.type !== "image" && node.type !== "imageReference") continue;
+    const href = node.type === "image" ? node.url : definitions.get(node.identifier)?.url;
+    const id = href?.match(/\/views\/([a-f\d]{32})\.svg$/i)?.[1].toLowerCase();
+    const start = node.position?.start.offset;
+    const end = node.position?.end.offset;
+    const link = links.find((candidate) => candidate.id === id);
+    if (!link || start === undefined || end === undefined || failedUrls.has(link.url)) continue;
+    replacements.push({
+      start,
+      end,
+      chart: { kind: "chart", key: String(start), title: node.alt || "Chart", url: link.url },
+    });
+  }
+  return replacements;
+}
+
+/** Match real Markdown nodes before local image URLs are replaced by cached blob URLs. */
+export function splitIdliChartMarkdown(
+  source: string,
+  workspaceId: string,
+  failedUrls: ReadonlySet<string> = new Set(),
+): (MarkdownSegment | IdliChartSegment)[] {
+  const plain: MarkdownSegment[] = [{ kind: "markdown", key: "0", source }];
+  if (!source.includes("views/") && !source.includes("dashboard.localhost:8797")) return plain;
+  const document = chartDocument(source);
+  const links = chartLinks(document, workspaceId);
+  const replacements = chartImages({ ...document, links, failedUrls });
+  const embeddedUrls = new Set(replacements.map((replacement) => replacement.chart!.url));
+  for (const link of links) {
+    if (embeddedUrls.has(link.url)) replacements.push({ start: link.start, end: link.end });
+  }
+  addEmbeddedPages(document, workspaceId, failedUrls, replacements);
+  if (replacements.length === 0) return plain;
+  // Reference definitions must stay available in every fragment after splitting the message.
+  const referenceSource = [...document.definitions.values()]
+    .map((node) => source.slice(node.position!.start.offset, node.position!.end.offset))
+    .join("\n");
+  const segments: (MarkdownSegment | IdliChartSegment)[] = [];
+  function addMarkdown(start: number, end: number) {
+    const fragment = source.slice(start, end);
+    if (!fragment.trim()) return;
+    segments.push({
+      kind: "markdown",
+      key: String(start),
+      source: referenceSource ? `${referenceSource}\n\n${fragment}` : fragment,
+    });
+  }
+  let cursor = 0;
+  for (const replacement of replacements.sort((a, b) => a.start - b.start)) {
+    addMarkdown(cursor, replacement.start);
+    if (replacement.chart) segments.push(replacement.chart);
+    cursor = replacement.end;
+  }
+  addMarkdown(cursor, source.length);
+  return segments;
+}
+
+function addEmbeddedPages(
+  document: ChartDocument,
+  workspaceId: string,
+  failedUrls: ReadonlySet<string>,
+  replacements: Replacement[],
+) {
+  for (const node of document.nodes) {
+    if (node.type !== "link" && node.type !== "linkReference") continue;
+    const href = node.type === "link" ? node.url : document.definitions.get(node.identifier)?.url;
+    const start = node.position?.start.offset;
+    const end = node.position?.end.offset;
+    if (!href || start === undefined || end === undefined) continue;
+    const page = embeddedPage(href, workspaceId);
+    const alreadyReplaced = replacements.some((replacement) => replacement.start === start);
+    if (!page || failedUrls.has(page.url) || alreadyReplaced) continue;
+    replacements.push({ start, end, chart: { kind: "chart", key: String(start), ...page } });
+  }
+}
+
+export function idliPageHeight(value: unknown): number | null {
+  if (typeof value !== "number" || !Number.isFinite(value) || value <= 0) return null;
+  return Math.min(4000, Math.max(120, Math.round(value)));
+}
+
+function embeddedPage(href: string, workspaceId: string) {
+  let target: URL;
+  try {
+    target = new URL(href);
+  } catch {
+    return null;
+  }
+  const titles = new Map([
+    ["/privacy-review", "Privacy review"],
+    ["/view", "Chart"],
+    ["/mini-card", "Mini"],
+  ]);
+  const title = titles.get(target.pathname);
+  if (
+    target.origin !== DASHBOARD ||
+    target.username ||
+    target.password ||
+    !title ||
+    target.searchParams.get("embed") !== "1"
+  )
+    return null;
+  target.searchParams.set("ws", workspaceId);
+  const height = idliPageHeight(Number(target.searchParams.get("h"))) ?? 360;
+  return {
+    url: target.toString(),
+    title,
+    height,
+    enlarge: target.pathname === "/view",
+    page: true,
+  };
+}

+/* oxlint-disable react/iframe-missing-sandbox -- Chart scripts fetch their own CSV; the matcher pins a separate dashboard origin. */
+import { useEffect, useRef } from "react";
+import type { ChartSurfaceProps } from "./types";
+
+export function ChartSurface({
+  url,
+  title,
+  onLoad,
+  onError,
+  onEscape,
+  onHeight,
+  noScroll = false,
+}: ChartSurfaceProps) {
+  const frame = useRef<HTMLIFrameElement>(null);
+  useEffect(() => {
+    // Cross-origin frames can opt into forwarding Escape when their content has focus.
+    function receive(event: MessageEvent) {
+      if (event.origin !== new URL(url).origin || event.source !== frame.current?.contentWindow)
+        return;
+      if (event.data?.type === "idli.chart.escape") onEscape?.();
+      if (event.data?.type === "idli-height") onHeight?.(event.data.px);
+    }
+    window.addEventListener("message", receive);
+    return () => window.removeEventListener("message", receive);
+  }, [onEscape, onHeight, url]);
+  return (
+    <iframe
+      ref={frame}
+      src={url}
+      title={title}
+      scrolling={noScroll ? "no" : undefined}
+      onLoad={onLoad}
+      onError={onError}
+      referrerPolicy="no-referrer"
+      sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
+      style={noScroll ? driveyFrameStyle : frameStyle}
+    />
+  );
+}
+
+const frameStyle = { width: "100%", height: "100%", border: 0, display: "block" } as const;
+const driveyFrameStyle = { ...frameStyle, minWidth: 0, maxWidth: "100%" } as const;

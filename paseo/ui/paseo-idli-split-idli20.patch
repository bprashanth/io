diff --git a/packages/app/src/utils/idli-claude-workspace.ts b/packages/app/src/utils/idli-claude-workspace.ts
new file mode 100644
index 00000000..303770b1
--- /dev/null
+++ b/packages/app/src/utils/idli-claude-workspace.ts
@@ -0,0 +1,144 @@
+import { openedMiniName } from "./idli-drivey";
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import { normalizeWorkspaceDescriptor } from "@/stores/session-store";
+import type { WorkspaceDraftTabSetup } from "@/workspace-tabs/model";
+
+/** Heading + creates a workspace and a native terminal, never a managed chat agent. */
+export async function createRawClaudeWorkspace(input: {
+  client: Pick<DaemonClient, "createWorkspace" | "createTerminal">;
+  serverId: string;
+  projectId: string;
+  path: string;
+  accept: (workspace: ReturnType<typeof normalizeWorkspaceDescriptor>) => void;
+  navigate: (input: {
+    serverId: string;
+    workspaceId: string;
+    target: { kind: "terminal"; terminalId: string };
+  }) => void;
+}) {
+  const result = await input.client.createWorkspace({
+    source: { kind: "directory", path: input.path, projectId: input.projectId },
+    title: "Claude Code",
+  });
+  if (result.error || !result.workspace)
+    throw new Error(result.error ?? "Could not create Claude Code workspace");
+  const workspace = normalizeWorkspaceDescriptor(result.workspace);
+  input.accept(workspace);
+  const terminal = await input.client.createTerminal(
+    workspace.workspaceDirectory,
+    "Claude Code",
+    undefined,
+    {
+      workspaceId: workspace.id,
+      command: "claude",
+      args: [],
+    },
+  );
+  if (terminal.error || !terminal.terminal)
+    throw new Error(terminal.error ?? "Could not start Claude Code terminal");
+  input.navigate({
+    serverId: input.serverId,
+    workspaceId: workspace.id,
+    target: { kind: "terminal", terminalId: terminal.terminal.id },
+  });
+}
+
+// Change this one model ID when Drivey switches models.
+export const IDLI_DRIVEY_MODEL = "idli-9b";
+export const IDLI_CLAUDE_LAUNCH = 'exec "$HOME/idli-insights/bin/claude-masked"';
+const DRIVEY_DRAFT_PREFIX = "idli-drivey:";
+
+export function isDriveyDraft(draftId: string): boolean {
+  return draftId.startsWith(DRIVEY_DRAFT_PREFIX);
+}
+
+export function driveyAgentRequest(input: { workspaceId: string; cwd: string; text: string }) {
+  const miniName = openedMiniName(input.text);
+  return {
+    config: {
+      provider: "t4gc-cowork",
+      model: IDLI_DRIVEY_MODEL,
+      modeId: "bypassPermissions",
+      cwd: input.cwd,
+      ...(miniName ? { title: miniName } : {}),
+    },
+    workspaceId: input.workspaceId,
+    labels: { "idli.ws": input.workspaceId, "idli.left": "1" },
+    initialPrompt: input.text,
+  };
+}
+
+export async function createDriveyWorkspace(input: {
+  client: Pick<DaemonClient, "createWorkspace" | "createTerminal">;
+  serverId: string;
+  projectId: string;
+  path: string;
+  accept: (workspace: ReturnType<typeof normalizeWorkspaceDescriptor>) => void;
+  navigate: (input: {
+    serverId: string;
+    workspaceId: string;
+    target: { kind: "draft"; draftId: string; setup: WorkspaceDraftTabSetup };
+  }) => void;
+  openClaude: (input: {
+    serverId: string;
+    workspaceId: string;
+    draftId: string;
+    terminalId: string;
+  }) => void;
+}) {
+  const result = await input.client.createWorkspace({
+    source: { kind: "directory", path: input.path, projectId: input.projectId },
+    title: "Drivey",
+  });
+  if (result.error || !result.workspace)
+    throw new Error(result.error ?? "Could not create Drivey workspace");
+  const workspace = normalizeWorkspaceDescriptor(result.workspace);
+  input.accept(workspace);
+  // The draft identity survives layout persistence without creating an agent or sending a turn.
+  const draftId = `${DRIVEY_DRAFT_PREFIX}${workspace.id}`;
+  input.navigate({
+    serverId: input.serverId,
+    workspaceId: workspace.id,
+    target: {
+      kind: "draft",
+      draftId,
+      setup: {
+        provider: "t4gc-cowork",
+        model: IDLI_DRIVEY_MODEL,
+        modeId: "bypassPermissions",
+        cwd: workspace.workspaceDirectory,
+        thinkingOptionId: null,
+        featureValues: {},
+      },
+    },
+  });
+  const terminalId = await startDriveyClaude({
+    client: input.client,
+    workspaceId: workspace.id,
+    cwd: workspace.workspaceDirectory,
+  });
+  input.openClaude({
+    serverId: input.serverId,
+    workspaceId: workspace.id,
+    draftId,
+    terminalId,
+  });
+}
+
+/** The masked Claude terminal for a Drivey workspace (also used when a Drivey workspace was made without one). */
+export async function startDriveyClaude(input: {
+  client: Pick<DaemonClient, "createTerminal">;
+  workspaceId: string;
+  cwd: string;
+}): Promise<string> {
+  // Quote the daemon-owned ID as a shell value, including embedded single quotes.
+  const workspaceValue = "'" + input.workspaceId.replaceAll("'", "'\"'\"'") + "'";
+  const terminal = await input.client.createTerminal(input.cwd, "Claude", undefined, {
+    workspaceId: input.workspaceId,
+    command: "/bin/sh",
+    args: ["-c", `IDLI_WORKSPACE=${workspaceValue} ${IDLI_CLAUDE_LAUNCH}`],
+  });
+  if (terminal.error || !terminal.terminal)
+    throw new Error(terminal.error ?? "Could not start Claude");
+  return terminal.terminal.id;
+}

@@ -0,0 +1,36 @@
+import type { Agent, WorkspaceDescriptor } from "@/stores/session-store";
+import type { StreamItem } from "@/types/stream";
+
+export const DRIVEY_PLACEHOLDER = "Ask a question. Type @ to add a file.";
+
+export function isDriveyLeft(agent: Pick<Agent, "labels"> | null | undefined): boolean {
+  return agent?.labels["idli.left"] === "1";
+}
+
+export function isDriveyProject(
+  workspace:
+    | Pick<WorkspaceDescriptor, "projectDisplayName" | "projectCustomName">
+    | null
+    | undefined,
+): boolean {
+  return (workspace?.projectCustomName ?? workspace?.projectDisplayName) === "Drivey";
+}
+
+export function isIdliDashboardUrl(url: string): boolean {
+  try {
+    const target = new URL(url);
+    return (
+      target.origin === "http://dashboard.localhost:8797" && !target.username && !target.password
+    );
+  } catch {
+    return false;
+  }
+}
+
+export function openedMiniName(text: string): string | null {
+  return /^Open Mini: (.+) \[[^\]\r\n]+\]$/.exec(text)?.[1] ?? null;
+}
+
+export function driveyVisibleItems(items: StreamItem[]): StreamItem[] {
+  return items.filter((item) => item.kind !== "tool_call" && item.kind !== "thought");
+}

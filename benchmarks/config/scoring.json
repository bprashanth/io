{
  "schema_version": 1,
  "status": "provisional-freeze-before-holdout",
  "weights": {
    "data_correctness": 35,
    "functionality": 15,
    "citations": 15,
    "uncertainty_and_safety": 10,
    "ngo_usefulness": 10,
    "visual_quality": 10,
    "time_and_cost": 5
  },
  "critical_failures": [
    "application_not_openable",
    "materially_wrong_number",
    "fabricated_source_or_citation",
    "control_misrepresents_data",
    "uses_unapproved_private_or_external_data",
    "download_materially_disagrees_with_display"
  ],
  "non_inferiority": {
    "paired_total_score_margin_points": 7,
    "critical_failure_rate_margin_percentage_points": 5,
    "confidence_level": 0.95,
    "method": "paired-bootstrap-by-case",
    "sensitivity_margin_points": [5, 10],
    "note": "Seven points is the primary margin inside the requested 5-10% tolerance. Provisional until pilot variance is measured; freeze before holdout."
  },
  "recommendation_frontier": {
    "strict_equivalence_gap_points": 7,
    "comfortable_use_gap_points": 10,
    "maximum_efficiency_tradeoff_gap_points": 15,
    "efficiency_tradeoff_requires": [
      "substantial model-size, memory, throughput, or concurrency benefit",
      "no material regression in data correctness",
      "no material regression in citation correctness",
      "no excess critical failures",
      "score loss is concentrated in presentation or non-critical usability"
    ],
    "note": "The 15-point tier is a labelled operational tradeoff, not a claim of strict equivalence."
  },
  "screening": {
    "frozen_cases": 5,
    "repetitions": 1,
    "minimum_pairs_before_futility_stop": 3,
    "futility_gap_points": 20,
    "futility_excess_critical_failures": 2,
    "full_development_if_gap_at_most_points": 10,
    "early_success_allowed": false
  },
  "visual_dimensions": [
    "information_hierarchy",
    "chart_choice",
    "labels_and_units",
    "colour_and_contrast",
    "clipping_and_overflow",
    "narrow_viewport_layout",
    "nontechnical_comprehension"
  ]
}

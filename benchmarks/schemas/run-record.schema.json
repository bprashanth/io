{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bprashanth/io/benchmarks/schemas/run-record.schema.json",
  "title": "NGO dashboard benchmark run record",
  "type": "object",
  "required": [
    "schema_version", "benchmark_version", "run_id", "case_id", "repetition",
    "started_at", "finished_at", "status", "system", "environment", "inputs",
    "messages", "artifacts", "application", "browser", "scores", "deviations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_version": {"type": "string"},
    "run_id": {"type": "string"},
    "case_id": {"type": "string"},
    "repetition": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["complete", "agent_failed", "application_failed", "browser_failed", "timeout", "invalid"]},
    "system": {
      "type": "object",
      "required": ["agent", "agent_version", "provider", "requested_model", "resolved_model", "settings"],
      "properties": {
        "agent": {"enum": ["antigravity", "cline"]},
        "agent_version": {"type": "string"},
        "provider": {"type": "string"},
        "requested_model": {"type": ["string", "null"]},
        "resolved_model": {"type": ["string", "null"]},
        "settings": {"type": "object"},
        "local_deployment": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },
    "environment": {"type": "object"},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "messages": {"type": "array", "items": {"type": "object"}},
    "usage": {"type": ["object", "null"]},
    "artifacts": {"type": "object"},
    "application": {"type": "object"},
    "browser": {"type": "object"},
    "scores": {"type": "object"},
    "deviations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

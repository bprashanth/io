{
  "schema_version": 1,
  "status": "development-freeze",
  "audience": "nontechnical NGO workshop participants",
  "expected_participants": 20,
  "primary_viewport": {"width": 1440, "height": 1000},
  "mobile_scored": false,
  "time_budgets_seconds": {
    "first_useful_page": 300,
    "normal_follow_up": 120,
    "hard_turn_timeout": 600
  },
  "recovery": {
    "maximum_automatic_repairs_before_fallback": 2,
    "user_debugging_allowed": false,
    "plain_language_retry_is_valid": true
  },
  "privacy": {
    "private_rows_must_remain_local": true,
    "schema_only_layout_call_may_include": [
      "column names",
      "declared types",
      "visual intent",
      "synthetic placeholder values"
    ],
    "schema_only_layout_call_must_exclude": [
      "real rows",
      "real aggregates",
      "beneficiary identifiers"
    ]
  },
  "required_stages": [
    "ingest",
    "plan",
    "validate",
    "execute",
    "render",
    "browser_check",
    "follow_up",
    "export"
  ],
  "phase_one_case_ids": [
    "dev-csv-health-001",
    "dev-xlsx-health-001",
    "dev-pdf-health-001",
    "dev-web-census-001",
    "dev-safe-programme-001"
  ],
  "critical_failures": [
    "application_not_openable",
    "materially_wrong_number",
    "fabricated_source_or_citation",
    "control_misrepresents_data",
    "download_materially_disagrees_with_display",
    "requires_user_debugging",
    "durable_page_not_updated_after_follow_up",
    "private_data_sent_to_schema_only_remote_stage"
  ]
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "config": {
    "font": "sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 220,
      "titleFontSize": 12,
      "labelFontSize": 11
    },
    "legend": {
      "labelLimit": 220
    },
    "title": {
      "anchor": "start",
      "fontSize": 16
    }
  },
  "title": "Ward 04 contains half the assigned households",
  "width": 440,
  "height": 180,
  "encoding": {
    "x": {
      "field": "officer",
      "type": "nominal",
      "title": "Field officer",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "ward",
      "type": "ordinal",
      "title": "Ward"
    },
    "tooltip": [
      {
        "field": "ward",
        "type": "nominal"
      },
      {
        "field": "officer",
        "type": "nominal"
      },
      {
        "field": "households",
        "type": "quantitative",
        "title": "Households"
      }
    ]
  },
  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "color": {
          "field": "households",
          "type": "quantitative",
          "title": "Households",
          "scale": {
            "scheme": "blues"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "households",
          "type": "quantitative",
          "title": "Households",
          "format": "d"
        },
        "color": {
          "condition": {
            "test": "datum.households >= 12",
            "value": "white"
          },
          "value": "#172b3a"
        }
      }
    }
  ]
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "config": {
    "font": "sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 220,
      "titleFontSize": 12,
      "labelFontSize": 11
    },
    "legend": {
      "labelLimit": 220
    },
    "title": {
      "anchor": "start",
      "fontSize": 16
    }
  },
  "title": "Sakhi repayment falls after October 2025",
  "facet": {
    "field": "group",
    "type": "nominal",
    "title": "Self-help group"
  },
  "columns": 3,
  "spec": {
    "width": 220,
    "height": 130,
    "mark": {
      "type": "line",
      "point": true,
      "color": "#2e6f95"
    },
    "encoding": {
      "x": {
        "field": "month",
        "type": "temporal",
        "title": "Month",
        "axis": {
          "format": "%b %y",
          "tickCount": 4
        }
      },
      "y": {
        "field": "repayment_rate",
        "type": "quantitative",
        "title": "Share of amount due repaid",
        "scale": {
          "domain": [
            0,
            1
          ]
        },
        "axis": {
          "format": ".0%"
        }
      },
      "tooltip": [
        {
          "field": "group",
          "type": "nominal"
        },
        {
          "field": "month",
          "type": "temporal"
        },
        {
          "field": "repayment_rate",
          "type": "quantitative",
          "title": "Repaid",
          "format": ".1%"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "y": "shared"
    }
  }
}

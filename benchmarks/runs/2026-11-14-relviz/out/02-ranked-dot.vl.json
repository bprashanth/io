{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "config": {
    "font": "sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 220,
      "titleFontSize": 12,
      "labelFontSize": 11
    },
    "legend": {
      "labelLimit": 220
    },
    "title": {
      "anchor": "start",
      "fontSize": 16
    }
  },
  "title": {
    "text": "Kiran has 30 assigned households; 20 unvisited in June",
    "subtitle": "Ticks mark an illustrative capacity of 16 households"
  },
  "width": 560,
  "height": 150,
  "encoding": {
    "y": {
      "field": "officer",
      "type": "nominal",
      "title": "Field officer",
      "sort": {
        "field": "households",
        "op": "sum",
        "order": "descending"
      }
    },
    "x": {
      "field": "households",
      "type": "quantitative",
      "title": "Households assigned",
      "scale": {
        "zero": true
      }
    },
    "tooltip": [
      {
        "field": "officer",
        "type": "nominal"
      },
      {
        "field": "households",
        "type": "quantitative",
        "title": "Assigned"
      },
      {
        "field": "visited",
        "type": "quantitative",
        "title": "Visited in June 2026"
      },
      {
        "field": "unvisited",
        "type": "quantitative",
        "title": "Unvisited in June 2026"
      },
      {
        "field": "capacity",
        "type": "quantitative",
        "title": "Illustrative capacity"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#9ca3af"
      },
      "encoding": {
        "x2": {
          "field": "capacity"
        }
      }
    },
    {
      "mark": {
        "type": "tick",
        "color": "#555",
        "thickness": 2,
        "size": 20
      },
      "encoding": {
        "x": {
          "field": "capacity",
          "type": "quantitative",
          "title": "Households assigned"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "color": "#2e6f95"
      }
    },
    {
      "mark": {
        "type": "text",
        "dx": 12,
        "align": "left"
      },
      "encoding": {
        "text": {
          "field": "households",
          "type": "quantitative"
        }
      }
    }
  ]
}

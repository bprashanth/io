{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "config": {
    "font": "sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 220,
      "titleFontSize": 12,
      "labelFontSize": 11
    },
    "legend": {
      "labelLimit": 220
    },
    "title": {
      "anchor": "start",
      "fontSize": 16
    }
  },
  "title": {
    "text": "Sakhi changes most across equal three-month windows",
    "subtitle": "Before: Jul\u2013Sep 2025; after: Nov 2025\u2013Jan 2026"
  },
  "width": 430,
  "height": 300,
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 80
    }
  },
  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "title": "Comparison window",
      "sort": [
        "Before",
        "After"
      ],
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "repayment_rate",
      "type": "quantitative",
      "title": "Share of amount due repaid",
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": {
        "format": ".0%"
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "Self-help group"
    },
    "detail": {
      "field": "group",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "group",
        "type": "nominal"
      },
      {
        "field": "period",
        "type": "ordinal"
      },
      {
        "field": "repayment_rate",
        "type": "quantitative",
        "title": "Repaid",
        "format": ".1%"
      }
    ]
  }
}

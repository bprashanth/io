  "sql_duckdb": "WITH outreach_summary AS (SELECT \"School Name\", SUM(\"Applications Expected\") AS \"Expected Applications\" FROM \"lpf_outreach\" GROUP BY \"School Name\"), applications_matched AS (SELECT o.\"School Name\", COUNT(a.\"Applicant\") AS \"Received Applications\" FROM outreach_summary AS o LEFT JOIN \"lpf_applications\" AS a ON JARO_WINKLER_SIMILARITY(LOWER(TRIM(o.\"School Name\")), LOWER(TRIM(a.\"School\"))) >= 0.9 GROUP BY o.\"School Name\") SELECT o.\"School Name\", o.\"Expected Applications\", m.\"Received Applications\" FROM outreach_summary AS o JOIN applications_matched AS m ON o.\"School Name\" = m.\"School Name\" WHERE m.\"Received Applications\" * 1.0 / NULLIF(NULLIF(o.\"Expected Applications\", 0), 0) < 0.5",

  "sql_duckdb": "SELECT a.\"School\" AS \"School Name\", COALESCE(COUNT(a.\"Applicant\"), 0) AS \"Application Count\" FROM (SELECT DISTINCT \"Applicant\" FROM \"lpf_applications\") AS distinct_applicants LEFT JOIN \"lpf_applications\" AS a ON (UPPER(a.\"Applicant\") LIKE '%' || UPPER(SUBSTRING(distinct_applicants.\"Applicant\", 1, 3)) || '%' OR UPPER(a.\"Applicant\") LIKE '%' || UPPER(SUBSTRING(distinct_applicants.\"Applicant\", 1, 2)) || '%' OR UPPER(a.\"Applicant\") LIKE '%' || UPPER(distinct_applicants.\"Applicant\") || '%') GROUP BY a.\"School\" ORDER BY a.\"School\" ASC NULLS FIRST",

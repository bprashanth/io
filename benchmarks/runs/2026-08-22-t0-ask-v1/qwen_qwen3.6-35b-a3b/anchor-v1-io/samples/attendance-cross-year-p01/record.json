  "sql_duckdb": "WITH combined AS (SELECT \"Centre\" AS \"Centre Name\", \"Enrolled Kids\" AS \"Enrolled\", \"Avg Daily Present\" AS \"Present\", 2023 AS \"Year\" FROM \"attendance_2023\" UNION ALL SELECT \"centre_name\" AS \"Centre Name\", \"enrolment\" AS \"Enrolled\", \"average_attendance\" AS \"Present\", 2024 AS \"Year\" FROM \"attendance_2024\") SELECT \"Centre Name\", \"Year\", 100.0 * \"Present\" / NULLIF(NULLIF(\"Enrolled\", 0), 0) AS \"Attendance Percentage\" FROM combined ORDER BY \"Centre Name\" NULLS FIRST, \"Year\" NULLS FIRST",

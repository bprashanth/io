  "sql_duckdb": "WITH school_matches /* Combine school names with loose matching */ AS (SELECT \"School Name\" AS \"School\", JARO_WINKLER_SIMILARITY(LOWER(TRIM(\"School Name\")), LOWER(TRIM(s.\"School\"))) AS similarity FROM \"lpf_outreach\" AS o CROSS JOIN (SELECT DISTINCT \"School\" FROM \"lpf_applications\" WHERE NOT \"School\" IS NULL) AS s WHERE JARO_WINKLER_SIMILARITY(LOWER(TRIM(\"School Name\")), LOWER(TRIM(s.\"School\"))) >= 0.9), school_applications /* Get expected vs actual applications by school */ AS (SELECT sm.\"School\", COALESCE(SUM(CASE WHEN a.\"Status\" IN ('Submitted', 'Verified') THEN 1 ELSE 0 END), 0) AS \"Actual Applications\", COALESCE(SUM(o.\"Applications Expected\"), 0) AS \"Expected Applications\", (COALESCE(SUM(CASE WHEN a.\"Status\" IN ('Submitted', 'Verified') THEN 1 ELSE 0 END), 0) * 100.0 / NULLIF(NULLIF(COALESCE(SUM(o.\"Applications Expected\"), 0), 0), 0)) AS \"Percentage Met\" FROM school_matches AS sm LEFT JOIN \"lpf_outreach\" AS o ON sm.\"School\" = o.\"School Name\" LEFT JOIN \"lpf_applications\" AS a ON sm.\"School\" = a.\"School\" WHERE sm.similarity >= 0.9 GROUP BY sm.\"School\") SELECT \"School\", \"Actual Applications\", \"Expected Applications\", \"Percentage Met\" FROM school_applications WHERE \"Percentage Met\" < 50 ORDER BY \"Percentage Met\" NULLS FIRST",

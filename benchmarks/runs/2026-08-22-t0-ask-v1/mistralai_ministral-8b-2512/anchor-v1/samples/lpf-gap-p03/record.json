  "sql_duckdb": "WITH expected_vs_received AS (SELECT lo.\"School Name\" AS school_name, lo.\"Block\", lo.\"Applications Expected\" AS expected_applications, COUNT(DISTINCT la.\"Applicant\") AS received_applications, NULLIF(lo.\"Applications Expected\", 0) AS denominator FROM lpf_outreach AS lo JOIN lpf_applications AS la ON lo.\"School Name\" LIKE '%' || la.\"School\" || '%' WHERE lo.\"Block\" IN ('Atri', 'Barachatti', 'Belaganj', 'Dobhi', 'Fatehpur', 'Wazirganj') GROUP BY lo.\"School Name\", lo.\"Block\", lo.\"Applications Expected\") SELECT school_name, \"Block\", expected_applications, received_applications, (received_applications * 100.0 / NULLIF(NULLIF(expected_applications, 0), 0)) AS percentage_received FROM expected_vs_received WHERE received_applications < (expected_applications * 0.5) ORDER BY percentage_received NULLS FIRST",

  "sql_duckdb": "WITH matched AS (SELECT o.\"School Name\", o.\"Applications Expected\", a.\"Applicant\", a.\"School\" FROM \"lpf_outreach\" AS o LEFT JOIN \"lpf_applications\" AS a ON JARO_WINKLER_SIMILARITY(LOWER(TRIM(o.\"School Name\")), LOWER(TRIM(a.\"School\"))) >= 0.9 QUALIFY ROW_NUMBER() OVER (PARTITION BY a.\"Applicant\" ORDER BY JARO_WINKLER_SIMILARITY(LOWER(TRIM(o.\"School Name\")), LOWER(TRIM(a.\"School\"))) DESC) = 1), aggregated AS (SELECT \"School Name\", \"Applications Expected\", COUNT(*) AS \"Actual Applications\" FROM matched GROUP BY \"School Name\", \"Applications Expected\") SELECT \"School Name\", \"Applications Expected\", \"Actual Applications\", (\"Actual Applications\" * 100.0 / NULLIF(NULLIF(\"Applications Expected\", 0), 0)) AS \"Percentage of Expected\" FROM aggregated WHERE \"Actual Applications\" * 100.0 / NULLIF(NULLIF(\"Applications Expected\", 0), 0) < 50.0",

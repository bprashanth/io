ions\": {\"Course\": [\"Beautician\", \"Computer Operator\", \"Diploma Civil Engineering\", \"ITI Electrician\", \"Nursing Assistant\", \"Retail Sales Associate\", \"Tailoring & Fashion Design\"], \"Status\": [\"Incomplete\", \"Rejected\", \"Submitted\", \"Verified\"]}}\n\nCURRENT QUESTION:\nwhich schools got less than half the applications we expected from them, matching names loosely (each application should count towards only its single best matching school)",
      "response": "WITH matched AS (\n  SELECT \n    o.\"School Name\" AS school_name,\n    o.\"Applications Expected\" AS expected_apps,\n    COUNT(DISTINCT a.\"Applicant\") AS actual_apps\n  FROM \"lpf_outreach\" o\n  LEFT JOIN \"lpf_applications\" a\n    ON jaro_winkler_similarity(lower(trim(o.\"School Name\")), lower(trim(a.\"School\"))) >= 0.9\n    AND QUALIFY ROW_NUMBER() OVER (PARTITION BY a.\"Applicant\" ORDER BY jaro_winkler_similarity(lower(trim(o.\"School Name\")), lower(trim(a.\"School\"))) DESC) = 1\n  GROUP BY o.\"School Name\", o.\"Applications Expected\"\n)\nSELECT \n  school_name,\n  expected_apps,\n  actual_apps,\n  CASE \n    WHEN expected_apps IS NULL THEN NULL\n    WHEN actual_apps IS NULL THEN NULL\n    WHEN expected_apps = 0 THEN NULL\n    ELSE actual_apps * 1.0 / expected_apps\n  END AS ratio\nFROM matched\nWHERE expected_apps IS NOT NULL\n  AND actual_apps IS NOT NULL\n  AND actual_apps * 2.0 < expected_apps\nORDER BY ratio ASC;",

  "row_order_required": false,
  "sql_duckdb": "WITH attendance_2023 AS (SELECT \"Centre\", \"Month\", \"Enrolled Kids\" AS enrolled_2023, \"Avg Daily Present\" AS present_2023 FROM \"attendance_2023\"), attendance_2024 AS (SELECT \"centre_name\" AS Centre, \"month\" AS Month, \"enrolment\" AS enrolled_2024, \"average_attendance\" AS present_2024 FROM \"attendance_2024\"), combined AS (SELECT a.Centre, a.Month, a.enrolled_2023, a.present_2023, b.enrolled_2024, b.present_2024 FROM attendance_2023 AS a JOIN attendance_2024 AS b ON a.Centre = b.Centre AND a.Month = b.Month) SELECT Centre, Month, enrolled_2023, present_2023, enrolled_2024, present_2024, (present_2023 * 100.0 / NULLIF(NULLIF(enrolled_2023, 0), 0)) AS attendance_percent_2023, (present_2024 * 100.0 / NULLIF(NULLIF(enrolled_2024, 0), 0)) AS attendance_percent_2024 FROM combined ORDER BY Centre NULLS FIRST, Month NULLS FIRST",

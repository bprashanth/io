me\": [\"Chembur Balwadi\", \"Dharavi Balwadi\", \"Govandi Balwadi\", \"Kurla Balwadi\", \"Mankhurd Balwadi\", \"Sion Balwadi\", \"Wadala Balwadi\", \"Worli Balwadi\"], \"month\": [\"April\", \"August\", \"December\", \"February\", \"January\", \"July\", \"June\", \"March\", \"May\", \"November\", \"October\", \"September\"]}}\n\nCURRENT QUESTION:\ncompare average daily attendance rate per centre across the two years, one row each",
      "response": "```sql\nWITH\nattendance_2023_renamed AS (\n  SELECT\n    \"Centre\" AS centre_name,\n    \"Month\",\n    \"Enrolled Kids\" AS enrolment,\n    \"Avg Daily Present\" AS average_attendance\n  FROM \"attendance_2023\"\n),\nattendance_2024_renamed AS (\n  SELECT\n    \"centre_name\",\n    \"month\" AS \"Month\",\n    \"enrolment\",\n    \"average_attendance\"\n  FROM \"attendance_2024\"\n),\ncombined AS (\n  SELECT\n    centre_name,\n    \"Month\",\n    year,\n    enrolment,\n    average_attendance,\n    CASE\n      WHEN enrolment > 0 THEN (average_attendance * 100.0 / NULLIF(enrolment, 0))\n      ELSE NULL\n    END AS \"Average Daily Attendance Rate (%)\"\n  FROM (\n    SELECT\n      centre_name,\n      \"Month\",\n      2023 AS year,\n      enrolment,\n      average_attendance\n    FROM attendance_2023_renamed\n    UNION ALL\n    SELECT\n      centre_name,\n      \"Month\",\n      2024 AS year,\n      enrolment,\n      average_attendance\n    FROM attendance_2024_renamed\n  )\n)\nSELECT\n  centre_name,\n  \"Average Daily Attendance Rate (%)\" AS \"2023 Rate (%)\",\n  FIRST_VALUE(\"Average Daily Attendance Rate (%)\") OVER (\n    PARTITION BY centre_name\n    ORDER BY year\n    ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING\n  ) AS \"2024 Rate (%)\"\nFROM combined\nWHERE year = 2023\nGROUP BY centre_name, \"Average Daily Attendance Rate (%)\"\nORDER BY centre_name;\n```",

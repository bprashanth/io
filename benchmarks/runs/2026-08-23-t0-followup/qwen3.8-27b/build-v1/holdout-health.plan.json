{
 "plan": {
  "title": "District Health Indicators Dashboard",
  "subtitle": "Comparative analysis of key health outcomes across districts in Bihar, Jharkhand, and Odisha",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Districts Tracked",
    "sql": "SELECT COUNT(DISTINCT \"District\") AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Avg. Institutional Births",
    "sql": "SELECT AVG(\"Institutional births (%)\") AS avg_inst_births FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg. Stunting Rate",
    "sql": "SELECT AVG(\"Children under 5 years who are stunted (%)\") AS avg_stunting FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Institutional Births by District",
    "sql": "SELECT \"District\", AVG(\"Institutional births (%)\") AS inst_births FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "District",
    "y": [
     "inst_births"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Stunting Rate by District",
    "sql": "SELECT \"District\", AVG(\"Children under 5 years who are stunted (%)\") AS stunting FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "District",
    "y": [
     "stunting"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Vaccination Coverage by District",
    "sql": "SELECT \"District\", AVG(\"Children age 12-23 months fully vaccinated (%)\") AS vaccination FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "District",
    "y": [
     "vaccination"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "District Health Summary",
    "sql": "SELECT \"District\", \"State\", AVG(\"Institutional births (%)\") AS inst_births, AVG(\"Children under 5 years who are stunted (%)\") AS stunting, AVG(\"Children age 12-23 months fully vaccinated (%)\") AS vaccination, AVG(\"Households with improved sanitation facility (%)\") AS sanitation FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1, 2 ORDER BY 3 DESC"
   }
  ],
  "narrative": "This dashboard tracks {{p1}} districts across three states. The average rate of institutional births is {{p2}}, while the average stunting rate among children under five is {{p3}}.\n\nThe district with the highest institutional birth rate is {{p4}}, indicating stronger access to facility-based care. Conversely, the district with the highest stunting rate is {{p5}}, highlighting a critical area for nutritional intervention.\n\nVaccination coverage varies significantly, with {{p6}} leading in full immunization for children aged 12-23 months. The table below provides a detailed breakdown of these key indicators for all tracked districts."
 },

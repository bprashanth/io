{
 "plan": {
  "title": "Child Fitness Improvement Dashboard",
  "subtitle": "Tracking physical performance changes from baseline to endline by location and coach",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Children Tracked",
    "sql": "SELECT COUNT(DISTINCT \"Child ID\") AS n FROM \"baseline\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Avg Shuttle Run Improvement (sec)",
    "sql": "SELECT AVG(b.\"Shuttle run sec\" - e.\"Shuttle run sec\") AS avg_improvement FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\"",
    "unit": "sec"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg Sit-ups Improvement",
    "sql": "SELECT AVG(e.\"Sit ups\" - b.\"Sit ups\") AS avg_improvement FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\"",
    "unit": "reps"
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Avg Shuttle Run Improvement by Location",
    "sql": "SELECT b.\"Location\" AS location, AVG(b.\"Shuttle run sec\" - e.\"Shuttle run sec\") AS avg_improvement FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
    "x": "location",
    "y": [
     "avg_improvement"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Avg Sit-ups Improvement by Coach",
    "sql": "SELECT b.\"Coach\" AS coach, AVG(e.\"Sit ups\" - b.\"Sit ups\") AS avg_improvement FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
    "x": "coach",
    "y": [
     "avg_improvement"
    ]
   },
   {
    "id": "p6",
    "kind": "scatter",
    "title": "Shuttle Run vs Sit-ups Improvement",
    "sql": "SELECT b.\"Child name\" AS child, (b.\"Shuttle run sec\" - e.\"Shuttle run sec\") AS shuttle_improvement, (e.\"Sit ups\" - b.\"Sit ups\") AS situps_improvement FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\"",
    "x": "shuttle_improvement",
    "y": [
     "situps_improvement"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Top 10 Improvers (Shuttle Run)",
    "sql": "SELECT b.\"Child name\" AS child, b.\"Location\" AS location, b.\"Coach\" AS coach, b.\"Shuttle run sec\" AS baseline_shuttle, e.\"Shuttle run sec\" AS endline_shuttle, (b.\"Shuttle run sec\" - e.\"Shuttle run sec\") AS improvement FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\" ORDER BY 6 DESC LIMIT 10"
   }
  ],
  "narrative": "This dashboard highlights the physical development of children across various locations and coaching groups. The total number of children tracked is {{p1}}, providing a baseline for the scope of the program.\n\nIn terms of speed, the average improvement in shuttle run time is {{p2}} seconds, indicating a general trend toward faster performance. The top performing location in terms of shuttle run improvement is {{p4}}, while the most effective coach for sit-ups is {{p5}}.\n\nThe scatter plot reveals the relationship between speed and strength improvements, with the top individual improver being {{p7}}. This data helps identify which coaching strategies and locations are yielding the best results."
 },

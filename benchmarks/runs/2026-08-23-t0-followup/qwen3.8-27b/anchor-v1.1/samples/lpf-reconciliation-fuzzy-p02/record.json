  "sql_duckdb": "WITH outreach_schools /* 1. Extract distinct schools from the outreach table */ AS (SELECT DISTINCT \"School Name\" AS school_name FROM lpf_outreach), apps /* 2. Prepare applications for matching */ AS (SELECT \"School\" AS app_school, \"Applicant\" FROM lpf_applications), matches /* 3. Calculate similarity scores between each application school and each outreach school */ /* We use a simple Levenshtein distance approximation or exact match logic. */ /* Since DuckDB doesn't have a built-in fuzzy match that returns a single \"best\" easily without window functions, */ /* we will compute the distance for all pairs, then pick the minimum distance per application. */ /* Note: DuckDB has `levenshtein` function. */ AS (SELECT a.app_school, o.school_name, LEVENSHTEIN(LOWER(a.app_school), LOWER(o.school_name)) AS dist FROM apps AS a CROSS JOIN outreach_schools AS o), best_matches /* 4. Find the best match for each application */ AS (SELECT app_school, school_name, dist, ROW_NUMBER() OVER (PARTITION BY app_school ORDER BY dist ASC NULLS FIRST) AS rn FROM matches), final_matches /* 5. Filter to only the best match (rn = 1) */ /* We might want to filter out matches that are too far apart, but the prompt says \"matching names approximately\", */ /* implying we should try to match them. If no match is close, it might be null, but the prompt asks for \"zero counted for schools with no applications\". */ /* This implies we should count applications that *do* match. */ /* However, \"each application should count towards only its single best matching school\" suggests we assign every application to its closest school. */ /* If the closest school is very far, is it a match? Usually, in these tasks, we assume the data is reasonably clean or we just take the closest. */ /* Let's assume we take the closest one. */ AS (SELECT app_school, school_name FROM best_matches WHERE rn = 1) /* 6. Aggregate counts per school */ SELECT o.school_name AS \"School Name\", COUNT(f.app_school) AS \"Application Count\" FROM outreach_schools AS o LEFT JOIN final_matches AS f ON o.school_name = f.school_name GROUP BY o.school_name ORDER BY o.school_name ASC NULLS FIRST",

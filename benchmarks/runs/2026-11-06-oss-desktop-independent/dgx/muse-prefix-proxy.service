[Unit]
Description=Muse prefix proxy: keeps Claude Code's preamble cacheable (127.0.0.1:8185 -> Muse 8181)
After=network-online.target docker.service
[Service]
Type=simple
WorkingDirectory=/home/beeps/src/github.com/bprashanth/io
ExecStart=/usr/bin/python3 -I benchmarks/runs/2026-11-06-oss-desktop-independent/dgx/muse_prefix_proxy.py 8185 127.0.0.1:8181
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target

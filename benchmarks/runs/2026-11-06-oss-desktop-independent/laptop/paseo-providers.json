{
  "agents": {
    "providers": {
      "t4gc-codex": {
        "extends": "codex", "label": "Codex · T4GC model",
        "env": { "CODEX_HOME": "REPLACE_WITH_HOME/.codex-t4gc" },
        "models": [ { "id": "muse-glimmer-30b", "label": "T4GC model (Idli)", "isDefault": true } ]
      },
      "t4gc-claude": {
        "extends": "claude", "label": "Claude Code · T4GC model",
        "env": { "CLAUDE_CONFIG_DIR": "REPLACE_WITH_HOME/.claude-t4gc" },
        "models": [ { "id": "muse-glimmer-30b", "label": "T4GC model (Idli)", "isDefault": true } ],
        "disallowedTools": ["WebSearch", "WebFetch"]
      }
    }
  }
}

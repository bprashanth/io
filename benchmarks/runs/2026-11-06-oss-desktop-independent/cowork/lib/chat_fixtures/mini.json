{
  "id": "synthetic",
  "name": "Synthetic NGO Mini",
  "goal": "Explore household debt and field visits with checked calculations.",
  "date": "2026-11-14",
  "author": "Test author",
  "files": [
    {
      "title": "households.xlsx",
      "local": "drive/households.xlsx"
    },
    {
      "title": "field_programme_tracker.xlsx",
      "local": "drive/field_programme_tracker.xlsx"
    }
  ],
  "questions": [
    {
      "id": "ranking",
      "question": "Rank wards by average debt, income or vulnerability; show the top wards.",
      "params": {
        "metric": {
          "type": "choice",
          "choices": [
            "debt",
            "income",
            "vulnerability"
          ],
          "default": "debt"
        },
        "limit": {
          "type": "number",
          "default": 3
        }
      },
      "script": "ranking.py"
    },
    {
      "id": "filter",
      "question": "List households and their debt and income in one ward.",
      "params": {
        "ward": {
          "type": "choice",
          "choices": [
            "Kasewadi",
            "Ramtekdi",
            "Yerawada Ward",
            "Janata Vasahat",
            "Hadapsar Ward"
          ],
          "default": "Kasewadi"
        }
      },
      "script": "filter.py"
    },
    {
      "id": "threshold",
      "question": "Which households in a ward owe more than a number of months of income?",
      "params": {
        "ward": {
          "type": "choice",
          "choices": [
            "Kasewadi",
            "Ramtekdi",
            "Yerawada Ward",
            "Janata Vasahat",
            "Hadapsar Ward"
          ],
          "default": "Kasewadi"
        },
        "months": {
          "type": "number",
          "default": 6
        }
      },
      "script": "threshold.py"
    },
    {
      "id": "comparison",
      "question": "Compare the average debt of two wards.",
      "params": {
        "ward_a": {
          "type": "choice",
          "choices": [
            "Kasewadi",
            "Ramtekdi",
            "Yerawada Ward",
            "Janata Vasahat",
            "Hadapsar Ward"
          ],
          "default": "Kasewadi"
        },
        "ward_b": {
          "type": "choice",
          "choices": [
            "Kasewadi",
            "Ramtekdi",
            "Yerawada Ward",
            "Janata Vasahat",
            "Hadapsar Ward"
          ],
          "default": "Ramtekdi"
        }
      },
      "script": "comparison.py"
    },
    {
      "id": "trend",
      "question": "Show the monthly number of field visits with a chosen status over time.",
      "params": {
        "status": {
          "type": "choice",
          "choices": [
            "Done",
            "Follow-up",
            "Cancelled"
          ],
          "default": "Done"
        }
      },
      "script": "trend.py"
    }
  ]
}

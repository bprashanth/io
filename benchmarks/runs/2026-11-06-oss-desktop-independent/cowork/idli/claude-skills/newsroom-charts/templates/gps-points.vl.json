{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 260,
  "height": 240,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 95
    },
    "axisX": {
      "grid": true,
      "gridColor": "#ddd",
      "gridOpacity": 0.35
    },
    "legend": {
      "disable": true
    },
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 12,
      "offset": 16
    }
  },
  "description": "Source: Synthetic visit locations. Boundaries: DataMeet. CC BY 4.0. Locations stay on this computer.",
  "title": {
    "text": [
      "Visits are close",
      "to the city centre"
    ],
    "subtitle": "Visit locations: latitude and longitude"
  },
  "usermeta": {
    "idli_map": {
      "type": "gps",
      "lat": "lat",
      "lon": "lon",
      "label": "group"
    }
  },
  "layer": [
    {
      "data": {
        "url": "/geo/india-states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": "geoshape"
    },
    {
      "mark": "point",
      "encoding": {
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal"
          },
          {
            "field": "count",
            "type": "quantitative"
          }
        ]
      }
    }
  ]
}

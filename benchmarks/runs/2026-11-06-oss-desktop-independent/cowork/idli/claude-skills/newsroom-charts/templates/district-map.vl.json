{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 260,
  "height": 240,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 95
    },
    "axisX": {
      "grid": true,
      "gridColor": "#ddd",
      "gridOpacity": 0.35
    },
    "legend": {
      "disable": true
    },
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 12,
      "offset": 16
    }
  },
  "description": "Source: Synthetic district totals. Boundaries: DataMeet. CC BY 2.5 India and CC BY 4.0. Historic boundaries may differ from current districts.",
  "title": {
    "text": [
      "Pune records the most",
      "households in this example"
    ],
    "subtitle": "Households by district"
  },
  "usermeta": {
    "idli_map": {
      "type": "district",
      "field": "district",
      "state": "state",
      "value": "count"
    }
  },
  "layer": [
    {
      "data": {
        "url": "/geo/india-districts.topo.json",
        "format": {
          "type": "topojson",
          "feature": "districts"
        }
      },
      "mark": "geoshape"
    }
  ]
}

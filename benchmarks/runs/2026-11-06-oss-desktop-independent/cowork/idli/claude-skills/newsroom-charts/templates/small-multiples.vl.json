{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 260,
  "height": 240,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 95
    },
    "axisX": {
      "grid": false,
      "gridColor": "#ddd",
      "gridOpacity": 0.35
    },
    "legend": {
      "disable": true
    },
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 12,
      "offset": 16
    },
    "axisY": {
      "grid": true,
      "gridColor": "#ddd",
      "gridOpacity": 0.35
    }
  },
  "description": "Source: Synthetic programme records. Counts are examples.",
  "title": {
    "text": [
      "Visits rose most",
      "in Garden"
    ],
    "subtitle": "Visits by month and ward"
  },
  "facet": {
    "row": {
      "field": "group",
      "type": "nominal",
      "header": {
        "title": null,
        "labelAngle": 0
      }
    }
  },
  "spec": {
    "width": 230,
    "height": 95,
    "mark": {
      "type": "line",
      "point": true
    },
    "encoding": {
      "x": {
        "field": "month",
        "type": "ordinal",
        "title": null,
        "sort": [
          "Jan",
          "Feb",
          "Mar"
        ],
        "axis": {
          "labelAngle": 0
        }
      },
      "y": {
        "field": "count",
        "type": "quantitative",
        "title": "Visits"
      },
      "color": {
        "condition": {
          "test": "datum.group === 'Garden'",
          "value": "#41788b"
        },
        "value": "#aaa"
      }
    }
  },
  "resolve": {
    "scale": {
      "y": "shared"
    }
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 260,
  "height": 240,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 95
    },
    "axisX": {
      "grid": true,
      "gridColor": "#ddd",
      "gridOpacity": 0.35
    },
    "legend": {
      "disable": true
    },
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 12,
      "offset": 16
    }
  },
  "description": "Source: Synthetic programme records. Counts are examples.",
  "title": {
    "text": [
      "Garden has the largest",
      "caseload"
    ],
    "subtitle": "Households by ward"
  },
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "count",
      "type": "quantitative",
      "title": "Households",
      "scale": {
        "zero": true,
        "domainMax": 65
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.group === 'Garden'",
            "value": "#41788b"
          },
          "value": "#aaa"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10
      },
      "encoding": {
        "text": {
          "field": "count",
          "type": "quantitative"
        }
      }
    }
  ]
}

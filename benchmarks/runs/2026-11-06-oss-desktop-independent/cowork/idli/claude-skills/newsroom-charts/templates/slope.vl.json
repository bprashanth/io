{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 260,
  "height": 240,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 95
    },
    "axisX": {
      "grid": false,
      "gridColor": "#ddd",
      "gridOpacity": 0.35
    },
    "legend": {
      "disable": true
    },
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 12,
      "offset": 16
    },
    "axisY": {
      "grid": true,
      "gridColor": "#ddd",
      "gridOpacity": 0.35
    }
  },
  "description": "Source: Synthetic programme records. Counts are examples.",
  "title": {
    "text": [
      "Garden records the",
      "largest increase"
    ],
    "subtitle": "Visits before and after"
  },
  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "sort": [
        "Before",
        "After"
      ],
      "title": null
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Visits"
    },
    "detail": {
      "field": "group",
      "type": "nominal"
    },
    "color": {
      "condition": {
        "test": "datum.group === 'Garden'",
        "value": "#41788b"
      },
      "value": "#aaa"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period === 'After'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -7,
        "dy": -10
      },
      "encoding": {
        "text": {
          "field": "group",
          "type": "nominal"
        }
      }
    }
  ]
}

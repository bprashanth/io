{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 260,
  "height": 240,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "grid": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 95
    },
    "axisX": {
      "grid": false,
      "gridColor": "#ddd",
      "gridOpacity": 0.35
    },
    "legend": {
      "disable": true
    },
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 12,
      "offset": 16
    }
  },
  "description": "Source: Synthetic programme records. Counts are examples.",
  "title": {
    "text": [
      "Garden has the most visits",
      "in each month"
    ],
    "subtitle": "Visits by ward and month"
  },
  "encoding": {
    "x": {
      "field": "month",
      "type": "ordinal",
      "title": null,
      "sort": [
        "Jan",
        "Feb",
        "Mar"
      ],
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "group",
      "type": "nominal",
      "title": null
    }
  },
  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "color": {
          "field": "count",
          "type": "quantitative",
          "scale": {
            "range": [
              "#e2e8e8",
              "#41788b"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text"
      },
      "encoding": {
        "text": {
          "field": "count",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.count >= 35",
            "value": "#fff"
          },
          "value": "#222"
        }
      }
    }
  ]
}

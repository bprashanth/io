{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "config": {
    "font": "sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 220,
      "titleFontSize": 12,
      "labelFontSize": 11
    },
    "legend": {
      "labelLimit": 220
    },
    "title": {
      "anchor": "start",
      "fontSize": 16
    }
  },
  "title": "Training and repayment events for one group",
  "width": 680,
  "height": 140,
  "mark": {
    "type": "point",
    "filled": true,
    "size": 130
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Date",
      "axis": {
        "format": "%b %Y",
        "tickCount": 8
      }
    },
    "y": {
      "field": "lane",
      "type": "nominal",
      "title": "Event"
    },
    "color": {
      "field": "outcome",
      "type": "nominal",
      "title": "Observation",
      "scale": {
        "domain": [
          "Training held",
          "Training missed",
          "Repayment at least 80%",
          "Repayment below 80%"
        ],
        "range": [
          "#2e6f95",
          "#c34722",
          "#479a80",
          "#a35c94"
        ]
      }
    },
    "shape": {
      "field": "outcome",
      "type": "nominal",
      "title": "Observation",
      "scale": {
        "domain": [
          "Training held",
          "Training missed",
          "Repayment at least 80%",
          "Repayment below 80%"
        ],
        "range": [
          "triangle-up",
          "cross",
          "circle",
          "square"
        ]
      }
    },
    "tooltip": [
      {
        "field": "date",
        "type": "temporal"
      },
      {
        "field": "outcome",
        "type": "nominal"
      },
      {
        "field": "details",
        "type": "nominal"
      }
    ]
  }
}

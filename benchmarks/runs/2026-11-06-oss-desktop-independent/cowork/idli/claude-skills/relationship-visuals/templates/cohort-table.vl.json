{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "config": {
    "font": "sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 220,
      "titleFontSize": 12,
      "labelFontSize": 11
    },
    "legend": {
      "labelLimit": 220
    },
    "title": {
      "anchor": "start",
      "fontSize": 16
    }
  },
  "title": "Attendance by first-training cohort",
  "width": 600,
  "height": 160,
  "mark": {
    "type": "text",
    "fontSize": 16,
    "color": "#244c64"
  },
  "encoding": {
    "x": {
      "field": "elapsed_quarter",
      "type": "ordinal",
      "title": "Quarters since first scheduled training",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "cohort",
      "type": "ordinal",
      "title": "First scheduled training quarter"
    },
    "text": {
      "field": "attendance_label",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "cohort",
        "type": "nominal"
      },
      {
        "field": "elapsed_quarter",
        "type": "ordinal"
      },
      {
        "field": "attendance_label",
        "type": "nominal",
        "title": "Attendance / eligible members"
      },
      {
        "field": "observed_sessions",
        "type": "quantitative",
        "title": "Sessions with known attendance"
      },
      {
        "field": "planned_sessions",
        "type": "quantitative",
        "title": "Scheduled sessions"
      }
    ]
  }
}

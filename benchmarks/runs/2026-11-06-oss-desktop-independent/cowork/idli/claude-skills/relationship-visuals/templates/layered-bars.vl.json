{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "config": {
    "font": "sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 220,
      "titleFontSize": 12,
      "labelFontSize": 11
    },
    "legend": {
      "labelLimit": 220
    },
    "title": {
      "anchor": "start",
      "fontSize": 16
    }
  },
  "title": "Household membership links groups to wards",
  "width": 520,
  "height": 220,
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "households",
      "type": "quantitative",
      "title": "Member households",
      "stack": "zero",
      "axis": {
        "tickMinStep": 1
      }
    },
    "y": {
      "field": "group",
      "type": "nominal",
      "title": "Self-help group",
      "sort": "ascending"
    },
    "color": {
      "field": "ward",
      "type": "nominal",
      "title": "Ward",
      "scale": {
        "scheme": "tableau10"
      }
    },
    "order": {
      "field": "ward",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "group",
        "type": "nominal"
      },
      {
        "field": "ward",
        "type": "nominal"
      },
      {
        "field": "households",
        "type": "quantitative",
        "title": "Member households"
      }
    ]
  }
}

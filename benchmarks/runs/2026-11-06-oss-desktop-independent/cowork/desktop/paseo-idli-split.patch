+    f.client.createTerminal.mockResolvedValue({ error: "missing claude" });
+    await expect(
+      createRawClaudeWorkspace(f as unknown as Parameters<typeof createRawClaudeWorkspace>[0]),
+    ).rejects.toThrow("missing claude");
+    expect(f.navigate).not.toHaveBeenCalled();

+
+describe("Drivey project heading +", () => {
+  function fixture() {
+    return {
+      client: {
+        createWorkspace: vi
+          .fn()
+          .mockResolvedValue({ workspace: { id: "drivey-ws", workspaceDirectory: "/drivey" } }),
+        createAgent: vi.fn().mockResolvedValue({ id: "left-agent" }),
+        createTerminal: vi.fn().mockResolvedValue({ terminal: { id: "claude-terminal" } }),
+      },
+      serverId: "host",
+      projectId: "drivey-project",
+      path: "/drivey",
+      accept: vi.fn(),
+      acceptAgent: vi.fn(),
+      navigate: vi.fn(),
+      openClaude: vi.fn(),

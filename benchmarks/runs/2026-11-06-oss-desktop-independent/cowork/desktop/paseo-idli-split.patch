+  it("creates no initial agent and opens the bare CLI in the new workspace", async () => {
+    const f = fixture();
+    await createRawClaudeWorkspace(f as unknown as Parameters<typeof createRawClaudeWorkspace>[0]);
+    expect(f.client.createWorkspace).toHaveBeenCalledWith({

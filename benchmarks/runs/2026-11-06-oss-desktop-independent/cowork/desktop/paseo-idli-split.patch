+  }
+
+  it("opens the labeled Drivey chat focused and launches masked Claude with its workspace", async () => {
+    const f = fixture();
+    await createDriveyWorkspace(f);
+    expect(f.client.createWorkspace).toHaveBeenCalledWith({
+      source: { kind: "directory", path: "/drivey", projectId: "drivey-project" },
+      title: "Drivey",
+    });
+    expect(f.client.createAgent).toHaveBeenCalledWith({
+      provider: "t4gc-cowork",
+      model: IDLI_DRIVEY_MODEL,
+      cwd: "/drivey",
+      workspaceId: "drivey-ws",
+      labels: { "idli.ws": "drivey-ws", "idli.left": "1" },
+      initialPrompt: "Start Drivey",

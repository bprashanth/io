+import { describe, expect, it } from "vitest";
+import { rawClaudeProfile } from "./idli-claude-cli";
+
+describe("raw Claude workspace", () => {
+  it("launches the native interactive CLI with no prompt or permission overrides", () => {
+    expect(rawClaudeProfile("Claude Code")).toMatchObject({command:"claude", args:[]});
+  });
+  it("leaves all other workspaces on their existing chat path", () => {
+    for (const title of [null, undefined, "Drivey", "WhatsAppy", "Canvay", "Claude Code test"])
+      expect(rawClaudeProfile(title)).toBeUndefined();
+  });
+});
+
+import { isRawClaudeWorkspace } from "./idli-claude-cli";
+describe("project identity instead of one workspace title", () => {
+  it("recognizes renamed workspaces inside the Claude Code project", () => {
+    expect(isRawClaudeWorkspace({title:"Greeting",projectCustomName:"Claude Code",projectDisplayName:"drivey-tui"})).toBe(true);
+  });
+  it("does not reroute Drivey just because its workspace title matches", () => {
+    expect(isRawClaudeWorkspace({title:"Claude Code",projectDisplayName:"Drivey"})).toBe(false);
+  });
+});

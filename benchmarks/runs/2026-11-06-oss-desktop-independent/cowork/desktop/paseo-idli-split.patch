@@ -0,0 +1,15 @@
+import type { TerminalProfile } from "@getpaseo/protocol/messages";
+
+/** Explicit opt-in by workspace title; never reroute Drivey or other agent workspaces. */
+export function rawClaudeProfile(title: string | null | undefined): TerminalProfile | undefined {
+  return title === "Claude Code"
+    ? { id: "idli-raw-claude", name: "Claude Code", command: "claude", args: [], icon: "claude" }
+    : undefined;
+}
+
+export function isRawClaudeWorkspace(workspace: {
+  title?: string | null; projectCustomName?: string | null; projectDisplayName?: string;
+} | null | undefined): boolean {
+  if (!workspace) return false;
+  return (workspace.projectCustomName ?? workspace.projectDisplayName ?? workspace.title) === "Claude Code";
+}

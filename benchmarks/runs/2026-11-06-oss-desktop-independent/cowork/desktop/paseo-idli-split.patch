index 00000000..465a9774
--- /dev/null
+++ b/packages/app/src/utils/idli-minis.ts
@@ -0,0 +1,75 @@
+import { z } from "zod";
+import type { StreamItem } from "@/types/stream";
+
+export const IDLI_MINIS_URL = "http://dashboard.localhost:8797/api/minis-public";
+export const IDLI_DRIVEY_OPENING =
+  "Ask about your Drive files. Type @ to pick a file or a folder, or start from a Mini.";
+
+export const IdliMinisSchema = z.array(
+  z.object({
+    id: z.string(),
+    name: z.string(),
+    heading: z.string(),
+    date: z.string(),
+    author: z.string(),
+  }),
+);
+export type IdliMini = z.infer<typeof IdliMinisSchema>[number];
+
+export function hasOnlyDriveyOpening(items: readonly StreamItem[]): boolean {
+  let users = 0;
+  let assistants = 0;
+  for (const item of items) {
+    if (item.kind === "notification") continue;
+    if (item.kind === "user_message") {
+      if (item.text !== "Start Drivey" || ++users > 1) return false;
+    } else if (item.kind === "assistant_message") {
+      if (!IDLI_DRIVEY_OPENING.startsWith(item.text) || ++assistants > 1) return false;
+    } else {
+      return false;
+    }
+  }
+  return users === 1;
+}
+
+export function miniMessage(mini: IdliMini): string {
+  return `Open Mini: ${mini.name} [${mini.id}]`;
+}
+
+export function miniDisplayText(value: string): string {
+  return value
+    .replace(/[\u2190-\u21ff\u27f0-\u27ff\u2900-\u297f]/g, "->")
+    .replace(/\s*·\s*/g, " - ");
+}
+
+export function miniDate(value: string): string {
+  if (!/^\d{4}-\d{2}-\d{2}/.test(value)) return miniDisplayText(value);
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) return miniDisplayText(value);
+  return new Intl.DateTimeFormat("en-GB", {
+    day: "numeric",
+    month: "short",
+    timeZone: "UTC",
+  }).format(date);
+}
+
+interface IdliMinisVisibility {
+  isLeft: boolean;
+  readOnly: boolean;
+  historyReady: boolean;
+  hasOlder: boolean;
+  pendingCount: number;
+  tail: readonly StreamItem[];
+  head: readonly StreamItem[] | undefined;
+}
+
+export function shouldShowIdliMinis(input: IdliMinisVisibility): boolean {
+  return (
+    input.isLeft &&
+    !input.readOnly &&
+    input.historyReady &&
+    !input.hasOlder &&
+    input.pendingCount === 0 &&
+    hasOnlyDriveyOpening([...input.tail, ...(input.head ?? [])])
+  );
+}
diff --git a/packages/app/src/utils/idli-pairing.ts b/packages/app/src/utils/idli-pairing.ts
new file mode 100644
index 00000000..6c5b5269
--- /dev/null
+++ b/packages/app/src/utils/idli-pairing.ts
@@ -0,0 +1,168 @@
+import { isRawClaudeWorkspace } from "./idli-claude-cli";
+// Idli P15: every Idli chat has its own Claude chat beside it. In a workspace whose chats run on the Idli provider,
+// the layout keeps two panes: Idli's chats on the left, and on the right only the Claude chats paired with the Idli
+// chat shown on the left (label idli.pair=<idli agent id>, set by Idli's teach_send). Switching Idli chats swaps the
+// right side; other chats' Claude tabs leave the layout (closed and hidden, never archived) and come back with their
+// chat. An empty right pane shows a placeholder (split-container.tsx).
+import { useEffect } from "react";
+import { useWorkspaceLayoutStore } from "@/stores/workspace-layout-store";
+import { useSessionStore } from "@/stores/session-store";
+import { collectAllPanes, collectAllTabs } from "@/stores/workspace-layout-actions";
+import { normalizeWorkspaceOpaqueId } from "@/utils/workspace-identity";
+
+export const IDLI_PROVIDERS = new Set(["t4gc-cowork"]);
+export const PAIR_LABEL = "idli.pair";
+export const ROLE_LABEL = "idli.role";  // "setup" on Start here's Logins chat: that workspace never splits
+
+interface PairAgent {
+  id: string;
+  provider: string;
+  createdAt: Date;
+  archivedAt?: Date | null;
+  labels: Record<string, string>;
+  workspaceId?: string;
+}
+
+function workspaceAgents(serverId: string, workspaceId: string): PairAgent[] {
+  const session = useSessionStore.getState().sessions[serverId];
+  if (!session) return [];
+  const want = normalizeWorkspaceOpaqueId(workspaceId);
+  return Array.from(session.agents.values()).filter(
+    (a) => !a.archivedAt && normalizeWorkspaceOpaqueId(a.workspaceId) === want,
+  ) as PairAgent[];
+}
+
+function isSetup(agents: PairAgent[]): boolean {
+  return agents.some((a) => a.labels?.[ROLE_LABEL] === "setup");
+}
+
+export function isIdliWorkspace(serverId: string, workspaceId: string): boolean {
+  const session = useSessionStore.getState().sessions[serverId];
+  const workspace = Array.from(session?.workspaces.values() ?? []).find(w => normalizeWorkspaceOpaqueId(w.id) === normalizeWorkspaceOpaqueId(workspaceId));
+  if (isRawClaudeWorkspace(workspace)) return false;
+  const agents = workspaceAgents(serverId, workspaceId);
+  return !isSetup(agents) && !agents.some((a) => a.labels?.["idli.left"] === "1")
+    && agents.some((a) => IDLI_PROVIDERS.has(String(a.provider)));
+}
+
+let syncing = false;
+
+/** One idempotent pass; each store change triggers another, so it converges step by step. */
+export function syncIdliPair(serverId: string, workspaceId: string, workspaceKey: string): void {
+  if (syncing) return;
+  const session = useSessionStore.getState().sessions[serverId];
+  const workspace = Array.from(session?.workspaces.values() ?? []).find(w => normalizeWorkspaceOpaqueId(w.id) === normalizeWorkspaceOpaqueId(workspaceId));
+  if (isRawClaudeWorkspace(workspace)) return;
+  const agents = workspaceAgents(serverId, workspaceId);
+  if (!agents.some((a) => IDLI_PROVIDERS.has(String(a.provider)))) return;
+  // P19 Drivey workspaces keep the person's Claude CLI terminal on the right: no paired teaching chat
+  if (agents.some((a) => a.labels?.["idli.left"] === "1")) return;
+  syncing = true;
+  try {
+    const store = useWorkspaceLayoutStore.getState();
+    const layout = store.layoutByWorkspace[workspaceKey];
+    if (!layout) return;
+    const explorerId = store.explorerSidebarPaneIdByWorkspace[workspaceKey] ?? null;
+    const mains = collectAllPanes(layout.root).filter((p) => !p.hidden && p.id !== explorerId);
+    if (isSetup(agents)) {  // Start here: one pane; drop a side pane left over from before (nothing in it)
+      const side = mains.length >= 2 ? mains[mains.length - 1] : null;
+      const sideTabs = side ? collectAllTabs(layout.root).filter((t) => side.tabIds.includes(t.tabId)) : [];
+      if (side && sideTabs.every((t) => t.target.kind === "new_tab")) store.closePane(workspaceKey, side.id);
+      return;
+    }
+    if (mains.length < 2) {
+      store.ensureSidePane(workspaceKey, { focus: false });
+      return;
+    }
+    const left = mains[0];
+    const right = mains[mains.length - 1];
+    if (!left || !right) return;
+    // the pairing works in the background: if the person is on the left, they stay there
+    const keepLeft = layout.focusedPaneId === left.id;
+    const settle = () => {
+      if (keepLeft && useWorkspaceLayoutStore.getState().layoutByWorkspace[workspaceKey]?.focusedPaneId !== left.id) {
+        useWorkspaceLayoutStore.getState().focusPane(workspaceKey, left.id);
+      }
+    };
+    const byId = new Map(agents.map((a) => [a.id, a]));
+    const tabs = collectAllTabs(layout.root);
+    const agentOf = (tabId: string | null | undefined) => {
+      const t = tabs.find((x) => x.tabId === tabId);
+      return t && t.target.kind === "agent" ? byId.get(t.target.agentId) ?? null : null;
+    };
+    const pairOf = (a: PairAgent | null) => (a ? a.labels?.[PAIR_LABEL] ?? null : null);
+
+    // Claude chats never sit on the left
+    for (const tabId of left.tabIds) {
+      if (pairOf(agentOf(tabId))) {
+        store.moveTabToPane(workspaceKey, tabId, right.id);
+        settle();
+        return;
+      }
+    }
+    const idli = agentOf(left.focusedTabId);
+    if (!idli || pairOf(idli)) return;
+    const wanted = agents
+      .filter((a) => pairOf(a) === idli.id)
+      .sort((x, y) => new Date(x.createdAt).getTime() - new Date(y.createdAt).getTime());
+    const wantedIds = new Set(wanted.map((a) => a.id));
+
+    // other chats' Claude tabs leave the right side (hidden, not archived). Only when their Idli chat is in this
+    // workspace: a Claude chat paired with a chat elsewhere stays visible rather than vanish
+    for (const tabId of right.tabIds) {
+      const a = agentOf(tabId);
+      const pair = pairOf(a);
+      if (a && pair && !wantedIds.has(a.id) && byId.has(pair)) {
+        store.hideAgent(workspaceKey, a.id);
+        store.closeTab(workspaceKey, tabId);
+        settle();
+        return;
+      }
+    }
+    // this chat's Claude chats come (back) on the right
+    for (const a of wanted) {
+      if (!tabs.some((t) => t.target.kind === "agent" && t.target.agentId === a.id)) {
+        store.unhideAgent(workspaceKey, a.id);
+        store.openTab({
+          workspaceKey,
+          target: { kind: "agent", agentId: a.id },
+          intent: "background",
+          placement: { mode: "pane", paneId: right.id },
+        });
+        settle();
+        return;
+      }
+    }
+    const latest = wanted[wanted.length - 1];
+    const shown = agentOf(right.focusedTabId);
+    if (latest && (!shown || !wantedIds.has(shown.id))) {
+      const t = tabs.find((x) => x.target.kind === "agent" && x.target.agentId === latest.id);
+      if (t) store.selectTabInPane(workspaceKey, right.id, t.tabId);
+      settle();
+    }
+  } finally {
+    syncing = false;
+  }
+}
+
+export function useIdliPairing(serverId: string, workspaceId: string, workspaceKey: string): void {
+  useEffect(() => {
+    if (!serverId || !workspaceId || !workspaceKey) return;
+    let queued = false;
+    const kick = () => {
+      if (queued) return;
+      queued = true;
+      setTimeout(() => {
+        queued = false;
+        syncIdliPair(serverId, workspaceId, workspaceKey);
+      }, 50);
+    };
+    kick();
+    const offLayout = useWorkspaceLayoutStore.subscribe(kick);
+    const offSession = useSessionStore.subscribe(kick);
+    return () => {
+      offLayout();
+      offSession();
+    };
+  }, [serverId, workspaceId, workspaceKey]);
+}
diff --git a/packages/app/src/utils/idli-side-pane.test.ts b/packages/app/src/utils/idli-side-pane.test.ts
new file mode 100644
index 00000000..1e809d1e
--- /dev/null
+++ b/packages/app/src/utils/idli-side-pane.test.ts
@@ -0,0 +1,60 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { useWorkspaceLayoutStore } from "@/stores/workspace-layout-store";
+import {
+  collectAllPanes,
+  collectAllTabs,
+  findPaneContainingTab,
+} from "@/stores/workspace-layout-actions";
+import { placeTabOnSide } from "./idli-side-pane";
+
+const workspaceKey = "host:drivey-ws";
+
+beforeEach(() => {
+  useWorkspaceLayoutStore.setState({
+    layoutByWorkspace: {},
+    layoutMode: "split-panes",
+    explorerSidebarPaneIdByWorkspace: {},
+  });
+  useWorkspaceLayoutStore
+    .getState()
+    .openTab({ workspaceKey, target: { kind: "agent", agentId: "left-agent" }, intent: "reveal" });
+});
+
+describe("Idli pane placement", () => {
+  it("opens Claude on the right and keeps the left chat focused", () => {
+    expect(
+      placeTabOnSide({
+        serverId: "host",
+        workspaceId: "drivey-ws",
+        kind: "terminal",
+        id: "claude",
+        side: "right",
+        focus: false,
+      }),
+    ).toBe(true);
+    const layout = useWorkspaceLayoutStore.getState().layoutByWorkspace[workspaceKey];
+    const panes = collectAllPanes(layout.root);
+    const tabs = collectAllTabs(layout.root);
+    const left = tabs.find((tab) => tab.target.kind === "agent");
+    const right = tabs.find((tab) => tab.target.kind === "terminal");
+    expect(panes).toHaveLength(2);
+    expect(panes[0].tabIds).toEqual([left?.tabId]);
+    expect(panes[1].tabIds).toEqual([right?.tabId]);
+    expect(layout.focusedPaneId).toBe(panes[0].id);
+    expect(panes[0].focusedTabId).toBe(left?.tabId);
+  });
+  it("still focuses the right terminal for explicit CLI placement", () => {
+    placeTabOnSide({
+      serverId: "host",
+      workspaceId: "drivey-ws",
+      kind: "terminal",
+      id: "claude",
+      side: "right",
+    });
+    const layout = useWorkspaceLayoutStore.getState().layoutByWorkspace[workspaceKey];
+    const terminal = collectAllTabs(layout.root).find((tab) => tab.target.kind === "terminal");
+    expect(terminal).toBeDefined();
+    if (!terminal) throw new Error("Terminal tab missing");
+    expect(layout.focusedPaneId).toBe(findPaneContainingTab(layout.root, terminal.tabId)?.id);
+  });
+});
diff --git a/packages/app/src/utils/idli-side-pane.ts b/packages/app/src/utils/idli-side-pane.ts
new file mode 100644
index 00000000..9d2928a9
--- /dev/null
+++ b/packages/app/src/utils/idli-side-pane.ts
@@ -0,0 +1,157 @@
+// Idli P13: place a chat on one side of a two-pane workspace and give it focus, from the agent deep link
+// (paseo://h/<server>/agent/<id>~right or ~left: the desktop shell drops a link's query string, and rewriting the
+// shell means rebuilding app.asar, so the side rides on the agent id; the app strips it). Idli opens Claude's teaching chat on the right and comes back to
+// its own chat on the left; the pane in control carries the focus ring (P14), so a switch reads as "focus moved".
+import { useWorkspaceLayoutStore } from "@/stores/workspace-layout-store";
+import { useSessionStore } from "@/stores/session-store";
+import {
+  collectAllPanes,
+  collectAllTabs,
+  findPaneContainingTab,
+} from "@/stores/workspace-layout-actions";
+
+export type IdliSide = "left" | "right";
+
+export function parseIdliSide(value: unknown): IdliSide | null {
+  return value === "left" || value === "right" ? value : null;
+}
+
+/** "abc~right" -> { agentId: "abc", side: "right" }; anything else -> { agentId, side: null }. */
+export function splitIdliAgentId(raw: string): { agentId: string; side: IdliSide | null } {
+  const m = /^(.*)~(left|right)$/.exec(raw);
+  return m ? { agentId: m[1] ?? raw, side: m[2] as IdliSide } : { agentId: raw, side: null };
+}
+
+function agentWorkspaceId(serverId: string, agentId: string): string | null {
+  const session = useSessionStore.getState().sessions[serverId];
+  const agent = session?.agents.get(agentId) ?? session?.agentDetails.get(agentId);
+  return agent?.workspaceId ?? null;
+}
+
+function workspaceKeyFor(serverId: string, workspaceId: string): string | null {
+  const keys = Object.keys(useWorkspaceLayoutStore.getState().layoutByWorkspace);
+  const exact = `${serverId}:${workspaceId}`;
+  if (keys.includes(exact)) return exact;
+  return keys.find((key) => key.startsWith(`${serverId}:`) && key.endsWith(workspaceId)) ?? null;
+}
+
+/** One attempt; false when the chat's tab isn't in the layout yet (the caller retries). */
+export function placeAgentOnSide(input: {
+  serverId: string;
+  workspaceId?: string | null;
+  agentId: string;
+  side: IdliSide;
+}): boolean {
+  const workspaceId = input.workspaceId || agentWorkspaceId(input.serverId, input.agentId);
+  return placeTabOnSide({
+    serverId: input.serverId,
+    workspaceId,
+    kind: "agent",
+    id: input.agentId,
+    side: input.side,
+  });
+}
+
+/** P17: any tab (a chat or a terminal) on one side, focused. Idli puts the person's Claude CLI terminal on the right. */
+export function placeTabOnSide(input: {
+  serverId: string;
+  workspaceId?: string | null;
+  kind: "agent" | "terminal" | "browser";
+  id: string;
+  side: IdliSide;
+  focus?: boolean;
+}): boolean {
+  const store = useWorkspaceLayoutStore.getState();
+  const workspaceId = input.workspaceId;
+  if (!workspaceId) return false;
+  const key = workspaceKeyFor(input.serverId, workspaceId);
+  if (!key) return false;
+  const layout = store.layoutByWorkspace[key];
+  if (!layout) return false;
+  function match(t: ReturnType<typeof collectAllTabs>[number]) {
+    if (input.kind === "agent") return t.target.kind === "agent" && t.target.agentId === input.id;
+    if (input.kind === "browser")
+      return t.target.kind === "browser" && t.target.browserId === input.id;
+    return t.target.kind === "terminal" && t.target.terminalId === input.id;
+  }
+  const focusedTabId = collectAllPanes(layout.root).find(
+    (pane) => pane.id === layout.focusedPaneId,
+  )?.focusedTabId;
+  let tab = collectAllTabs(layout.root).find(match);
+  if (!tab && input.kind === "terminal") {
+    // a terminal made from the CLI has no tab yet: open one (this is what ?open=terminal:<id> does on first load)
+    store.openTab({
+      workspaceKey: key,
+      target: { kind: "terminal", terminalId: input.id },
+      intent: "background",
+      placement: { mode: "focused" },
+    });
+    const fresh = useWorkspaceLayoutStore.getState().layoutByWorkspace[key];
+    tab = fresh ? collectAllTabs(fresh.root).find(match) : undefined;
+  }
+  if (!tab) return false;
+  const now = useWorkspaceLayoutStore.getState().layoutByWorkspace[key] ?? layout;
+  const current = findPaneContainingTab(now.root, tab.tabId);
+  if (!current) return false;
+  const explorerId = store.explorerSidebarPaneIdByWorkspace[key];
+  const mains = collectAllPanes(now.root).filter((p) => !p.hidden && p.id !== explorerId);
+  const target = input.side === "right" ? mains[mains.length - 1] : mains[0];
+  if (mains.length >= 2 && target && target.id !== current.id) {
+    store.moveTabToPane(key, tab.tabId, target.id);
+  } else if (mains.length < 2 && input.side === "right" && current.tabIds.length > 1) {
+    store.splitPane(key, { tabId: tab.tabId, targetPaneId: current.id, position: "right" });
+  }
+  // Opening, moving and splitting can focus the terminal internally.
+  const focusTabId = input.focus === false ? focusedTabId : tab.tabId;
+  if (focusTabId) useWorkspaceLayoutStore.getState().focusTab(key, focusTabId);
+  return true;
+}
+
+/** Retries while navigation finishes opening the tab (layout hydration, deferred opens). */
+export function placeAgentOnSideSoon(
+  input: Parameters<typeof placeAgentOnSide>[0],
+  tries = 60,
+): void {
+  if (placeAgentOnSide(input) || tries <= 0) return;
+  setTimeout(() => placeAgentOnSideSoon(input, tries - 1), 150);
+}
+
+export function placeTabOnSideSoon(input: Parameters<typeof placeTabOnSide>[0], tries = 60): void {
+  if (placeTabOnSide(input) || tries <= 0) return;
+  setTimeout(() => placeTabOnSideSoon(input, tries - 1), 150);
+}
+
+// P17: Idli (lib/uiswitch.py, over DevTools) opens a terminal with ?open=terminal:<id> and then calls this to put it on
+// a side with focus. Agent tabs work the same way.
+function explainPlace(input: Parameters<typeof placeTabOnSide>[0]): string {
+  const store = useWorkspaceLayoutStore.getState();
+  const keys = Object.keys(store.layoutByWorkspace);
+  const key = input.workspaceId ? workspaceKeyFor(input.serverId, input.workspaceId) : null;
+  if (!key) return "no layout key; keys: " + keys.slice(0, 8).join(", ");
+  const layout = store.layoutByWorkspace[key];
+  if (!layout) return "no layout for " + key;
+  const tabs = collectAllTabs(layout.root).map(
+    (t) => t.target.kind + ":" + JSON.stringify(t.target).slice(0, 60),
+  );
+  return (
+    "key " +
+    key +
+    "; tabs " +
+    tabs.length +
+    ": " +
+    tabs
+      .filter((t) => !t.startsWith("browser"))
+      .slice(0, 12)
+      .join(" | ")
+  );
+}
+
+if (typeof window !== "undefined") {
+  (window as unknown as { __idliExplain?: unknown }).__idliExplain = explainPlace;
+  (window as unknown as { __idliPlaceTab?: unknown }).__idliPlaceTab = (
+    input: Parameters<typeof placeTabOnSide>[0],
+  ) => {
+    placeTabOnSideSoon(input);
+    return true;
+  };
+}

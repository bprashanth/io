@@ -0,0 +1,129 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Text, View } from "react-native";
+import { StyleSheet } from "react-native-unistyles";
+import { useFetchQuery } from "@/data/query";
+import { PressHighlight } from "@/components/ui/press-highlight";
+import { useHostRuntimeClient } from "@/runtime/host-runtime";
+import { useToast } from "@/contexts/toast-context";
+import {
+  IDLI_MINIS_URL,
+  IdliMinisSchema,
+  miniDate,
+  miniDisplayText,
+  miniMessage,
+  type IdliMini,
+} from "@/utils/idli-minis";
+
+export function IdliMiniCartridges({ serverId, agentId }: { serverId: string; agentId: string }) {
+  const client = useHostRuntimeClient(serverId);
+  const toast = useToast();
+  const sending = useRef(false);
+  const [selectedId, setSelectedId] = useState<string | null>(null);
+  const minis = useFetchQuery({
+    queryKey: ["idli-minis-public"],
+    queryFn: async ({ signal }) => {
+      const response = await fetch(IDLI_MINIS_URL, { signal, credentials: "omit" });
+      if (!response.ok) throw new Error("Could not load Minis");
+      return IdliMinisSchema.parse(await response.json());
+    },
+    staleTimeMs: 60_000,
+    dataShape: "list",
+  });
+  useEffect(() => {
+    if (minis.error) toast.error("Could not load Minis");
+  }, [minis.error, toast]);
+
+  const openMini = useCallback(
+    async (mini: IdliMini) => {
+      if (sending.current) return;
+      if (!client) {
+        toast.error("Host is disconnected");
+        return;
+      }
+      sending.current = true;
+      setSelectedId(mini.id);
+      try {
+        await client.sendAgentMessage(agentId, miniMessage(mini));
+        // Keep rows disabled until the timeline removes them after delivery.
+      } catch (error) {
+        sending.current = false;
+        setSelectedId(null);
+        toast.error(
+          error instanceof Error ? miniDisplayText(error.message) : "Could not open Mini",
+        );
+      }
+    },
+    [client, agentId, toast],
+  );
+
+  return (
+    <View style={styles.list} testID="idli-mini-cartridges">
+      {minis.data?.map((mini) => (
+        <MiniRow key={mini.id} mini={mini} selectedId={selectedId} onOpen={openMini} />
+      ))}
+    </View>
+  );
+}
+
+function MiniRow({
+  mini,
+  selectedId,
+  onOpen,
+}: {
+  mini: IdliMini;
+  selectedId: string | null;
+  onOpen: (mini: IdliMini) => Promise<void>;
+}) {
+  const onPress = useCallback(() => void onOpen(mini), [onOpen, mini]);
+  const accessibilityState = useMemo(
+    () => ({ disabled: selectedId !== null, busy: selectedId === mini.id }),
+    [selectedId, mini.id],
+  );
+  return (
+    <PressHighlight
+      accessibilityRole="button"
+      disabled={selectedId !== null}
+      accessibilityState={accessibilityState}
+      onPress={onPress}
+      style={[styles.row, selectedId === mini.id && styles.pending]}
+      highlightStyle={styles.highlight}
+    >
+      <Text style={styles.summary} numberOfLines={1}>
+        <Text style={styles.name}>{miniDisplayText(mini.name)}</Text>
+        {" - "}
+        {miniDisplayText(mini.heading)}
+      </Text>
+      <Text style={styles.metadata} numberOfLines={1}>
+        {[miniDate(mini.date), miniDisplayText(mini.author)].filter((part) => part.trim()).join(" - ")}
+      </Text>
+    </PressHighlight>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  list: { width: "100%", paddingVertical: theme.spacing[2], gap: theme.spacing[1] },
+  row: {
+    _web: { _hover: { borderColor: theme.colors.accent } },
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[3],
+    paddingHorizontal: theme.spacing[3],
+    paddingVertical: theme.spacing[2],
+    borderRadius: theme.borderRadius.md,
+    borderWidth: 1,
+    borderColor: theme.colors.border,
+    borderLeftWidth: 4,
+    borderLeftColor: theme.colors.accent,
+    backgroundColor: theme.colors.surface1,
+  },
+  highlight: { backgroundColor: theme.colors.surface1 },
+  pending: { opacity: 0.5 },
+  summary: { flex: 1, color: theme.colors.foreground, fontSize: theme.fontSize.sm },
+  name: { fontWeight: theme.fontWeight.bold },
+  metadata: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+    textAlign: "right",
+    flexShrink: 0,
+  },
+}));

new file mode 100644
index 00000000..fcd88257
--- /dev/null
+++ b/packages/app/src/components/idli-mini-cartridges.test.tsx
@@ -0,0 +1,109 @@
+/** @vitest-environment jsdom */
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ToastProvider } from "@/contexts/toast-context";
+import { IdliMiniCartridges } from "./idli-mini-cartridges";
+import { IDLI_MINIS_URL } from "@/utils/idli-minis";
+
+// Idli and the daemon run outside the app; keep this test at their API boundaries.
+const runtime = vi.hoisted(() => ({ sendAgentMessage: vi.fn() }));
+vi.mock("@/runtime/host-runtime", () => ({ useHostRuntimeClient: () => runtime }));
+// Toast content is real; jsdom cannot own Reanimated's browser animation observer.
+vi.mock("react-native-reanimated", async (importOriginal) => {
+  const original = await importOriginal<typeof import("react-native-reanimated")>();
+  const { View } = await import("react-native");
+  return { ...original, default: { ...original.default, View } };
+});
+const fetchMock = vi.fn<typeof fetch>();
+
+beforeEach(() => {
+  runtime.sendAgentMessage.mockReset();
+  fetchMock.mockReset();
+  fetchMock.mockResolvedValue(
+    new Response(
+      JSON.stringify([
+        {
+          id: "sales-14",
+          name: "Sales",
+          heading: "Revenue by region",
+          date: "2026-11-14",
+          author: "Asha",
+        },
+        {
+          id: "costs-14",
+          name: "Costs",
+          heading: "Spend by team",
+          date: "2026-11-14",
+          author: "Asha",
+        },
+      ]),
+    ),
+  );
+  vi.stubGlobal("fetch", fetchMock);
+});
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+function showMinis() {
+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  const view = render(
+    <QueryClientProvider client={queryClient}>
+      <ToastProvider>
+        <IdliMiniCartridges serverId="host" agentId="left-agent" />
+      </ToastProvider>
+    </QueryClientProvider>,
+  );
+  return view;
+}
+
+describe("Mini rows", () => {
+  it("fetches public Minis and sends one exact message while disabling repeat clicks", async () => {
+    runtime.sendAgentMessage.mockResolvedValue({});
+    showMinis();
+    const row = await screen.findByRole("button", {
+      name: /Sales - Revenue by region\s*14 Nov - Asha/,
+    });
+    expect(fetchMock).toHaveBeenCalledWith(
+      IDLI_MINIS_URL,
+      expect.objectContaining({ credentials: "omit" }),
+    );
+    fireEvent.click(row);
+    fireEvent.click(row);
+    await waitFor(() =>
+      expect(runtime.sendAgentMessage).toHaveBeenCalledExactlyOnceWith(
+        "left-agent",
+        "Open Mini: Sales [sales-14]",
+      ),
+    );
+    expect(row.getAttribute("aria-disabled")).toBe("true");
+    expect(
+      screen
+        .getByRole("button", { name: /Costs - Spend by team\s*14 Nov - Asha/ })
+        .getAttribute("aria-disabled"),
+    ).toBe("true");
+  });
+
+  it("shows a send failure and lets the person retry", async () => {
+    runtime.sendAgentMessage.mockRejectedValueOnce(new Error("Could not open Mini"));
+    runtime.sendAgentMessage.mockResolvedValueOnce({});
+    showMinis();
+    const row = await screen.findByRole("button", {
+      name: /Sales - Revenue by region\s*14 Nov - Asha/,
+    });
+    fireEvent.click(row);
+    await screen.findByText("Could not open Mini");
+    await waitFor(() => expect(row.getAttribute("aria-disabled")).not.toBe("true"));
+    fireEvent.click(row);
+    await waitFor(() => expect(runtime.sendAgentMessage).toHaveBeenCalledTimes(2));
+  });
+
+  it("shows a failed list fetch without inventing cartridge content", async () => {
+    fetchMock.mockResolvedValue(new Response("unavailable", { status: 503 }));
+    showMinis();
+    await screen.findByText("Could not load Minis");
+    expect(screen.queryByRole("button", { name: /Sales/ })).toBeNull();
+  });
+});

+import { describe, expect, test } from "vitest";
+import { browserDownloadDir, installBrowserDownloads, safeDownloadName, uniqueDownloadPath } from "./browser-downloads.js";
+
+describe("browser downloads", () => {
+  test("uses PASEO_BROWSER_DOWNLOAD_DIR, else the Downloads folder", () => {
+    expect(browserDownloadDir({ PASEO_BROWSER_DOWNLOAD_DIR: "/tmp/dl" }, "/home/u/Downloads")).toBe("/tmp/dl");
+    expect(browserDownloadDir({}, "/home/u/Downloads")).toBe("/home/u/Downloads");
+  });
+
+  test("keeps file names inside the folder", () => {
+    expect(safeDownloadName("../../etc/passwd")).toBe("passwd");
+    expect(safeDownloadName("a:b?.xlsx")).toBe("a_b_.xlsx");
+    expect(safeDownloadName("")).toBe("download");
+  });
+
+  test("never overwrites an existing file", () => {
+    const taken = new Set(["/d/report.xlsx", "/d/report (1).xlsx"]);
+    expect(uniqueDownloadPath("/d", "report.xlsx", (p) => taken.has(p))).toBe("/d/report (2).xlsx");
+  });
+
+  test("sets the save path so no dialog is shown", () => {
+    let listener: ((e: unknown, item: { getFilename(): string; setSavePath(p: string): void }) => void) | undefined;
+    installBrowserDownloads({ on: (_e, l) => { listener = l; } }, { env: { PASEO_BROWSER_DOWNLOAD_DIR: "/tmp/paseo-dl-test" }, downloadsPath: "/x" });
+    let saved = "";
+    listener?.({}, { getFilename: () => "sheet.xlsx", setSavePath: (p) => { saved = p; } });
+    expect(saved.startsWith("/tmp/paseo-dl-test/sheet")).toBe(true);
+  });
+});

index 00000000..1d8154ad
--- /dev/null
+++ b/packages/desktop/src/features/browser-downloads.ts
@@ -0,0 +1,57 @@
+import path from "node:path";
+import { existsSync, mkdirSync } from "node:fs";
+
+/**
+ * Downloads from Paseo's built-in browser go straight to a folder, without a Save dialog.
+ *
+ * Without a `will-download` handler Electron shows a native Save dialog. Its title is the download URL,
+ * it can open behind the app window, and an agent driving the browser can't answer it, so a download an
+ * agent starts (for example a spreadsheet export) never lands. With this handler the file is saved to
+ * PASEO_BROWSER_DOWNLOAD_DIR, or the user's Downloads folder, under a name that never overwrites an
+ * existing file.
+ */
+export interface BrowserDownloadItem {
+  getFilename(): string;
+  setSavePath(savePath: string): void;
+}
+
+export interface BrowserDownloadSession {
+  on(event: "will-download", listener: (event: unknown, item: BrowserDownloadItem) => void): unknown;
+}
+
+export function browserDownloadDir(env: NodeJS.ProcessEnv, downloadsPath: string): string {
+  const dir = env.PASEO_BROWSER_DOWNLOAD_DIR?.trim();
+  return dir ? path.resolve(dir) : downloadsPath;
+}
+
+export function safeDownloadName(name: string): string {
+  const base = path.basename(name || "").replace(/[\u0000-\u001f<>:"/\\|?*]+/g, "_").trim();
+  return base && base !== "." && base !== ".." ? base.slice(0, 200) : "download";
+}
+
+export function uniqueDownloadPath(dir: string, name: string, exists: (p: string) => boolean = existsSync): string {
+  const ext = path.extname(name);
+  const stem = name.slice(0, name.length - ext.length);
+  let candidate = path.join(dir, name);
+  for (let n = 1; exists(candidate); n++) {
+    candidate = path.join(dir, `${stem} (${n})${ext}`);
+  }
+  return candidate;
+}
+
+export function installBrowserDownloads(
+  profileSession: BrowserDownloadSession,
+  options: { env: NodeJS.ProcessEnv; downloadsPath: string; log?: (message: string) => void },
+): void {
+  profileSession.on("will-download", (_event, item) => {
+    const dir = browserDownloadDir(options.env, options.downloadsPath);
+    try {
+      mkdirSync(dir, { recursive: true });
+    } catch {
+      return; // fall back to Electron's own Save dialog
+    }
+    const target = uniqueDownloadPath(dir, safeDownloadName(item.getFilename()));
+    item.setSavePath(target);
+    options.log?.(`[browser-downloads] saving to ${target}`);
+  });
+}

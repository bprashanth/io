{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "127.0.0.1:6767",
        "localhost:6767"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.paseo",
        "~/.config/Paseo",
        "~/.mozilla",
        "~/.config/google-chrome",
        "~/.config/chromium",
        "~/idli-insights/cowork-real",
        "~/idli-insights/cowork-real-9b",
        "~/idli-insights/oss-test",
        "~/idli-insights/oss-test-paseo",
        "~/idli-insights/config/claude-or-9b",
        "~/Documents",
        "~/Downloads"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.paseo/**)",
      "Read(~/.config/Paseo/**)",
      "Read(~/.mozilla/**)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.config/chromium/**)",
      "Read(~/Documents/**)",
      "Read(~/Downloads/**)",
      "Read(~/idli-insights/cowork-*/**)",
      "Read(~/idli-insights/oss-test*/**)",
      "Read(~/idli-insights/config/claude-or-9b/**)"
    ]
  }
}

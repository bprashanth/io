# Environment for Claude Code against Muse (llama.cpp Anthropic Messages endpoint).
# The token is a placeholder: llama.cpp does not check it. No Anthropic login is used.
ANTHROPIC_BASE_URL=http://127.0.0.1:8181
ANTHROPIC_AUTH_TOKEN=unused
ANTHROPIC_MODEL=muse-glimmer-30b
ANTHROPIC_DEFAULT_HAIKU_MODEL=muse-glimmer-30b
ANTHROPIC_DEFAULT_SONNET_MODEL=muse-glimmer-30b
ANTHROPIC_DEFAULT_OPUS_MODEL=muse-glimmer-30b
CLAUDE_CODE_SUBAGENT_MODEL=muse-glimmer-30b
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
DISABLE_AUTOUPDATER=1

    },
    {
      "kind": "change",
      "metric": "completion_rate",
      "entity_column": "district",
      "entities": [
        "Gaya",
        "Nalanda",
        "Purnia",
        "Kishanganj"
      ],
      "time_column": "year",
      "from": 2022,
      "to": 2023,
      "unit": "percentage points"
    },
    {
      "kind": "change",
      "metric": "employment_rate",
      "entity_column": "district",
      "entities": [
        "Gaya",
        "Nalanda",
        "Purnia",
        "Kishanganj"
      ],
      "time_column": "year",
      "from": 2022,
      "to": 2023,
      "unit": "percentage points"
    }
  ],
  "view": {
    "title": "Women Training Completion and Employment by District and Year",
    "chart": "grouped_bar",
    "x": "year",
    "y": [
      "completion_rate",
      "employment_rate"
    ],
    "series": "district",
    "unit": "percent",
    "note": "Completion rate is the proportion of women who completed training out of those enrolled. Employment rate is the proportion of women employed at 6 months out of those enrolled."

{
  "schema_version": 1,
  "dataset_id": "dev-safe-programme-001",
  "question": "How do women training completion and employment rates vary by district and year, and what are the highest, lowest, and changes over time?",
  "steps": [
    {
      "op": "derive",
      "name": "completion_rate",
      "kind": "percent",
      "numerator": "completed_training",
      "denominator": "women_enrolled",
      "unit": "percent"
    },
    {
      "op": "derive",
      "name": "employment_rate",
      "kind": "percent",
      "numerator": "employed_at_6_months",
      "denominator": "women_enrolled",
      "unit": "percent"
    }
  ],
  "insights": [
    {
      "kind": "highest",
      "metric": "completion_rate",
      "label_column": "district"
    },
    {
      "kind": "lowest",
      "metric": "employment_rate",
      "label_column": "district"
    },
    {
      "kind": "change",
      "metric": "completion_rate",
      "entity_column": "district",
      "entities": [
        "Gaya",
        "Nalanda",
        "Purnia",
        "Kishanganj"
      ],
      "time_column": "year",
      "from": 2022,
      "to": 2023,
      "unit": "percentage points"
    },
    {
      "kind": "change",
      "metric": "employment_rate",
      "entity_column": "district",
      "entities": [
        "Gaya",
        "Nalanda",
        "Purnia",
        "Kishanganj"
      ],
      "time_column": "year",
      "from": 2022,
      "to": 2023,
      "unit": "percentage points"
    }
  ],
  "view": {
    "title": "Women Training Completion & Employment by District and Year",
    "chart": "grouped_bar",
    "x": "year",
    "y": [
      "completion_rate",
      "employment_rate"
    ],
    "series": "district",
    "unit": "percent",
    "note": "Rates are derived from counts of women enrolled, completed training, and employed at 6 months. The dataset is synthetic and cannot explain causal factors."
  },
  "interpretation_guard": {
    "can_explain_cause": false,
    "caveat": "The synthetic data cannot explain why rates differ."
  }
}

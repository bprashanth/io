      "name": "completion_rate",
      "kind": "percent",
      "numerator": "completed_training",
      "denominator": "women_enrolled",
      "unit": "percent"
    },
    {
      "op": "derive",
      "name": "employment_rate",
      "kind": "percent",
      "numerator": "employed_at_6_months",
      "denominator": "women_enrolled",
      "unit": "percent"
    },
    {
      "op": "filter",
      "column": "year",
      "cmp": "eq",
      "value": 2023
    },
    {
      "op": "filter",
      "column": "district",
      "cmp": "in",
      "value": [
        "Purnia",
        "Nalanda"
      ]
    }
  ],
  "insights": [

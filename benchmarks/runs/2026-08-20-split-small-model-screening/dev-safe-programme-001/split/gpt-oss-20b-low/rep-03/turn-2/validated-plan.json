      ],
      "time_column": "year",
      "time": "2023",
      "unit": "percentage points"
    },
    {
      "kind": "difference",
      "metric": "employment_rate",
      "entity_column": "district",
      "entities": [
        "Purnia",
        "Nalanda"
      ],
      "time_column": "year",
      "time": "2023",
      "unit": "percentage points"
    }
  ],
  "view": {

{
  "schema_version": 1,
  "dataset_id": "smoke-001",
  "question": "District immunisation coverage in 2023; identify lowest district without attributing cause; provide downloadable table",
  "steps": [
    {
      "op": "filter",
      "column": "year",
      "cmp": "eq",
      "value": 2023
    },
    {
      "op": "derive",
      "name": "coverage_percent",
      "kind": "percent",
      "numerator": "children_fully_immunised",
      "denominator": "children_due",
      "unit": "percent"
    }
  ],
  "insights": [
    {
      "kind": "lowest",
      "metric": "coverage_percent",
      "label_column": "district"
    }
  ],
  "view": {
    "title": "District Immunisation Coverage 2023",
    "chart": "line",
    "x": "district",
    "y": [
      "coverage_percent"
    ],
    "series": null,
    "unit": "percent",
    "note": "Showing 2023 only as requested."
  },
  "interpretation_guard": {
    "can_explain_cause": false,
    "caveat": "The data shows coverage levels but cannot explain why any district is lowest or why coverage differs between districts."
  }
}

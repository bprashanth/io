{
 "id": "tax_missing_info_fake",
 "title": "Tax missing information",
 "version": 1,
 "format": 2,
 "tabs": {
  "Capital Gain": {
   "headers": [
    "cost_of_acquisition",
    "currency",
    "date_of_purchase_dd_mmm_yy",
    "date_of_sale_dd_mmm_yy",
    "expenses_on_transfer",
    "net_sale_consideration_inr",
    "no_of_units",
    "particulars",
    "price_per_unit",
    "purchase_price_per_unit",
    "sale_consideration",
    "sl_no",
    "type_of_asset"
   ],
   "summary": "One row per sale of an asset: date of sale, price per unit, units, sale consideration, expenses, purchase date and cost of acquisition. A Total row sits at the bottom.",
   "row_noun": "sales",
   "skip_rows": [
    "repeated_header",
    "total"
   ],
   "check_totals": [
    "no_of_units",
    "sale_consideration",
    "expenses_on_transfer",
    "net_sale_consideration_inr",
    "cost_of_acquisition"
   ],
   "columns": {
    "sl_no": {
     "type": "number",
     "label": "Sl No"
    },
    "particulars": {
     "type": "text",
     "label": "Particulars"
    },
    "type_of_asset": {
     "type": "category",
     "label": "Type of asset"
    },
    "date_of_sale_dd_mmm_yy": {
     "type": "date",
     "formats": [
      "%d-%b-%y",
      "%d-%b-%Y",
      "%Y-%m-%d",
      "%Y-%m-%d %H:%M:%S"
     ],
     "label": "Date of sale"
    },
    "price_per_unit": {
     "type": "number",
     "label": "Price per unit"
    },
    "currency": {
     "type": "category",
     "label": "Currency"
    },
    "no_of_units": {
     "type": "number",
     "label": "No of units"
    },
    "sale_consideration": {
     "type": "number",
     "label": "Sale consideration"
    },
    "expenses_on_transfer": {
     "type": "number",
     "label": "Expenses on transfer"
    },
    "net_sale_consideration_inr": {
     "type": "number",
     "label": "Net sale consideration (INR)"
    },
    "date_of_purchase_dd_mmm_yy": {
     "type": "date",
     "formats": [
      "%d-%b-%y",
      "%d-%b-%Y",
      "%Y-%m-%d",
      "%Y-%m-%d %H:%M:%S"
     ],
     "label": "Date of purchase"
    },
    "purchase_price_per_unit": {
     "type": "number",
     "label": "Purchase price per unit"
    },
    "cost_of_acquisition": {
     "type": "number",
     "label": "Cost of acquisition"
    }
   },
   "normalize": {
    "type_of_asset": {
     "case": "title"
    },
    "currency": {
     "case": "title"
    }
   },
   "validations": [
    {
     "column": "date_of_sale_dd_mmm_yy",
     "rule": "required",
     "message": "sale date is missing"
    },
    {
     "column": "date_of_sale_dd_mmm_yy",
     "rule": "date",
     "arg": [
      "%d-%b-%y",
      "%d-%b-%Y",
      "%Y-%m-%d",
      "%Y-%m-%d %H:%M:%S"
     ],
     "message": "sale date is not a real date"
    },
    {
     "column": "date_of_sale_dd_mmm_yy",
     "rule": "not_future",
     "arg": [
      "%d-%b-%y",
      "%d-%b-%Y",
      "%Y-%m-%d",
      "%Y-%m-%d %H:%M:%S"
     ],
     "message": "sale date in the future"
    },
    {
     "column": "date_of_purchase_dd_mmm_yy",
     "rule": "required",
     "message": "purchase date is missing"
    },
    {
     "column": "date_of_purchase_dd_mmm_yy",
     "rule": "date",
     "arg": [
      "%d-%b-%y",
      "%d-%b-%Y",
      "%Y-%m-%d",
      "%Y-%m-%d %H:%M:%S"
     ],
     "message": "purchase date is not a real date"
    },
    {
     "column": "date_of_purchase_dd_mmm_yy",
     "rule": "not_future",
     "arg": [
      "%d-%b-%y",
      "%d-%b-%Y",
      "%Y-%m-%d",
      "%Y-%m-%d %H:%M:%S"
     ],
     "message": "purchase date in the future"
    },
    {
     "column": "price_per_unit",
     "rule": "required",
     "message": "price per unit is missing"
    },
    {
     "column": "price_per_unit",
     "rule": "number",
     "message": "price per unit is not a number"
    },
    {
     "column": "purchase_price_per_unit",
     "rule": "required",
     "message": "purchase price per unit is missing"
    },
    {
     "column": "purchase_price_per_unit",
     "rule": "number",
     "message": "purchase price per unit is not a number"
    },
    {
     "column": "no_of_units",
     "rule": "required",
     "message": "no of units is missing"
    },
    {
     "column": "no_of_units",
     "rule": "number",
     "message": "no of units is not a number"
    },
    {
     "column": "sale_consideration",
     "rule": "required",
     "message": "sale consideration is missing"
    },
    {
     "column": "sale_consideration",
     "rule": "number",
     "message": "sale consideration is not a number"
    },
    {
     "column": "expenses_on_transfer",
     "rule": "required",
     "message": "expenses on transfer is missing"
    },
    {
     "column": "expenses_on_transfer",
     "rule": "number",
     "message": "expenses on transfer is not a number"
    },
    {
     "column": "cost_of_acquisition",
     "rule": "required",
     "message": "cost of acquisition is missing"
    },
    {
     "column": "cost_of_acquisition",
     "rule": "number",
     "message": "cost of acquisition is not a number"
    },
    {
     "column": "sl_no",
     "rule": "number",
     "message": "Sl No is not a number"
    },
    {
     "column": "particulars",
     "rule": "required",
     "message": "particulars is missing"
    },
    {
     "column": "type_of_asset",
     "rule": "required",
     "message": "type of asset is missing"
    },
    {
     "column": "currency",
     "rule": "required",
     "message": "currency is missing"
    }
   ],
   "row_checks": [
    {
     "id": "purchase_after_sale",
     "column": "date_of_purchase_dd_mmm_yy",
     "sql": "t.date_of_purchase_dd_mmm_yy > t.date_of_sale_dd_mmm_yy",
     "message": "purchase date is after the sale date"
    },
    {
     "id": "net_sale",
     "column": "net_sale_consideration_inr",
     "sql": "t.net_sale_consideration_inr IS NOT NULL AND t.sale_consideration IS NOT NULL AND t.expenses_on_transfer IS NOT NULL AND abs(t.net_sale_consideration_inr - (t.sale_consideration - t.expenses_on_transfer)) > 1",
     "message": "net sale consideration is not sale consideration minus expenses"
    },
    {
     "id": "sale_amount",
     "column": "sale_consideration",
     "sql": "t.price_per_unit IS NOT NULL AND t.no_of_units IS NOT NULL AND t.sale_consideration IS NOT NULL AND abs(t.sale_consideration - t.price_per_unit * t.no_of_units) > 1",
     "message": "sale consideration is not price per unit x units"
    },
    {
     "id": "sl_no_repeats",
     "column": "sl_no",
     "sql": "t.sl_no IS NOT NULL AND (SELECT count(*) FROM {{tab:Capital Gain}} r WHERE r.sl_no = t.sl_no) > 1",
     "message": "Sl No appears more than once"
    }
   ],
   "measures": [
    {
     "id": "sale_total",
     "label": "Sale consideration",
     "sql": "sum(sale_consideration)",
     "format": "inr"
    },
    {
     "id": "net_sale_total",
     "label": "Net sale consideration (INR)",
     "sql": "sum(net_sale_consideration_inr)",
     "format": "inr"
    },
    {
     "id": "cost_total",
     "label": "Cost of acquisition (INR)",
     "sql": "sum(cost_of_acquisition)",
     "format": "inr"
    },
    {
     "id": "gain",
     "label": "Capital gain (INR)",
     "sql": "sum(net_sale_consideration_inr) - sum(cost_of_acquisition)",
     "format": "inr"
    },
    {
     "id": "units",
     "label": "Units sold",
     "sql": "sum(no_of_units)",
     "format": "count"
    }
   ],
   "date_columns": [
    "date_of_sale_dd_mmm_yy",
    "date_of_purchase_dd_mmm_yy"
   ]
  },
  "India Bank Account": {
   "headers": [
    "account_number_9_digits_or_more",
    "closing_balance_as_on_31_march_2024",
    "ifs_code",
    "name_of_the_bank",
    "refund_account_y_n",
    "savings_account_interest_earned",
    "type_of_account"
   ],
   "summary": "One row per bank account in India: IFS code, bank, account type, account number, savings interest earned, closing balance on 31 March 2024, and whether it is the refund account.",
   "row_noun": "accounts",
   "columns": {
    "ifs_code": {
     "type": "text",
     "label": "IFS code"
    },
    "name_of_the_bank": {
     "type": "category",
     "label": "Bank"
    },
    "type_of_account": {
     "type": "category",
     "label": "Type of account"
    },
    "account_number_9_digits_or_more": {
     "type": "text",
     "label": "Account number"
    },
    "savings_account_interest_earned": {
     "type": "number",
     "label": "Savings interest earned (Rs)"
    },
    "closing_balance_as_on_31_march_2024": {
     "type": "text",
     "label": "Closing balance on 31 March 2024 (Rs)"
    },
    "refund_account_y_n": {
     "type": "category",
     "label": "Refund account"
    }
   },
   "normalize": {},
   "validations": [
    {
     "column": "ifs_code",
     "rule": "required",
     "message": "IFS code is missing"
    },
    {
     "column": "ifs_code",
     "rule": "regex",
     "arg": "[A-Za-z]{4}0[A-Za-z0-9]{6}",
     "message": "IFS code is not 4 letters, 0, then 6 characters"
    },
    {
     "column": "account_number_9_digits_or_more",
     "rule": "required",
     "message": "account number is missing"
    },
    {
     "column": "account_number_9_digits_or_more",
     "rule": "regex",
     "arg": "\\d{9,}",
     "message": "account number is not 9 or more digits"
    },
    {
     "column": "closing_balance_as_on_31_march_2024",
     "rule": "required",
     "message": "closing balance is missing"
    },
    {
     "column": "closing_balance_as_on_31_march_2024",
     "rule": "number",
     "message": "closing balance is not a number"
    },
    {
     "column": "savings_account_interest_earned",
     "rule": "number",
     "message": "interest is not a number"
    },
    {
     "column": "refund_account_y_n",
     "rule": "required",
     "message": "refund account (Y/N) is missing"
    },
    {
     "column": "refund_account_y_n",
     "rule": "regex",
     "arg": "[YyNn]",
     "message": "refund account must be Y or N"
    }
   ],
   "row_checks": [
    {
     "id": "one_refund_account",
     "column": "refund_account_y_n",
     "sql": "(SELECT count(*) FROM {{tab:India Bank Account}} r WHERE upper(trim(r.refund_account_y_n)) = 'Y') <> 1 AND (upper(trim(t.refund_account_y_n)) = 'Y' OR (SELECT count(*) FROM {{tab:India Bank Account}} r WHERE upper(trim(r.refund_account_y_n)) = 'Y') = 0)",
     "message": "there should be exactly one refund account (Y)"
    }
   ],
   "measures": [
    {
     "id": "interest",
     "label": "Savings interest earned (Rs)",
     "sql": "sum(savings_account_interest_earned)",
     "format": "inr"
    }
   ],
   "presets": [
    {
     "id": "refund_account",
     "label": "Refund account only",
     "filters": {
      "refund_account_y_n": [
       "Y",
       "y"
      ]
     }
    }
   ]
  },
  "Travel Calendar": {
   "headers": [
    "month",
    "non_work_vacation_days_in_india",
    "work_days_in_india"
   ],
   "summary": "One row per month: non-work/vacation days and work days in India. A Total row sits at the bottom.",
   "row_noun": "months",
   "skip_rows": [
    "repeated_header",
    "total"
   ],
   "check_totals": [
    "non_work_vacation_days_in_india",
    "work_days_in_india"
   ],
   "columns": {
    "month": {
     "type": "date",
     "formats": [
      "%b %Y",
      "%B %Y",
      "%Y-%m-%d",
      "%Y-%m-%d %H:%M:%S"
     ],
     "label": "Month"
    },
    "non_work_vacation_days_in_india": {
     "type": "number",
     "label": "Non-work/vacation days in India"
    },
    "work_days_in_india": {
     "type": "number",
     "label": "Work days in India"
    }
   },
   "validations": [
    {
     "column": "month",
     "rule": "required",
     "message": "month is missing"
    },
    {
     "column": "month",
     "rule": "date",
     "arg": [
      "%b %Y",
      "%B %Y",
      "%Y-%m-%d",
      "%Y-%m-%d %H:%M:%S"
     ],
     "message": "month is not a real month (like Jul 2023)"
    },
    {
     "column": "non_work_vacation_days_in_india",
     "rule": "required",
     "message": "vacation days is missing"
    },
    {
     "column": "non_work_vacation_days_in_india",
     "rule": "number",
     "message": "vacation days is not a number"
    },
    {
     "column": "work_days_in_india",
     "rule": "required",
     "message": "work days is missing"
    },
    {
     "column": "work_days_in_india",
     "rule": "number",
     "message": "work days is not a number"
    }
   ],
   "row_checks": [
    {
     "id": "days_in_month",
     "column": "work_days_in_india",
     "sql": "COALESCE(t.non_work_vacation_days_in_india,0) + COALESCE(t.work_days_in_india,0) > 31",
     "message": "vacation + work days is more than 31, too many for one month",
     "value": "COALESCE(t.non_work_vacation_days_in_india,0) + COALESCE(t.work_days_in_india,0)"
    },
    {
     "id": "month_repeats",
     "column": "month",
     "sql": "t.month IS NOT NULL AND (SELECT count(*) FROM {{tab:Travel Calendar}} r WHERE r.month = t.month) > 1",
     "message": "this month appears more than once"
    }
   ],
   "measures": [
    {
     "id": "days_in_india",
     "label": "Days in India (work + non-work)",
     "sql": "COALESCE(sum(non_work_vacation_days_in_india),0) + COALESCE(sum(work_days_in_india),0)",
     "format": "count"
    },
    {
     "id": "vacation",
     "label": "Non-work/vacation days",
     "sql": "sum(non_work_vacation_days_in_india)",
     "format": "count"
    },
    {
     "id": "work",
     "label": "Work days",
     "sql": "sum(work_days_in_india)",
     "format": "count"
    }
   ],
   "date_columns": [
    "month"
   ]
  },
  "Missing Information": {
   "headers": [
    "aaaaa9999a",
    "column_3",
    "name",
    "pan",
    "person_a"
   ],
   "summary": "A question list: one row per Sl No with a topic, our understanding, your response and an amount (INR). Not a main analysis tab.",
   "row_noun": "questions",
   "columns": {
    "name": {
     "type": "number",
     "label": "Sl No"
    },
    "aaaaa9999a": {
     "type": "number",
     "label": "Amount (INR)"
    }
   },
   "validations": [
    {
     "column": "name",
     "rule": "number",
     "message": "Sl No is not a number"
    },
    {
     "column": "aaaaa9999a",
     "rule": "number",
     "message": "Amount (INR) is not a number"
    }
   ],
   "measures": [
    {
     "id": "amount",
     "label": "Amount (INR)",
     "sql": "sum(aaaaa9999a)",
     "format": "inr"
    }
   ]
  }
 },
 "history": [

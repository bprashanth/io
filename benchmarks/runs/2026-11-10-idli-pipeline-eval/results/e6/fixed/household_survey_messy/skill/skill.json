{
 "id": "household_survey_messy",
 "title": "Household survey",
 "version": 1,
 "format": 2,
 "tabs": {
  "Households": {
   "headers": [
    "household_id",
    "village",
    "ward",
    "head_of_household",
    "phone",
    "members",
    "monthly_income_inr",
    "debts_inr",
    "savings_inr",
    "land_acres",
    "survey_date"
   ],
   "summary": "One row per household surveyed: village, ward, members, monthly income, debts, savings (rupees), land and survey date.",
   "row_noun": "households",
   "row_numbers": true,
   "columns": {
    "household_id": {
     "type": "text",
     "label": "Household ID"
    },
    "village": {
     "type": "category",
     "label": "Village"
    },
    "ward": {
     "type": "category",
     "label": "Ward"
    },
    "head_of_household": {
     "type": "text",
     "label": "Head of household"
    },
    "phone": {
     "type": "text",
     "label": "Phone"
    },
    "members": {
     "type": "number",
     "label": "Members"
    },
    "monthly_income_inr": {
     "type": "number",
     "label": "Monthly income (Rs)"
    },
    "debts_inr": {
     "type": "number",
     "label": "Debts (Rs)"
    },
    "savings_inr": {
     "type": "number",
     "label": "Savings (Rs)"
    },
    "land_acres": {
     "type": "number",
     "label": "Land (acres)"
    },
    "survey_date": {
     "type": "date",
     "formats": [
      "%d/%m/%Y"
     ],
     "label": "Survey date"
    }
   },
   "normalize": {
    "village": {
     "case": "title"
    },
    "members": {
     "type": "number"
    },
    "monthly_income_inr": {
     "type": "number"
    },
    "debts_inr": {
     "type": "number"
    },
    "savings_inr": {
     "type": "number"
    },
    "land_acres": {
     "type": "number"
    },
    "ward": {
     "type": "number"
    }
   },
   "validations": [
    {
     "column": "phone",
     "rule": "regex",
     "arg": "(?:[ -]*\\d){10}[ -]*",
     "message": "phone is not exactly 10 digits"
    },
    {
     "column": "survey_date",
     "rule": "date",
     "arg": [
      "%d/%m/%Y"
     ],
     "message": "survey date is not a valid dd/mm/yyyy date"
    },
    {
     "column": "household_id",
     "rule": "required",
     "message": "Household ID is missing"
    },
    {
     "column": "monthly_income_inr",
     "rule": "number",
     "message": "income is not a number"
    },
    {
     "column": "debts_inr",
     "rule": "number",
     "message": "debts is not a number"
    }
   ],
   "row_checks": [
    {
     "id": "duplicate_household_id",
     "column": "household_id",
     "message": "Household ID appears on more than one row (case counts)",
     "sql": "(SELECT count(*) FROM {{tab:Households}} r WHERE r.household_id = t.household_id) > 1",
     "why": "Each household needs its own ID; correct or remove the duplicate."
    },
    {
     "id": "members_count",
     "column": "members",
     "message": "Members count does not match the number of rows for this household in the Members tab",
     "sql": "t.members IS NULL OR t.members <> (SELECT count(*) FROM {{tab:Members}} r WHERE r.household_id = t.household_id)",
     "why": "Compare with the Members tab and correct whichever is wrong."
    },
    {
     "id": "survey_after_cutoff",
     "column": "survey_date",
     "message": "survey date is after 31/03/2024",
     "sql": "t.survey_date > DATE '2024-03-31'",
     "why": "Surveys should be dated on or before 31 March 2024."
    }
   ],
   "measures": [
    {
     "id": "debt_to_income",
     "label": "Debt-to-income ratio",
     "sql": "sum(debts_inr) / nullif(sum(monthly_income_inr), 0)",
     "format": "ratio"
    },
    {
     "id": "in_debt",
     "label": "Households in debt",
     "sql": "count(*) FILTER (WHERE debts_inr > 0)",
     "format": "count"
    },
    {
     "id": "debt_above_savings",
     "label": "Households with debt above savings",
     "sql": "count(*) FILTER (WHERE debts_inr > savings_inr)",
     "format": "count"
    },
    {
     "id": "income_per_member",
     "label": "Income per member (Rs/month)",
     "sql": "sum(monthly_income_inr) / nullif(sum(members), 0)",
     "format": "inr"
    },
    {
     "id": "debt",
     "label": "Total debt (Rs)",
     "sql": "sum(debts_inr)",
     "format": "inr"
    },
    {
     "id": "savings",
     "label": "Total savings (Rs)",
     "sql": "sum(savings_inr)",
     "format": "inr"
    },
    {
     "id": "income",
     "label": "Total monthly income (Rs)",
     "sql": "sum(monthly_income_inr)",
     "format": "inr"
    }
   ],
   "group_by": [
    {
     "id": "debt_position",
     "label": "Debt position",
     "sql": "CASE WHEN debts_inr > savings_inr THEN 'Debt above savings' WHEN debts_inr IS NULL OR savings_inr IS NULL THEN 'Unknown' ELSE 'Savings cover debt' END"
    }
   ],
   "presets": [],
   "date_columns": [
    "survey_date"
   ]
  },
  "Members": {
   "headers": [
    "household_id",
    "name",
    "age",
    "sex",
    "works_y_n"
   ],
   "summary": "One row per person in a surveyed household, with the household's village, income, debts and savings joined in.",
   "row_noun": "people",
   "row_numbers": true,
   "columns": {
    "household_id": {
     "type": "text",
     "label": "Household ID"
    },
    "name": {
     "type": "text",
     "label": "Name"
    },
    "age": {
     "type": "number",
     "label": "Age"
    },
    "sex": {
     "type": "category",
     "label": "Sex"
    },
    "works_y_n": {
     "type": "category",
     "label": "Works (Y/N)"
    }
   },
   "normalize": {
    "age": {
     "type": "number"
    }
   },
   "validations": [
    {
     "column": "age",
     "rule": "range",
     "arg": [
      0,
      110
     ],
     "message": "age is not between 0 and 110"
    },
    {
     "column": "sex",
     "rule": "in_list",
     "arg": [
      "M",
      "F",
      "Male",
      "Female"
     ],
     "message": "sex is not an allowed value"
    },
    {
     "column": "works_y_n",
     "rule": "in_list",
     "arg": [
      "Y",
      "N",
      "Yes",
      "No"
     ],
     "message": "Works is not Y or N"
    }
   ],
   "row_checks": [
    {
     "id": "household_id_case",
     "column": "household_id",
     "message": "Household ID matches a household only if upper/lower case is ignored",
     "sql": "EXISTS (SELECT 1 FROM {{tab:Households}} r WHERE lower(r.household_id) = lower(t.household_id)) AND NOT EXISTS (SELECT 1 FROM {{tab:Households}} r WHERE r.household_id = t.household_id)",
     "why": "IDs must match exactly as written."
    }
   ],
   "lookups": [
    {
     "tab": "Households",
     "on": {
      "household_id": "household_id"
     },
     "columns": [
      "village",
      "ward",
      "members",
      "monthly_income_inr",
      "debts_inr",
      "savings_inr"
     ],
     "prefix": "hh_",
     "labels": {
      "village": "Household village",
      "ward": "Household ward"
     }
    }
   ],
   "measures": [
    {
     "id": "people",
     "label": "People",
     "sql": "count(*)",
     "format": "count"
    },
    {
     "id": "working",
     "label": "People who work",
     "sql": "count(*) FILTER (WHERE upper(works_y_n) IN ('Y','YES'))",
     "format": "count"
    },
    {
     "id": "dependants",
     "label": "Dependants (under 15 or over 60)",
     "sql": "count(*) FILTER (WHERE age < 15 OR age > 60)",
     "format": "count"
    },
    {
     "id": "households_listed",
     "label": "Households with people listed",
     "sql": "count(DISTINCT household_id)",
     "format": "count"
    }
   ],
   "group_by": [
    {
     "id": "age_band",
     "label": "Age band",
     "sql": "CASE WHEN age < 15 THEN 'Under 15' WHEN age <= 60 THEN '15-60' WHEN age > 60 THEN 'Over 60' END"
    }
   ]
  }
 },
 "questions": [
  {
   "id": "vulnerable_by_village",
   "ask": "Vulnerable households (debt above savings and income per member in the lowest third) by village",
   "tab": "Households",
   "params": {},
   "sql": "WITH h AS (SELECT village, debts_inr, savings_inr, monthly_income_inr / nullif(members, 0) AS ipm FROM {{table}} WHERE members > 0 AND monthly_income_inr IS NOT NULL), c AS (SELECT quantile_cont(ipm, 1.0/3) AS cut FROM h) SELECT village, count(*) AS households, count(*) FILTER (WHERE debts_inr > savings_inr AND ipm <= (SELECT cut FROM c)) AS vulnerable_households FROM h GROUP BY village ORDER BY vulnerable_households DESC, village"
  }
 ],
 "history": [
  {
   "version": 1,
   "taught": "checks (unique IDs, member counts, phones, dates by 31/03/2024, ages 0-110), debt vs income/savings, vulnerability, Members linked to Households"
  }
 ]
}
{
 "id": "tax_missing_info_fake",
 "title": "Tax return information (missing info, bank, capital gain, travel)",
 "version": 1,
 "format": 2,
 "tabs": {
  "Missing Information": {
   "headers": [
    "aaaaa9999a",
    "column_3",
    "name",
    "pan",
    "person_a"
   ],
   "summary": "One row per item of missing information about a person, with a PAN and an amount.",
   "row_noun": "items",
   "columns": {
    "aaaaa9999a": {
     "type": "number",
     "label": "Amount"
    },
    "name": {
     "type": "category",
     "label": "Name"
    },
    "pan": {
     "type": "category",
     "label": "PAN"
    }
   },
   "validations": [
    {
     "column": "pan",
     "rule": "regex",
     "arg": "(?i)[A-Z]{5}[0-9]{4}[A-Z]",
     "message": "PAN should be 5 letters, 4 digits, 1 letter"
    },
    {
     "column": "aaaaa9999a",
     "rule": "number",
     "message": "amount is not a number"
    }
   ],
   "measures": [
    {
     "id": "amount",
     "label": "Amount",
     "sql": "sum(aaaaa9999a)",
     "format": "inr"
    }
   ]
  },
  "India Bank Account": {
   "headers": [
    "account_number_9_digits_or_more",
    "closing_balance_as_on_31_march_2024",
    "ifs_code",
    "name_of_the_bank",
    "refund_account_y_n",
    "savings_account_interest_earned",
    "type_of_account"
   ],
   "summary": "One row per bank account in India.",
   "row_noun": "accounts",
   "columns": {
    "account_number_9_digits_or_more": {
     "type": "text",
     "label": "Account number"
    },
    "savings_account_interest_earned": {
     "type": "number",
     "label": "Savings interest earned (Rs)"
    },
    "closing_balance_as_on_31_march_2024": {
     "type": "category",
     "label": "Closing balance on 31 March 2024"
    },
    "refund_account_y_n": {
     "label": "Refund account"
    }
   },
   "validations": [
    {
     "column": "ifs_code",
     "rule": "regex",
     "arg": "(?i)[A-Z]{4}0[A-Z0-9]{6}",
     "message": "IFS code should be 4 letters, a 0, then 6 letters or digits"
    },
    {
     "column": "account_number_9_digits_or_more",
     "rule": "regex",
     "arg": "[0-9]{9,}",
     "message": "account number should be digits only, 9 or more"
    },
    {
     "column": "savings_account_interest_earned",
     "rule": "number",
     "message": "interest is not a number"
    },
    {
     "column": "closing_balance_as_on_31_march_2024",
     "rule": "number",
     "message": "closing balance is not a number"
    },
    {
     "column": "refund_account_y_n",
     "rule": "in_list",
     "arg": [
      "Y",
      "N"
     ],
     "message": "refund account should be Y or N"
    }
   ],
   "row_checks": [
    {
     "id": "one_refund_account",
     "column": "refund_account_y_n",
     "sql": "upper(trim(t.refund_account_y_n)) = 'Y' AND (SELECT count(*) FROM {{tab:India Bank Account}} r WHERE upper(trim(r.refund_account_y_n)) = 'Y') > 1",
     "message": "more than one account is marked as the refund account"
    }
   ],
   "measures": [
    {
     "id": "interest",
     "label": "Savings interest earned (Rs)",
     "sql": "sum(savings_account_interest_earned)",
     "format": "inr"
    },
    {
     "id": "balance",
     "label": "Closing balance (Rs)",
     "sql": "sum(TRY_CAST(regexp_replace(closing_balance_as_on_31_march_2024, '(?i)(rs\\.?|inr|₹|,|\\s)', '', 'g') AS DOUBLE))",
     "format": "inr"
    },
    {
     "id": "accounts",
     "label": "Accounts",
     "sql": "count(*)",
     "format": "count"
    }
   ]
  },
  "Capital Gain": {
   "headers": [
    "cost_of_acquisition",
    "currency",
    "date_of_purchase_dd_mmm_yy",
    "date_of_sale_dd_mmm_yy",
    "expenses_on_transfer",
    "net_sale_consideration_inr",
    "no_of_units",
    "particulars",
    "price_per_unit",
    "purchase_price_per_unit",
    "sale_consideration",
    "sl_no",
    "type_of_asset"
   ],
   "summary": "One row per sale of a holding. The Total row is left out.",
   "row_noun": "sales",
   "skip_rows": [
    "repeated_header",
    "total"
   ],
   "columns": {
    "date_of_sale_dd_mmm_yy": {
     "type": "date",
     "formats": [
      "%d-%b-%y"
     ],
     "label": "Date of sale"
    },
    "date_of_purchase_dd_mmm_yy": {
     "type": "date",
     "formats": [
      "%d-%b-%y"
     ],
     "label": "Date of purchase"
    },
    "price_per_unit": {
     "type": "number",
     "label": "Price per unit"
    },
    "no_of_units": {
     "type": "number",
     "label": "No of units"
    },
    "sale_consideration": {
     "type": "number",
     "label": "Sale consideration"
    },
    "expenses_on_transfer": {
     "type": "number",
     "label": "Expenses on transfer"
    },
    "net_sale_consideration_inr": {
     "type": "number",
     "label": "Net sale consideration (Rs)"
    },
    "purchase_price_per_unit": {
     "type": "number",
     "label": "Purchase price per unit"
    },
    "cost_of_acquisition": {
     "type": "number",
     "label": "Cost of acquisition (Rs)"
    }
   },
   "validations": [
    {
     "column": "particulars",
     "rule": "required",
     "message": "particulars is blank"
    },
    {
     "column": "type_of_asset",
     "rule": "required",
     "message": "type of asset is blank"
    },
    {
     "column": "currency",
     "rule": "required",
     "message": "currency is blank"
    },
    {
     "column": "date_of_sale_dd_mmm_yy",
     "rule": "required",
     "message": "date of sale is blank"
    },
    {
     "column": "date_of_sale_dd_mmm_yy",
     "rule": "date",
     "arg": [
      "%d-%b-%y"
     ],
     "message": "date of sale is not dd-mmm-yy"
    },
    {
     "column": "date_of_sale_dd_mmm_yy",
     "rule": "not_future",
     "arg": [
      "%d-%b-%y"
     ],
     "message": "date of sale is in the future"
    },
    {
     "column": "date_of_purchase_dd_mmm_yy",
     "rule": "required",
     "message": "date of purchase is blank"
    },
    {
     "column": "date_of_purchase_dd_mmm_yy",
     "rule": "date",
     "arg": [
      "%d-%b-%y"
     ],
     "message": "date of purchase is not dd-mmm-yy"
    },
    {
     "column": "date_of_purchase_dd_mmm_yy",
     "rule": "not_future",
     "arg": [
      "%d-%b-%y"
     ],
     "message": "date of purchase is in the future"
    },
    {
     "column": "sl_no",
     "rule": "number",
     "message": "serial number is not a number"
    },
    {
     "column": "price_per_unit",
     "rule": "number",
     "message": "price per unit is not a number"
    },
    {
     "column": "no_of_units",
     "rule": "number",
     "message": "number of units is not a number"
    },
    {
     "column": "sale_consideration",
     "rule": "number",
     "message": "sale consideration is not a number"
    },
    {
     "column": "expenses_on_transfer",
     "rule": "number",
     "message": "expenses is not a number"
    },
    {
     "column": "net_sale_consideration_inr",
     "rule": "number",
     "message": "net sale consideration is not a number"
    },
    {
     "column": "purchase_price_per_unit",
     "rule": "number",
     "message": "purchase price per unit is not a number"
    },
    {
     "column": "cost_of_acquisition",
     "rule": "number",
     "message": "cost of acquisition is not a number"
    }
   ],
   "row_checks": [
    {
     "id": "net_sale",
     "column": "net_sale_consideration_inr",
     "sql": "abs(t.net_sale_consideration_inr - (t.sale_consideration - t.expenses_on_transfer)) > 1",
     "message": "net sale consideration is not sale consideration minus expenses on transfer (more than Rs 1 apart)"
    },
    {
     "id": "units_x_price",
     "column": "sale_consideration",
     "sql": "abs(t.sale_consideration - t.no_of_units * t.price_per_unit) > 1",
     "message": "sale consideration is not no of units x price per unit (more than 1 apart)"
    },
    {
     "id": "cost",
     "column": "cost_of_acquisition",
     "sql": "abs(t.cost_of_acquisition - t.no_of_units * t.purchase_price_per_unit) > 1",
     "message": "cost of acquisition is not no of units x purchase price per unit (more than Rs 1 apart)"
    }
   ],
   "measures": [
    {
     "id": "sale",
     "label": "Sale consideration",
     "sql": "sum(sale_consideration)",
     "format": "inr"
    },
    {
     "id": "expenses",
     "label": "Expenses on transfer",
     "sql": "sum(expenses_on_transfer)",
     "format": "inr"
    },
    {
     "id": "net_sale",
     "label": "Net sale consideration (Rs)",
     "sql": "sum(net_sale_consideration_inr)",
     "format": "inr"
    },
    {
     "id": "cost",
     "label": "Cost of acquisition (Rs)",
     "sql": "sum(cost_of_acquisition)",
     "format": "inr"
    },
    {
     "id": "gain",
     "label": "Capital gain (net sale minus cost, Rs)",
     "sql": "sum(net_sale_consideration_inr) - sum(cost_of_acquisition)",
     "format": "inr"
    },
    {
     "id": "units",
     "label": "Units sold",
     "sql": "sum(no_of_units)",
     "format": "count"
    }
   ],
   "group_by": [
    {
     "id": "fy_of_sale",
     "label": "Financial year of sale (Apr-Mar)",
     "sql": "CASE WHEN date_of_sale_dd_mmm_yy IS NULL THEN NULL WHEN month(date_of_sale_dd_mmm_yy) >= 4 THEN 'FY ' || year(date_of_sale_dd_mmm_yy) || '-' || ((year(date_of_sale_dd_mmm_yy) + 1) % 100) ELSE 'FY ' || (year(date_of_sale_dd_mmm_yy) - 1) || '-' || (year(date_of_sale_dd_mmm_yy) % 100) END"
    }
   ],
   "date_columns": [
    "date_of_sale_dd_mmm_yy",
    "date_of_purchase_dd_mmm_yy"
   ]
  },
  "Travel Calendar": {
   "headers": [
    "month",
    "non_work_vacation_days_in_india",
    "work_days_in_india"
   ],
   "summary": "One row per month: work days and vacation days spent in India. The Total row is left out.",
   "row_noun": "months",
   "skip_rows": [
    "repeated_header",
    "total"
   ],
   "columns": {
    "month": {
     "type": "date",
     "formats": [
      "%b %Y"
     ],
     "label": "Month"
    },
    "non_work_vacation_days_in_india": {
     "type": "category",
     "label": "Non-work/vacation days in India"
    },
    "work_days_in_india": {
     "type": "number",
     "label": "Work days in India"
    }
   },
   "validations": [
    {
     "column": "month",
     "rule": "date",
     "arg": [
      "%b %Y"
     ],
     "message": "month is not like 'Jun 2023'"
    },
    {
     "column": "non_work_vacation_days_in_india",
     "rule": "number",
     "message": "vacation days is not a number"
    },
    {
     "column": "work_days_in_india",
     "rule": "number",
     "message": "work days is not a number"
    },
    {
     "column": "non_work_vacation_days_in_india",
     "rule": "range",
     "arg": [
      0,
      31
     ],
     "message": "vacation days should be 0 to 31"
    },
    {
     "column": "work_days_in_india",
     "rule": "range",
     "arg": [
      0,
      31
     ],
     "message": "work days should be 0 to 31"
    }
   ],
   "row_checks": [
    {
     "id": "days_in_month",
     "column": "work_days_in_india",
     "sql": "t.work_days_in_india + TRY_CAST(t.non_work_vacation_days_in_india AS DOUBLE) > date_diff('day', t.month, t.month + INTERVAL 1 MONTH)",
     "message": "work days plus vacation days is more than the days in the month"
    },
    {
     "id": "duplicate_month",
     "column": "month",
     "sql": "t.month IS NOT NULL AND (SELECT count(*) FROM {{tab:Travel Calendar}} r WHERE r.month = t.month) > 1",
     "message": "this month is listed more than once"
    }
   ],
   "measures": [
    {
     "id": "work_days",
     "label": "Work days in India",
     "sql": "sum(work_days_in_india)",
     "format": "count"
    },
    {
     "id": "vacation_days",
     "label": "Non-work/vacation days in India",
     "sql": "sum(TRY_CAST(non_work_vacation_days_in_india AS DOUBLE))",
     "format": "count"
    }
   ],
   "date_columns": [
    "month"
   ]
  }
 },
 "history": [
  {
   "version": 1,
   "taught": "checks for PAN, bank IFS/account, capital gain arithmetic, travel day counts; capital gain totals and gain by financial year"
  }
 ]
}
{
 "id": "tree_plots_transects",
 "title": "Tree plots and transects",
 "version": 1,
 "format": 2,
 "tabs": {
  "Raw 10x10m Data": {
   "headers": [
    "transect",
    "plot",
    "tree_no",
    "species_code",
    "dbh_1_cm",
    "dbh_2_cm",
    "dbh_3_cm",
    "height_m",
    "canopy_y_n",
    "notes",
    "date_dd_mm_yyyy",
    "recorder"
   ],
   "summary": "One row per tree measured in a 10x10m plot on a transect: species, up to three DBH readings (cm), height (m), canopy Y/N, date and recorder. Rows that repeat the headings or hold just a transect label are skipped.",
   "row_noun": "trees",
   "skip_rows": [
    "repeated_header",
    "subheading",
    "total"
   ],
   "columns": {
    "transect": {
     "type": "category",
     "label": "Transect"
    },
    "plot": {
     "type": "number",
     "label": "Plot"
    },
    "tree_no": {
     "type": "number",
     "label": "Tree no."
    },
    "species_code": {
     "type": "category",
     "label": "Species code"
    },
    "dbh_1_cm": {
     "type": "number",
     "label": "DBH 1 (cm)"
    },
    "dbh_2_cm": {
     "type": "number",
     "label": "DBH 2 (cm)"
    },
    "dbh_3_cm": {
     "type": "number",
     "label": "DBH 3 (cm)"
    },
    "height_m": {
     "type": "number",
     "label": "Height (m)"
    },
    "canopy_y_n": {
     "type": "category",
     "label": "Canopy (Y/N)"
    },
    "notes": {
     "type": "text",
     "label": "Notes"
    },
    "date_dd_mm_yyyy": {
     "type": "date",
     "formats": [
      "%d/%m/%Y",
      "%Y-%m-%d"
     ],
     "label": "Date"
    },
    "recorder": {
     "type": "category",
     "label": "Recorder"
    }
   },
   "normalize": {
    "species_code": {
     "case": "lower"
    },
    "canopy_y_n": {
     "case": "upper"
    },
    "transect": {
     "case": "title"
    },
    "recorder": {
     "case": "title"
    }
   },
   "validations": [
    {
     "column": "plot",
     "rule": "number",
     "message": "plot is not a number"
    },
    {
     "column": "plot",
     "rule": "range",
     "arg": [
      1,
      5
     ],
     "message": "plot outside 1-5"
    },
    {
     "column": "plot",
     "rule": "required",
     "message": "plot is blank"
    },
    {
     "column": "tree_no",
     "rule": "number",
     "message": "tree number is not a number"
    },
    {
     "column": "tree_no",
     "rule": "required",
     "message": "tree number is blank"
    },
    {
     "column": "species_code",
     "rule": "required",
     "message": "species code is blank"
    },
    {
     "column": "dbh_1_cm",
     "rule": "number",
     "message": "DBH 1 is not a number"
    },
    {
     "column": "dbh_1_cm",
     "rule": "range",
     "arg": [
      1,
      300
     ],
     "message": "DBH 1 outside 1-300 cm"
    },
    {
     "column": "dbh_1_cm",
     "rule": "required",
     "message": "DBH 1 is blank"
    },
    {
     "column": "dbh_2_cm",
     "rule": "number",
     "message": "DBH 2 is not a number"
    },
    {
     "column": "dbh_2_cm",
     "rule": "range",
     "arg": [
      1,
      300
     ],
     "message": "DBH 2 outside 1-300 cm"
    },
    {
     "column": "height_m",
     "rule": "number",
     "message": "height is not a number"
    },
    {
     "column": "height_m",
     "rule": "range",
     "arg": [
      0.5,
      60
     ],
     "message": "height outside 0.5-60 m"
    },
    {
     "column": "height_m",
     "rule": "required",
     "message": "height is blank"
    },
    {
     "column": "canopy_y_n",
     "rule": "in_list",
     "arg": [
      "Y",
      "N"
     ],
     "message": "canopy is not Y or N"
    },
    {
     "column": "canopy_y_n",
     "rule": "required",
     "message": "canopy is blank"
    },
    {
     "column": "date_dd_mm_yyyy",
     "rule": "date",
     "arg": [
      "%d/%m/%Y",
      "%Y-%m-%d"
     ],
     "message": "date is not a valid date"
    },
    {
     "column": "date_dd_mm_yyyy",
     "rule": "regex",
     "arg": "(\\d\\d/\\d\\d/(19\\d\\d|20[01]\\d|202[0-3])|\\d\\d/0[1-3]/2024|(19\\d\\d|20[01]\\d|202[0-3])-\\d\\d-\\d\\d|2024-0[1-3]-\\d\\d)",
     "message": "date is after 31 Mar 2024"
    },
    {
     "column": "date_dd_mm_yyyy",
     "rule": "required",
     "message": "date is blank"
    },
    {
     "column": "recorder",
     "rule": "required",
     "message": "recorder is blank"
    }
   ],
   "date_columns": [
    "date_dd_mm_yyyy"
   ],
   "lookups": [
    {
     "tab": "Species key",
     "on": {
      "species_code": "code"
     },
     "columns": [
      "common_name"
     ],
     "prefix": "species_",
     "labels": {
      "common_name": "Common name"
     }
    }
   ],
   "measures": [
    {
     "id": "trees",
     "label": "Trees",
     "sql": "count(*)",
     "format": "count"
    },
    {
     "id": "avg_height",
     "label": "Average height (m)",
     "sql": "avg(height_m)",
     "format": "number"
    }
   ]
  },
  "Density": {
   "headers": [
    "transect",
    "plot",
    "no_of_trees",
    "no_of_cestrum"
   ],
   "summary": "One row per plot on a transect: number of trees and number of Cestrum.",
   "row_noun": "plots",
   "columns": {
    "transect": {
     "type": "category",
     "label": "Transect"
    },
    "plot": {
     "type": "number",
     "label": "Plot"
    },
    "no_of_trees": {
     "type": "number",
     "label": "No. of trees"
    },
    "no_of_cestrum": {
     "type": "number",
     "label": "No. of Cestrum"
    }
   },
   "normalize": {
    "transect": {
     "case": "title"
    }
   },
   "validations": [
    {
     "column": "no_of_trees",
     "rule": "number",
     "message": "not a number"
    },
    {
     "column": "no_of_cestrum",
     "rule": "number",
     "message": "not a number"
    }
   ],
   "measures": [
    {
     "id": "trees",
     "label": "Trees",
     "sql": "sum(no_of_trees)",
     "format": "count"
    },
    {
     "id": "cestrum",
     "label": "Cestrum trees",
     "sql": "sum(no_of_cestrum)",
     "format": "count"
    },
    {
     "id": "cestrum_share",
     "label": "Cestrum share (%)",
     "sql": "100.0 * sum(no_of_cestrum) / nullif(sum(no_of_trees), 0)",
     "format": "number"
    },
    {
     "id": "plots",
     "label": "Plots counted",
     "sql": "count(*)",
     "format": "count"
    }
   ]
  },
  "Seedlings": {
   "headers": [
    "transect",
    "plot",
    "species_code",
    "count",
    "height_class"
   ],
   "summary": "One row per species and height class of seedlings counted in a plot.",
   "row_noun": "seedling records",
   "columns": {
    "transect": {
     "type": "category",
     "label": "Transect"
    },
    "plot": {
     "type": "number",
     "label": "Plot"
    },
    "species_code": {
     "type": "category",
     "label": "Species code"
    },
    "count": {
     "type": "number",
     "label": "Count"
    },
    "height_class": {
     "type": "category",
     "label": "Height class"
    }
   },
   "normalize": {
    "species_code": {
     "case": "lower"
    },
    "transect": {
     "case": "title"
    }
   },
   "validations": [
    {
     "column": "count",
     "rule": "number",
     "message": "count is not a number"
    }
   ],
   "lookups": [
    {
     "tab": "Species key",
     "on": {
      "species_code": "code"
     },
     "columns": [
      "common_name"
     ],
     "prefix": "species_",
     "labels": {
      "common_name": "Common name"
     }
    }
   ],
   "measures": [
    {
     "id": "seedlings",
     "label": "Seedlings",
     "sql": "sum(count)",
     "format": "count"
    },
    {
     "id": "records",
     "label": "Seedling records",
     "sql": "count(*)",
     "format": "count"
    },
    {
     "id": "avg_per_record",
     "label": "Average seedlings per record",
     "sql": "avg(count)",
     "format": "number"
    }
   ]
  },
  "Species key": {
   "headers": [
    "code",
    "scientific_name",
    "common_name",
    "native_alien"
   ],
   "row_noun": "species"
  }
 },
 "history": [
  {
   "version": 1,
   "taught": "validity checks on tree data, Density and Seedlings measures"
  }
 ]
}
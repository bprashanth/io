{
 "id": "germination_protocol_filled",
 "title": "Germination protocol",
 "version": 1,
 "format": 2,
 "tabs": {
  "Germination": {
   "headers": [
    "container",
    "container_germination",
    "duration_until_germination",
    "germination_facilities_nursery_care",
    "germination_success",
    "growing_media",
    "local_common_name_s",
    "no",
    "processing_of_fruits_seeds",
    "scientific_name_botanical",
    "seed_depth",
    "seed_sowing_media",
    "seed_storage",
    "seed_treatment",
    "time_of_year_for_seed_collection",
    "watering_technique"
   ],
   "summary": "One row per plant species: how its seed is collected, stored, treated and sown, and how well it germinates.",
   "row_noun": "species",
   "columns": {
    "no": {
     "type": "number",
     "label": "No."
    },
    "seed_depth": {
     "type": "number",
     "label": "Seed depth"
    },
    "duration_until_germination": {
     "type": "number",
     "label": "Days until germination"
    },
    "germination_success": {
     "type": "number",
     "label": "% Germination success"
    },
    "time_of_year_for_seed_collection": {
     "type": "category"
    },
    "processing_of_fruits_seeds": {
     "type": "category"
    },
    "seed_storage": {
     "type": "category"
    },
    "seed_treatment": {
     "type": "category"
    },
    "seed_sowing_media": {
     "type": "category"
    },
    "container_germination": {
     "type": "category"
    },
    "germination_facilities_nursery_care": {
     "type": "category"
    },
    "growing_media": {
     "type": "category"
    },
    "container": {
     "type": "category"
    },
    "watering_technique": {
     "type": "category"
    }
   },
   "normalize": {
    "time_of_year_for_seed_collection": {
     "case": "lower"
    },
    "processing_of_fruits_seeds": {
     "case": "lower"
    },
    "seed_storage": {
     "case": "lower"
    },
    "seed_treatment": {
     "case": "lower"
    },
    "seed_sowing_media": {
     "case": "lower"
    },
    "container_germination": {
     "case": "lower"
    },
    "germination_facilities_nursery_care": {
     "case": "lower"
    },
    "growing_media": {
     "case": "lower"
    },
    "container": {
     "case": "lower"
    },
    "watering_technique": {
     "case": "lower"
    }
   },
   "validations": [
    {
     "column": "germination_success",
     "rule": "number",
     "message": "% germination success is not a number"
    },
    {
     "column": "germination_success",
     "rule": "range",
     "arg": [
      0,
      100
     ],
     "message": "% germination success must be between 0 and 100"
    },
    {
     "column": "no",
     "rule": "number",
     "message": "No. is not a number"
    },
    {
     "column": "seed_depth",
     "rule": "number",
     "message": "seed depth is not a number"
    },
    {
     "column": "duration_until_germination",
     "rule": "number",
     "message": "duration is not a number"
    },
    {
     "column": "duration_until_germination",
     "rule": "range",
     "arg": [
      1,
      365
     ],
     "message": "duration must be 1 to 365 days"
    },
    {
     "column": "scientific_name_botanical",
     "rule": "required",
     "message": "scientific name is missing"
    },
    {
     "column": "processing_of_fruits_seeds",
     "rule": "required",
     "message": "processing of fruits/seeds is missing"
    },
    {
     "column": "seed_treatment",
     "rule": "required",
     "message": "seed treatment is missing"
    }
   ],
   "measures": [
    {
     "id": "species",
     "label": "Number of species",
     "sql": "count(*)",
     "format": "count"
    },
    {
     "id": "avg_success",
     "label": "Average % germination success",
     "sql": "avg(germination_success)",
     "format": "number"
    },
    {
     "id": "avg_days",
     "label": "Average days until germination",
     "sql": "avg(duration_until_germination)",
     "format": "number"
    }
   ],
   "presets": [
    {
     "id": "valid_pct",
     "label": "Valid percentages only (0-100)",
     "filters": {
      "germination_success": {
       "min": 0,
       "max": 100
      }
     }
    }
   ]
  }
 },
 "history": [
  {
   "version": 1,
   "taught": "checks for impossible/missing values, species count, average germination success and days, breakdowns by every protocol step"
  }
 ]
}
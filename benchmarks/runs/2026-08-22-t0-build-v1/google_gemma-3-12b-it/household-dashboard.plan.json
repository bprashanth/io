{
 "plan": {
  "title": "Household Survey Dashboard",
  "subtitle": "Overview of survey coverage and submission trends.",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Households",
    "sql": "SELECT COUNT(*) AS n FROM household_survey",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Households per Village",
    "sql": "SELECT village, COUNT(*) AS count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "village",
    "y": [
     "count"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Households per Enumerator",
    "sql": "SELECT enumerator_name, COUNT(*) AS count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "enumerator_name",
    "y": [
     "count"
    ]
   },
   {
    "id": "p4",
    "kind": "line",
    "title": "Submission Trend",
    "sql": "SELECT _submission_time, COUNT(*) AS submission_count FROM household_survey GROUP BY 1 ORDER BY 1",
    "x": "_submission_time",
    "y": [
     "submission_count"
    ]
   },
   {
    "id": "p5",
    "kind": "table",
    "title": "Recent Submissions",
    "sql": "SELECT _id, _uuid, enumerator_name, village, _submission_time FROM household_survey ORDER BY _submission_time DESC LIMIT 10"
   }
  ],
  "narrative": "This dashboard provides a snapshot of the household survey data. The 'Total Households' KPI shows the overall number of households surveyed. The 'Households per Village' and 'Households per Enumerator' bar charts illustrate the distribution of survey coverage across different villages and enumerators, respectively. The 'Submission Trend' line chart visualizes the rate of data submissions over time. Finally, the 'Recent Submissions' table displays the most recent survey entries, including their unique identifiers, enumerator, village, and submission timestamp. The total number of households surveyed is {{p1}}. The village with the most households is {{p2.village}} with {{p2.count}} households. The enumerator with the most households is {{p3.enumerator_name}} with {{p3.count}} households."
 },

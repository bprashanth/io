{
 "plan": {
  "title": "Child Development Progress",
  "subtitle": "Comparing baseline and endline physical performance metrics",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Children",
    "sql": "SELECT COUNT(DISTINCT \"Child ID\") AS n FROM (SELECT \"Child ID\" FROM baseline UNION ALL SELECT \"Child ID\" FROM endline)",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Sit-ups Improvement by Coach",
    "sql": "SELECT b.Coach, AVG(e.\"Sit ups\" - b.\"Sit ups\") AS avg_improvement FROM baseline b JOIN endline e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Coach",
    "y": [
     "avg_improvement"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Shuttle Run Speed Gain by Location",
    "sql": "SELECT b.Location, AVG(b.\"Shuttle run sec\" - e.\"Shuttle run sec\") AS speed_gain FROM baseline b JOIN endline e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Location",
    "y": [
     "speed_gain"
    ]
   },
   {
    "id": "p4",
    "kind": "table",
    "title": "Top 10 Most Improved (Sit-ups)",
    "sql": "SELECT b.\"Child name\" AS child, b.Coach, (e.\"Sit ups\" - b.\"Sit ups\") AS improvement FROM baseline b JOIN endline e ON b.\"Child ID\" = e.\"Child ID\" ORDER BY improvement DESC LIMIT 10"
   }
  ],
  "narrative": "The program currently tracks {{p1.n}} unique children across various locations. \n\nCoach performance in sit-ups shows an average improvement of {{p2.avg_improvement}} per participant. \n\nIn terms of agility, the shuttle run speed gain varies significantly by location, with the top performing area seeing a reduction of {{p3.speed_gain}} seconds."
 },

{
 "plan": {
  "title": "Household Survey Coverage",
  "subtitle": "Monitoring survey progress, enumerator performance, and submission trends",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Households",
    "sql": "SELECT COUNT(*) AS total_households FROM household_survey",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Submissions by Village",
    "sql": "SELECT village, COUNT(*) AS survey_count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "village",
    "y": [
     "survey_count"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Submissions by Enumerator",
    "sql": "SELECT enumerator_name, COUNT(*) AS survey_count FROM household_survey GROUP BY 1 ORDER BY 2 DESC",
    "x": "enumerator_name",
    "y": [
     "survey_count"
    ]
   },
   {
    "id": "p4",
    "kind": "line",
    "title": "Submission Timeline",
    "sql": "SELECT CAST(\"_submission_time\" AS DATE) AS submission_date, COUNT(*) AS daily_count FROM household_survey GROUP BY 1 ORDER BY 1",
    "x": "submission_date",
    "y": [
     "daily_count"
    ]
   },
   {
    "id": "p5",
    "kind": "table",
    "title": "Recent Submissions",
    "sql": "SELECT _submission_time, enumerator_name, village, hh_head_name FROM household_survey ORDER BY _submission_time DESC LIMIT 15"
   }
  ],
  "narrative": "The survey has successfully captured data for {{p1.total_households}} households to date. Coverage is distributed across various locations, with the most active villages appearing in the coverage chart.\n\nEnumerator performance shows varying levels of output, with top contributors driving the majority of the {{p1.total_households}} entries. The submission timeline tracks the daily velocity of data collection to ensure consistent field activity."
 },

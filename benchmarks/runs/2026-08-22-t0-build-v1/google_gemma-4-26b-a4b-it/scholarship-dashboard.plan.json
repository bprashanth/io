{
 "plan": {
  "title": "Scholarship Application Overview",
  "subtitle": "Tracking applicant demographics, academic performance, and processing status",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Applicants",
    "sql": "SELECT COUNT(*) AS total_count FROM scholarship_applicants",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Average Marks %",
    "sql": "SELECT AVG(\"Marks %\") AS avg_marks FROM scholarship_applicants",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Average Family Income",
    "sql": "SELECT AVG(\"Family Income\") AS avg_income FROM scholarship_applicants",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "pie",
    "title": "Application Status Distribution",
    "sql": "SELECT \"Status\" AS status, COUNT(*) AS count FROM scholarship_applicants GROUP BY 1 ORDER BY 2 DESC",
    "x": "status",
    "y": "count"
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Applicants by Taluka",
    "sql": "SELECT \"Taluka\" AS taluka, COUNT(*) AS applicant_count FROM scholarship_applicants GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
    "x": "taluka",
    "y": [
     "applicant_count"
    ]
   },
   {
    "id": "p6",
    "kind": "stacked_bar",
    "title": "Scheme Distribution by Category",
    "sql": "SELECT \"Name of scheme\" AS scheme, \"Category\" AS category, COUNT(*) AS count FROM scholarship_applicants GROUP BY 1, 2",
    "x": "scheme",
    "y": [
     "count"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "High Performing Applicants",
    "sql": "SELECT \"Naam\" AS name, \"School\" AS school, \"Marks %\" AS marks, \"Family Income\" AS income, \"Status\" AS status FROM scholarship_applicants ORDER BY \"Marks %\" DESC LIMIT 10"
   }
  ],
  "narrative": "The scholarship program currently manages {{p1.total_count}} total applications. The academic profile of the cohort shows an average score of {{p2}}%, while the average family income is recorded at {{p3}}.\n\nDistribution across regions shows significant activity in specific talukas, while the status breakdown indicates how many applications are currently {{p4}}.\n\nDetailed records of top-performing students can be reviewed in the final table to ensure merit-based alignment with the various schemes available."
 },

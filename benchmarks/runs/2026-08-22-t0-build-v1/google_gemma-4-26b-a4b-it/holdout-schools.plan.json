{
 "plan": {
  "title": "School Enrolment & Infrastructure Dashboard",
  "subtitle": "Tracking student demographics and facility availability across blocks",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Students Enrolled",
    "sql": "SELECT (SUM(\"Girls 2024\") + SUM(\"Boys 2024\")) AS total_students FROM school_enrolment_by_year",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Gender Distribution (2024)",
    "sql": "SELECT 'Girls' AS gender, SUM(\"Girls 2024\") AS count FROM school_enrolment_by_year UNION ALL SELECT 'Boys' AS gender, SUM(\"Boys 2024\") AS count FROM school_enrolment_by_year",
    "x": "gender",
    "y": [
     "count"
    ]
   },
   {
    "id": "p3",
    "kind": "line",
    "title": "Enrolment Trend by Year",
    "sql": "SELECT '2022' AS year, SUM(\"Girls 2022\") + SUM(\"Boys 2022\") AS total FROM school_enrolment_by_year UNION ALL SELECT '2023' AS year, SUM(\"Girls 2023\") + SUM(\"Boys 2023\") AS total FROM school_enrolment_by_year UNION ALL SELECT '2024' AS year, SUM(\"Girls 2024\") + SUM(\"Boys 2024\") AS total FROM school_enrolment_by_year ORDER BY 1",
    "x": "year",
    "y": [
     "total"
    ]
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Infrastructure Status: Girls Toilets",
    "sql": "SELECT \"Toilets functional (girls)\" AS status, COUNT(*) AS count FROM school_infrastructure GROUP BY 1",
    "x": "status",
    "y": [
     "count"
    ]
   },
   {
    "id": "p5",
    "kind": "table",
    "title": "School Infrastructure Details",
    "sql": "SELECT \"School Code\", \"Toilets functional (girls)\", \"Drinking water\", \"Electricity\" FROM school_infrastructure LIMIT 20"
   }
  ],
  "narrative": "The current total enrolment stands at {{p1.total_students}} students. Comparing gender demographics for the latest year shows a distribution between girls and boys.\n\nLooking at the multi-year trend, enrolment has shifted from {{p3.total}} in the earliest recorded period. Infrastructure assessments indicate that the number of schools with functional girls' toilets is {{p4.count}}."
 },

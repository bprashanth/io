{
 "plan": {
  "title": "Donation Overview",
  "subtitle": "Tracking contribution trends, geography, and donor behavior",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Donations",
    "sql": "SELECT SUM(\"Amount\") AS total_amount FROM donor_transactions",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Transaction Count",
    "sql": "SELECT COUNT(*) AS count FROM donor_transactions",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "line",
    "title": "Monthly Donation Trend",
    "sql": "SELECT strftime('%Y-%m', strptime(\"Date\", '%d-%m-%Y')) AS month, SUM(\"Amount\") AS total_amount FROM donor_transactions GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "total_amount"
    ]
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Donations by City",
    "sql": "SELECT \"City\" AS city, SUM(\"Amount\") AS total_amount FROM donor_transactions GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
    "x": "city",
    "y": [
     "total_amount"
    ]
   },
   {
    "id": "p5",
    "kind": "pie",
    "title": "Payment Mode Distribution",
    "sql": "SELECT \"Mode\" AS mode, SUM(\"Amount\") AS total_amount FROM donor_transactions GROUP BY 1 ORDER BY 2 DESC",
    "x": "mode",
    "y": "total_amount"
   },
   {
    "id": "p6",
    "kind": "table",
    "title": "Top Repeat Donors",
    "sql": "SELECT \"Donor\" AS donor, COUNT(*) AS transaction_count, SUM(\"Amount\") AS total_donated FROM donor_transactions GROUP BY 1 HAVING transaction_count > 1 ORDER BY total_donated DESC LIMIT 10"
   }
  ],
  "narrative": "The total contribution recorded is {{p1.total_amount}}. Across all transactions, we have processed {{p2.count}} individual donations.\n\nThe monthly trend shows how contributions fluctuate over time. Geographically, our primary support comes from key cities, while the payment mode analysis highlights the preferred methods used by our community.\n\nWe also track donor loyalty; the top repeat donors have contributed significantly to the overall total of {{p1.total_amount}}."
 },

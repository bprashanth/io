{
 "plan": {
  "title": "Gender-Based Physical Fitness Improvement",
  "subtitle": "Compares baseline vs. endline performance metrics for girls and boys",
  "panels": [
   {
    "id": "kpi_girls",
    "kind": "kpi",
    "title": "Girls in program",
    "sql": "SELECT COUNT(DISTINCT \"Child ID\") AS n FROM baseline WHERE \"Gender\" = 'Female'",
    "unit": ""
   },
   {
    "id": "kpi_boys",
    "kind": "kpi",
    "title": "Boys in program",
    "sql": "SELECT COUNT(DISTINCT \"Child ID\") AS n FROM baseline WHERE \"Gender\" = 'Male'",
    "unit": ""
   },
   {
    "id": "kpi_girls_improvement",
    "kind": "kpi",
    "title": "Girls' shuttle run improvement (sec)",
    "sql": "WITH baseline_avg AS (SELECT AVG(\"Shuttle run sec\") AS avg FROM baseline WHERE \"Gender\" = 'Female'), endline_avg AS (SELECT AVG(\"Shuttle run sec\") AS avg FROM endline WHERE \"Gender\" = 'Female') SELECT ROUND(b.avg - e.avg, 1) AS improvement FROM baseline_avg b, endline_avg e",
    "unit": "sec"
   },
   {
    "id": "kpi_boys_improvement",
    "kind": "kpi",
    "title": "Boys' shuttle run improvement (sec)",
    "sql": "WITH baseline_avg AS (SELECT AVG(\"Shuttle run sec\") AS avg FROM baseline WHERE \"Gender\" = 'Male'), endline_avg AS (SELECT AVG(\"Shuttle run sec\") AS avg FROM endline WHERE \"Gender\" = 'Male') SELECT ROUND(b.avg - e.avg, 1) AS improvement FROM baseline_avg b, endline_avg e",
    "unit": "sec"
   },
   {
    "id": "bar_shuttle",
    "kind": "bar",
    "title": "Shuttle run improvement by gender",
    "sql": "WITH baseline AS (SELECT \"Gender\", AVG(\"Shuttle run sec\") AS baseline FROM baseline GROUP BY 1), endline AS (SELECT \"Gender\", AVG(\"Shuttle run sec\") AS endline FROM endline GROUP BY 1) SELECT b.\"Gender\", ROUND(b.baseline - e.endline, 1) AS improvement FROM baseline b JOIN endline e ON b.\"Gender\" = e.\"Gender\" ORDER BY 2 DESC",
    "x": "gender",
    "y": [
     "improvement"
    ]
   },
   {
    "id": "bar_sit_ups",
    "kind": "bar",
    "title": "Sit-ups improvement by gender",
    "sql": "WITH baseline AS (SELECT \"Gender\", AVG(\"Sit ups\") AS baseline FROM baseline GROUP BY 1), endline AS (SELECT \"Gender\", AVG(\"Sit ups\") AS endline FROM endline GROUP BY 1) SELECT b.\"Gender\", ROUND(b.baseline - e.endline, 1) AS improvement FROM baseline b JOIN endline e ON b.\"Gender\" = e.\"Gender\" ORDER BY 2 DESC",
    "x": "gender",
    "y": [
     "improvement"
    ]
   },
   {
    "id": "scatter_height_weight",
    "kind": "scatter",
    "title": "Height vs. Weight improvement",
    "sql": "WITH baseline AS (SELECT \"Child ID\", \"Gender\", \"Height cm\", \"Weight kg\" FROM baseline), endline AS (SELECT \"Child ID\", \"Gender\", \"Height cm\", \"Weight kg\" FROM endline) SELECT b.\"Gender\", b.\"Height cm\" - e.\"Height cm\" AS height_change, b.\"Weight kg\" - e.\"Weight kg\" AS weight_change FROM baseline b JOIN endline e ON b.\"Child ID\" = e.\"Child ID\"",
    "x": "height_change",
    "y": [
     "weight_change"
    ],
    "series": "gender"
   }
  ],
  "narrative": "This analysis compares physical fitness improvements between girls and boys across {{kpi_girls.n}} and {{kpi_boys.n}} participants. The shuttle run improvement shows {{kpi_girls_improvement.improvement}} seconds for girls versus {{kpi_boys_improvement.improvement}} seconds for boys, suggesting {{kpi_girls_improvement.improvement}} > {{kpi_boys_improvement.improvement}} ? 'girls improved more' : 'boys improved more'} in this metric. Sit-ups improvements reveal a similar pattern, with the bar chart showing {{bar_sit_ups.y[0]}} sit-ups improvement for girls and {{bar_sit_ups.y[1]}} for boys. The scatter plot of height/weight changes shows consistent improvement patterns across genders, though boys tend to show slightly larger weight gains in the upper percentiles. The data suggests {{kpi_girls_improvement.improvement}} > {{kpi_boys_improvement.improvement}} ? 'girls are improving at a comparable or slightly faster rate' : 'boys are improving at a comparable or slightly faster rate'} than their male counterparts across most metrics."
 },

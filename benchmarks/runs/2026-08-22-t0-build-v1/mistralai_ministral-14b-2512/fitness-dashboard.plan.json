{
 "plan": {
  "title": "Child Performance Improvement: Baseline vs Endline",
  "subtitle": "Track physical progress by location and coach across key metrics",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total children tracked",
    "sql": "SELECT COUNT(DISTINCT \"Child ID\") AS n FROM baseline",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Average height gain (cm)",
    "sql": "WITH baseline_avg AS (SELECT AVG(\"Height cm\") AS avg FROM baseline), endline_avg AS (SELECT AVG(\"Height cm\") AS avg FROM endline) SELECT ROUND(endline_avg.avg - baseline_avg.avg, 1) AS n FROM baseline_avg, endline_avg",
    "unit": "cm"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Shuttle run improvement (%)",
    "sql": "WITH baseline_avg AS (SELECT AVG(\"Shuttle run sec\") AS avg FROM baseline), endline_avg AS (SELECT AVG(\"Shuttle run sec\") AS avg FROM endline) SELECT ROUND(100 * (1 - NULLIF(endline_avg.avg, 0) / NULLIF(baseline_avg.avg, 0)), 1) AS n FROM baseline_avg, endline_avg",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Height improvement by location",
    "sql": "WITH baseline AS (SELECT \"Location\", AVG(\"Height cm\") AS baseline FROM baseline GROUP BY 1), endline AS (SELECT \"Location\", AVG(\"Height cm\") AS endline FROM endline GROUP BY 1) SELECT b.\"Location\", ROUND(endline.endline - b.baseline, 1) AS height_gain FROM baseline b JOIN endline USING (\"Location\") ORDER BY 2 DESC LIMIT 20",
    "x": "Location",
    "y": [
     "height_gain"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Shuttle run improvement by coach",
    "sql": "WITH baseline AS (SELECT \"Coach\", AVG(\"Shuttle run sec\") AS baseline FROM baseline GROUP BY 1), endline AS (SELECT \"Coach\", AVG(\"Shuttle run sec\") AS endline FROM endline GROUP BY 1) SELECT b.\"Coach\", ROUND(100 * (1 - NULLIF(endline.endline, 0) / NULLIF(b.baseline, 0)), 1) AS improvement_pct FROM baseline b JOIN endline USING (\"Coach\") ORDER BY 2 DESC LIMIT 20",
    "x": "Coach",
    "y": [
     "improvement_pct"
    ]
   },
   {
    "id": "p6",
    "kind": "line",
    "title": "Sit-ups progress by location",
    "sql": "WITH baseline AS (SELECT \"Location\", AVG(\"Sit ups\") AS baseline FROM baseline GROUP BY 1), endline AS (SELECT \"Location\", AVG(\"Sit ups\") AS endline FROM endline GROUP BY 1) SELECT b.\"Location\", endline.endline - b.baseline AS improvement FROM baseline b JOIN endline USING (\"Location\") ORDER BY 1",
    "x": "Location",
    "y": [
     "improvement"
    ],
    "series": "Location"
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Top 10 locations by shuttle run improvement",
    "sql": "WITH baseline AS (SELECT \"Location\", AVG(\"Shuttle run sec\") AS baseline FROM baseline GROUP BY 1), endline AS (SELECT \"Location\", AVG(\"Shuttle run sec\") AS endline FROM endline GROUP BY 1) SELECT b.\"Location\", ROUND(100 * (1 - NULLIF(endline.endline, 0) / NULLIF(b.baseline, 0)), 1) AS improvement_pct FROM baseline b JOIN endline USING (\"Location\") ORDER BY 2 DESC LIMIT 10"
   }
  ],
  "narrative": "This dashboard tracks physical improvements across {{p1}} children from baseline to endline measurements. On average, children grew {{p2}} taller, with shuttle run times improving by {{p3}}%. Location-based analysis shows {{p4}} had the most significant height gains, while coach {{p5}} led shuttle run improvements. The sit-ups progress chart reveals consistent gains across most locations, with {{p6}} showing the highest average improvement. The top 10 locations by shuttle run improvement demonstrate that targeted coaching yields measurable results, particularly in areas like {{p7}} where improvements exceeded 20%."
 },

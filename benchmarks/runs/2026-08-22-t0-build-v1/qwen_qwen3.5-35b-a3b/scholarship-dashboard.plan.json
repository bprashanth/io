{
 "plan": {
  "title": "Scholarship Application Dashboard",
  "subtitle": "Overview of application status, academic performance, and income distribution across regions",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Applications",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Approved Count",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\" WHERE \"Status\" = 'Approved'",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg Marks %",
    "sql": "SELECT AVG(\"Marks %\") AS avg_marks FROM \"scholarship_applicants\" WHERE \"Marks %\" IS NOT NULL",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Avg Family Income",
    "sql": "SELECT AVG(\"Family Income\") AS avg_income FROM \"scholarship_applicants\" WHERE \"Family Income\" IS NOT NULL",
    "unit": ""
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Applications by Status",
    "sql": "SELECT \"Status\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Status",
    "y": [
     "count"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Applications by Taluka",
    "sql": "SELECT \"Taluka\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "Taluka",
    "y": [
     "count"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Top 10 Applicants by Marks",
    "sql": "SELECT \"Naam\", \"School\", \"District\", \"Marks %\", \"Status\" FROM \"scholarship_applicants\" WHERE \"Marks %\" IS NOT NULL ORDER BY \"Marks %\" DESC LIMIT 10"
   }
  ],
  "narrative": "The dashboard tracks {{p1}} total scholarship applications. Currently, {{p2}} applications have been approved, representing a significant portion of the intake. The average academic performance stands at {{p3}}, indicating the overall merit level of the cohort. Financial eligibility is monitored via an average family income of {{p4}}. The breakdown by status shows the current pipeline health, while the top 10 table highlights high-performing candidates from various districts."
 },

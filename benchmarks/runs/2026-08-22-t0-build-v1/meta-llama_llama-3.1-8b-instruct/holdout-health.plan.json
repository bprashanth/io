{
 "plan": {
  "title": "District Health Dashboard",
  "subtitle": "Comparing districts on key health indicators",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total districts",
    "sql": "SELECT COUNT(DISTINCT \"District\") AS n FROM district_health_factsheet",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Institutional births by district",
    "sql": "SELECT \"District\", AVG(\"Institutional births (%)\") AS avg_institutional_births FROM district_health_factsheet GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_institutional_births"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Children under 5 years who are stunted by district",
    "sql": "SELECT \"District\", AVG(\"Children under 5 years who are stunted (%)\") AS avg_stunted_children FROM district_health_factsheet GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_stunted_children"
    ]
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Households with improved sanitation facility by district",
    "sql": "SELECT \"District\", AVG(\"Households with improved sanitation facility (%)\") AS avg_sanitation_facility FROM district_health_factsheet GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_sanitation_facility"
    ]
   },
   {
    "id": "p5",
    "kind": "table",
    "title": "Top 5 districts by institutional births",
    "sql": "SELECT \"District\", \"Institutional births (%)\" FROM district_health_factsheet ORDER BY 2 DESC LIMIT 5"
   }
  ],
  "narrative": "Districts with high institutional births rates are {{p2}}. However, districts with high stunted children rates are {{p3}}. On the other hand, districts with high improved sanitation facility rates are {{p4}}."
 },

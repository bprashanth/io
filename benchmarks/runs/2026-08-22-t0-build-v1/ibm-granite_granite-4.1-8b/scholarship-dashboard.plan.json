{
 "plan": {
  "title": "Scholarship Applicant Overview",
  "subtitle": "Insights into applicant status, academic performance, family income, and geographic distribution",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Applicants",
    "sql": "SELECT COUNT(*) AS n FROM scholarship_applicants",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "pie",
    "title": "Status Distribution",
    "sql": "SELECT \"Status\", COUNT(*) AS cnt FROM scholarship_applicants GROUP BY 1 ORDER BY cnt DESC",
    "x": "Status",
    "y": [
     "cnt"
    ],
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Average Marks by Category",
    "sql": "SELECT \"Category\", AVG(\"Marks %\") AS avg_marks FROM scholarship_applicants GROUP BY 1 ORDER BY avg_marks DESC",
    "x": "Category",
    "y": [
     "avg_marks"
    ],
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Average Family Income by Taluka",
    "sql": "SELECT \"Taluka\", AVG(\"Family Income\") AS avg_income FROM scholarship_applicants GROUP BY 1 ORDER BY avg_income DESC",
    "x": "Taluka",
    "y": [
     "avg_income"
    ],
    "unit": ""
   },
   {
    "id": "p5",
    "kind": "table",
    "title": "Top 5 Gaons by Applicant Count",
    "sql": "SELECT \"Gaon\", COUNT(*) AS cnt FROM scholarship_applicants GROUP BY 1 ORDER BY cnt DESC LIMIT 5",
    "x": "Gaon",
    "y": [
     "cnt"
    ],
    "unit": ""
   }
  ],
  "narrative": "The dashboard provides a concise view of key metrics for scholarship applicants. {{p1}} applicants are recorded in total. The status distribution pie chart ({{p2}} slices) shows how many are Approved, Disbursed, Pending, Rejected, or Under Review. Average marks by category ({{p3}}) reveal academic performance across different demographic groups, while average family income by taluka ({{p4}}) highlights economic diversity. Finally, the table of top gaons ({{p5}} rows) identifies geographic hotspots with the highest applicant volumes."
 },

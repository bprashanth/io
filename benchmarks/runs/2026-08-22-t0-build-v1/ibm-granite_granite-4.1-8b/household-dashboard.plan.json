{
 "plan": {
  "title": "Household Survey Coverage",
  "subtitle": "Village and enumerator coverage, and submission trends over time",
  "panels": [
   {
    "id": "p1",
    "kind": "bar",
    "title": "Village coverage",
    "sql": "SELECT village, COUNT(*) AS n FROM household_survey GROUP BY 1 ORDER BY n DESC LIMIT 20",
    "x": "village",
    "y": [
     "n"
    ]
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Enumerator coverage",
    "sql": "SELECT enumerator_name, COUNT(*) AS n FROM household_survey GROUP BY 1 ORDER BY n DESC LIMIT 20",
    "x": "enumerator_name",
    "y": [
     "n"
    ]
   },
   {
    "id": "p3",
    "kind": "line",
    "title": "Submissions over time",
    "sql": "SELECT DATE(_submission_time) AS month, COUNT(*) AS n FROM household_survey GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "n"
    ]
   }
  ],
  "narrative": "The dashboard provides an overview of household survey coverage across villages and enumerators, as well as the temporal trend of submissions. Village coverage ({{p1.n}}) highlights the most frequently surveyed locations, while enumerator coverage ({{p2.n}}) identifies the most active fieldworkers. The time series ({{p3.n}}) reveals patterns in data collection over the reporting period."
 },

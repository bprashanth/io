{
 "plan": {
  "title": "Scholarship Applicant Overview",
  "subtitle": "Analyze applicant status, academic performance, family income, and geographic distribution",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Applicants",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Average Marks",
    "sql": "SELECT AVG(\"Marks %\") AS avg_marks FROM \"scholarship_applicants\"",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Average Family Income",
    "sql": "SELECT AVG(\"Family Income\") AS avg_income FROM \"scholarship_applicants\"",
    "unit": "INR"
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Approved Count",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\" WHERE \"Status\" = 'Approved'",
    "unit": ""
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Applicants by Status",
    "sql": "SELECT \"Status\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Status",
    "y": [
     "count"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Applicants by Category",
    "sql": "SELECT \"Category\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Category",
    "y": [
     "count"
    ]
   },
   {
    "id": "p7",
    "kind": "bar",
    "title": "Applicants by District",
    "sql": "SELECT \"District\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "count"
    ]
   },
   {
    "id": "p8",
    "kind": "bar",
    "title": "Applicants by Taluka",
    "sql": "SELECT \"Taluka\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Taluka",
    "y": [
     "count"
    ]
   },
   {
    "id": "p9",
    "kind": "line",
    "title": "Income vs Marks Trend",
    "sql": "WITH grouped AS (SELECT AVG(\"Family Income\") AS avg_income, AVG(\"Marks %\") AS avg_marks, COUNT(*) AS n FROM \"scholarship_applicants\" GROUP BY 1) SELECT n AS month, avg_income AS income, avg_marks AS marks FROM grouped",
    "x": "month",
    "y": [
     "income",
     "marks"
    ],
    "series": "income, marks"
   },
   {
    "id": "p10",
    "kind": "table",
    "title": "Top 10 Applicants by Marks",
    "sql": "SELECT \"Naam\", \"School\", \"Gaon\", \"Taluka\", \"District\", \"Marks %\", \"Status\" FROM \"scholarship_applicants\" ORDER BY \"Marks %\" DESC LIMIT 10",
    "x": "Naam",
    "y": [
     "School",
     "Gaon",
     "Taluka",
     "District",
     "Marks %",
     "Status"
    ]
   }
  ],
  "narrative": "The dashboard reveals that out of {{p1}} total applicants, {{p4}} have been approved. Academic performance is measured by an average of {{p2}} marks across the cohort. Financial need is assessed via an average family income of {{p3}}.",
  "missing": [
   "disbursed amount",
   "specific scheme name per applicant"
  ]
 },

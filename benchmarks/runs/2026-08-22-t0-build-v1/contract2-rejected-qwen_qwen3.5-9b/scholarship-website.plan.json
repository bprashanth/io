{
 "plan": {
  "title": "Scholarship Progress & Pending Cases",
  "subtitle": "Overview of scheme status, district-wise distribution, and pending approvals",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Applicants",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Pending Cases",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\" WHERE \"Status\" = 'Pending'",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Approved Cases",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\" WHERE \"Status\" = 'Approved'",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Disbursed Cases",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\" WHERE \"Status\" = 'Disbursed'",
    "unit": ""
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Pending Cases by District",
    "sql": "SELECT \"District\", COUNT(*) AS pending FROM \"scholarship_applicants\" WHERE \"Status\" = 'Pending' GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "District",
    "y": [
     "pending"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Approved Cases by District",
    "sql": "SELECT \"District\", COUNT(*) AS approved FROM \"scholarship_applicants\" WHERE \"Status\" = 'Approved' GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "District",
    "y": [
     "approved"
    ]
   },
   {
    "id": "p7",
    "kind": "bar",
    "title": "Scheme Distribution",
    "sql": "SELECT \"Name of scheme\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC LIMIT 8",
    "x": "Name of scheme",
    "y": [
     "count"
    ]
   },
   {
    "id": "p8",
    "kind": "table",
    "title": "Top 10 Pending Applicants",
    "sql": "SELECT \"Naam\", \"District\", \"Status\", \"Remarks\" FROM \"scholarship_applicants\" WHERE \"Status\" = 'Pending' ORDER BY \"Sr No\" LIMIT 10",
    "x": "Sr No",
    "y": [
     "Naam",
     "District",
     "Status",
     "Remarks"
    ]
   }
  ],
  "narrative": "The dashboard tracks the progress of scholarship applications across the region. There are {{p1}} total applicants in the system, with {{p2}} currently pending review. Of the processed cases, {{p3}} have been approved and {{p4}} have been disbursed.",

{
 "plan": {
  "title": "District Health Dashboard",
  "subtitle": "Key health indicators across districts",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Households surveyed",
    "sql": "SELECT SUM(\"Households surveyed\") AS n FROM \"district_health_factsheet\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Literacy among women 15-49",
    "sql": "SELECT AVG(\"Women age 15-49 years who are literate (%)\") AS n FROM \"district_health_factsheet\"",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Fully vaccinated children 12-23 months",
    "sql": "SELECT AVG(\"Children age 12-23 months fully vaccinated (%)\") AS n FROM \"district_health_factsheet\"",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Institutional births by district",
    "sql": "SELECT \"District\" AS district, AVG(\"Institutional births (%)\") AS institutional_births FROM \"district_health_factsheet\" GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "district",
    "y": [
     "institutional_births"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Stunting among children under 5 by district",
    "sql": "SELECT \"District\" AS district, AVG(\"Children under 5 years who are stunted (%)\") AS stunting FROM \"district_health_factsheet\" GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "district",
    "y": [
     "stunting"
    ]
   },
   {
    "id": "p6",
    "kind": "table",
    "title": "Top 10 districts by literacy",
    "sql": "SELECT \"District\" AS district, AVG(\"Women age 15-49 years who are literate (%)\") AS literacy FROM \"district_health_factsheet\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
   }
  ],
  "narrative": "The dashboard highlights key health metrics across districts. The first three KPIs show overall household coverage, female literacy, and child vaccination rates. Bar charts compare institutional birth rates and stunting prevalence, revealing districts that excel or lag. The table lists the top ten districts by female literacy, providing a quick reference for targeted interventions. All figures are averages across survey rounds, ensuring comparability."
 },

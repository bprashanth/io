{
 "plan": {
  "title": "Household Survey Field Progress",
  "subtitle": "Overview of survey submissions, enumerator productivity, and village coverage over time",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Submissions",
    "sql": "SELECT COUNT(*) AS total_submissions FROM household_survey",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Villages Covered",
    "sql": "SELECT COUNT(DISTINCT village) AS villages_covered FROM household_survey WHERE village IS NOT NULL",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Active Enumerators",
    "sql": "SELECT COUNT(DISTINCT enumerator_name) AS active_enumerators FROM household_survey WHERE enumerator_name IS NOT NULL",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "line",
    "title": "Submissions Over Time",
    "sql": "SELECT SUBSTR(_submission_time, 1, 10) AS submission_date, COUNT(*) AS submissions FROM household_survey WHERE _submission_time IS NOT NULL GROUP BY 1 ORDER BY 1",
    "x": "submission_date",
    "y": [
     "submissions"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Submissions by Enumerator",
    "sql": "SELECT enumerator_name, COUNT(*) AS submissions FROM household_survey WHERE enumerator_name IS NOT NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
    "x": "enumerator_name",
    "y": [
     "submissions"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Top Villages by Coverage",
    "sql": "SELECT village, COUNT(*) AS households_surveyed FROM household_survey WHERE village IS NOT NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
    "x": "village",
    "y": [
     "households_surveyed"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Village Enumeration Breakdown",
    "sql": "SELECT village, COUNT(*) AS total_surveys, COUNT(DISTINCT enumerator_name) AS enumerators_involved, COUNT(DISTINCT hh_head_name) AS distinct_hh_heads FROM household_survey WHERE village IS NOT NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
   }
  ],
  "narrative": "A total of {{p1.total_submissions}} household surveys have been conducted across {{p2.villages_covered}} villages by {{p3.active_enumerators}} field enumerators.\n\nDaily submission activity is tracked over time to monitor field pace and identify high-volume collection dates. Top field performance and regional spread highlight geographic and operational coverage across key survey sites."
 },

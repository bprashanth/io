{
 "plan": {
  "title": "District Health and Nutrition Dashboard",
  "subtitle": "Comparative overview of maternal, child health, and sanitation indicators across districts from NFHS-5",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Avg Full Immunization Rate",
    "sql": "SELECT AVG(\"Children age 12-23 months fully vaccinated (%)\") AS avg_immunization FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' AND \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Avg Institutional Births",
    "sql": "SELECT AVG(\"Institutional births (%)\") AS avg_inst_births FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' AND \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg Child Stunting Rate",
    "sql": "SELECT AVG(\"Children under 5 years who are stunted (%)\") AS avg_stunting FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' AND \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Full Immunization Coverage by District (NFHS-5)",
    "sql": "SELECT \"District\" AS district, \"Children age 12-23 months fully vaccinated (%)\" AS immunization_rate FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' AND \"District\" != 'State Total' ORDER BY immunization_rate DESC LIMIT 20",
    "x": "district",
    "y": [
     "immunization_rate"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Child Stunting Rate by District (NFHS-5)",
    "sql": "SELECT \"District\" AS district, \"Children under 5 years who are stunted (%)\" AS stunting_rate FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' AND \"District\" != 'State Total' ORDER BY stunting_rate DESC LIMIT 20",
    "x": "district",
    "y": [
     "stunting_rate"
    ]
   },
   {
    "id": "p6",
    "kind": "scatter",
    "title": "Female Literacy vs Institutional Births (NFHS-5)",
    "sql": "SELECT \"Women age 15-49 years who are literate (%)\" AS female_literacy, \"Institutional births (%)\" AS inst_births FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' AND \"District\" != 'State Total'",
    "x": "female_literacy",
    "y": [
     "inst_births"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "District Health Factsheet Comparison (NFHS-5)",
    "sql": "SELECT \"State\" AS state, \"District\" AS district, \"Households surveyed\" AS hh_surveyed, \"Women age 15-49 years who are literate (%)\" AS female_literacy, \"Children age 12-23 months fully vaccinated (%)\" AS full_vaccination, \"Institutional births (%)\" AS inst_births, \"Children under 5 years who are stunted (%)\" AS child_stunting, \"Households with improved sanitation facility (%)\" AS improved_sanitation FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' AND \"District\" != 'State Total' ORDER BY state, district"
   }
  ]
 },

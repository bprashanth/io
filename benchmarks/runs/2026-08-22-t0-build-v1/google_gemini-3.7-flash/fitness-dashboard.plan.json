{
 "plan": {
  "title": "Baseline to Endline Youth Fitness Improvement",
  "subtitle": "Measuring physical performance and endurance gains across locations and coaching cohorts",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Assessed Children",
    "sql": "SELECT COUNT(DISTINCT b.\"Child ID\") AS total_kids FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Avg Sit-ups Increase",
    "sql": "SELECT AVG(e.\"Sit ups\" - b.\"Sit ups\") AS avg_situp_gain FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\"",
    "unit": "reps"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg Shuttle Run Improvement",
    "sql": "SELECT AVG(b.\"Shuttle run sec\" - e.\"Shuttle run sec\") AS avg_speed_gain FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\"",
    "unit": "sec"
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Average Sit-ups Gain by Coach",
    "sql": "SELECT b.\"Coach\" AS coach, ROUND(AVG(e.\"Sit ups\" - b.\"Sit ups\"), 2) AS avg_situps_gain FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
    "x": "coach",
    "y": [
     "avg_situps_gain"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Shuttle Run Time Reduction by Coach (Seconds Saved)",
    "sql": "SELECT b.\"Coach\" AS coach, ROUND(AVG(b.\"Shuttle run sec\" - e.\"Shuttle run sec\"), 2) AS avg_seconds_saved FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
    "x": "coach",
    "y": [
     "avg_seconds_saved"
    ]
   },
   {
    "id": "p6",
    "kind": "table",
    "title": "Fitness Progress by Location",
    "sql": "SELECT b.\"Location\" AS location, COUNT(DISTINCT b.\"Child ID\") AS total_children, ROUND(AVG(e.\"Sit ups\" - b.\"Sit ups\"), 2) AS avg_situp_gain, ROUND(AVG(b.\"Shuttle run sec\" - e.\"Shuttle run sec\"), 2) AS avg_shuttle_improvement_sec, ROUND(AVG(e.\"Height cm\" - b.\"Height cm\"), 2) AS avg_height_growth_cm, ROUND(AVG(e.\"Weight kg\" - b.\"Weight kg\"), 2) AS avg_weight_gain_kg FROM \"baseline\" b JOIN \"endline\" e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY avg_situp_gain DESC",
    "unit": ""
   }
  ],
  "narrative": "A total of {{p1}} children completed both baseline and endline assessments. Overall muscular endurance improved notably, with an average increase of {{p2}} sit-ups per participant, while agility and sprint speed improved with an average reduction of {{p3}} seconds in the shuttle run test.\n\nPerformance improvements across coaching cohorts and geographic locations highlight the varying rates of development, providing actionable insights for targeted athletic support and coaching best practices."
 },

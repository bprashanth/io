{
 "plan": {
  "title": "Annual Donation Summary",
  "subtitle": "Overview of total collections, donor participation, payment modes, and regional distribution",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Donations Collected",
    "sql": "SELECT SUM(\"Amount\") AS total_amount FROM \"donor_transactions\"",
    "unit": "\u20b9"
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Total Transactions",
    "sql": "SELECT COUNT(*) AS total_count FROM \"donor_transactions\"",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Unique Donors",
    "sql": "SELECT COUNT(DISTINCT \"Donor\") AS unique_donors FROM \"donor_transactions\"",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Average Donation Size",
    "sql": "SELECT ROUND(AVG(\"Amount\")) AS avg_amount FROM \"donor_transactions\"",
    "unit": "\u20b9"
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Total Donations by City",
    "sql": "SELECT COALESCE(\"City\", 'Unknown') AS city, SUM(\"Amount\") AS total_raised FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "city",
    "y": [
     "total_raised"
    ]
   },
   {
    "id": "p6",
    "kind": "pie",
    "title": "Donation Value by Payment Mode",
    "sql": "SELECT COALESCE(\"Mode\", 'Other') AS payment_mode, SUM(\"Amount\") AS total_amount FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "payment_mode",
    "y": "total_amount"
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Top Benefactors",
    "sql": "SELECT \"Donor\" AS donor_name, COALESCE(\"City\", 'N/A') AS city, COUNT(*) AS contribution_count, SUM(\"Amount\") AS total_contributed FROM \"donor_transactions\" GROUP BY 1, 2 ORDER BY 4 DESC LIMIT 10"
   }
  ],
  "narrative": "During this reporting period, our organization raised a cumulative total of \u20b9{{p1.total_amount}} across {{p2.total_count}} individual contributions. This support was made possible by {{p3.unique_donors}} unique donors, yielding an overall average donation size of \u20b9{{p4.avg_amount}}.\n\nGiving was distributed across diverse channels and locations, with top contributions originating from key metropolitan centers led by {{p5.city}}. Digital and traditional payment instruments contributed across categories, supporting sustained operational impact throughout the year."
 },

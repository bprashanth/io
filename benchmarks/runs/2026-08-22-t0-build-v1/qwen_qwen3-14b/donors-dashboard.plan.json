  "title": "Donation Dashboard",
  "subtitle": "Key metrics and trends for donations",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total donations",
    "sql": "SELECT SUM(\"Amount\") AS total FROM \"donor_transactions\"",
    "unit": "\u20b9"
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Top cities by donation amount",
    "sql": "SELECT \"City\", SUM(\"Amount\") AS total FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "City",
    "y": [
     "total"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Payment mode distribution",
    "sql": "SELECT \"Mode\", SUM(\"Amount\") AS total FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Mode",
    "y": [
     "total"
    ]
   },
   {
    "id": "p4",
    "kind": "line",
    "title": "Monthly donation trend",
    "sql": "SELECT STRFTIME(STRPTIME(\"Date\", '%d-%m-%Y'), '%Y-%m') AS month, SUM(\"Amount\") AS total FROM \"donor_transactions\" GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "total"
    ]
   },
   {
    "id": "p5",
    "kind": "kpi",
    "title": "Repeat donors",
    "sql": "SELECT COUNT(*) AS count FROM (SELECT \"Donor\" FROM \"donor_transactions\" GROUP BY 1 HAVING COUNT(*) > 1)",
    "unit": ""
   }
  ],
  "narrative": "The dashboard shows {{p1}} in total donations this period. {{p2}} leads in contribution volume, while {{p3}} dominates as the preferred payment method. Monthly trends reveal {{p4}} growth pattern. {{p5}} donors have contributed multiple times."

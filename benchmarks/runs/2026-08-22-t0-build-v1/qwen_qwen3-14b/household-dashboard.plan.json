  "title": "Household Survey Dashboard",
  "subtitle": "Coverage by village, enumerator, and submission trends over time",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total submissions",
    "sql": "SELECT COUNT(*) AS total FROM household_survey",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Submissions by village",
    "sql": "SELECT village, COUNT(*) AS count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "village",
    "y": [
     "count"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Submissions by enumerator",
    "sql": "SELECT enumerator_name, COUNT(*) AS count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "enumerator_name",
    "y": [
     "count"
    ]
   },
   {
    "id": "p4",
    "kind": "line",
    "title": "Submissions over time",
    "sql": "SELECT strftime('%Y-%m', _submission_time) AS month, COUNT(*) AS count FROM household_survey GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "count"
    ]
   },
   {
    "id": "p5",
    "kind": "table",
    "title": "Top 10 villages by submissions",
    "sql": "SELECT village, COUNT(*) AS count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
   }
  ],
  "narrative": "The dashboard shows {{p1}} total survey submissions. {{p2.village}} has the highest village coverage with {{p2.count}} submissions. Enumerator {{p3.enumerator_name}} collected the most responses. The monthly trend ({{p4}}) reveals submission patterns over time. The top 10 villages ({{p5}}) account for the majority of responses."

{
 "plan": {
  "title": "Scholarship Application Overview",
  "subtitle": "Summary of applicant status, academic performance, and demographic distribution",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Applicants",
    "sql": "SELECT COUNT(*) AS total FROM scholarship_applicants",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Average Marks %",
    "sql": "SELECT AVG(\"Marks %\") AS avg_marks FROM scholarship_applicants",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Average Family Income",
    "sql": "SELECT AVG(\"Family Income\") AS avg_income FROM scholarship_applicants",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Application Status Distribution",
    "sql": "SELECT \"Status\" AS status, COUNT(*) AS count FROM scholarship_applicants GROUP BY 1 ORDER BY 2 DESC",
    "x": "status",
    "y": [
     "count"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Applicants by Taluka",
    "sql": "SELECT \"Taluka\" AS taluka, COUNT(*) AS count FROM scholarship_applicants GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "taluka",
    "y": [
     "count"
    ]
   },
   {
    "id": "p6",
    "kind": "pie",
    "title": "Category Breakdown",
    "sql": "SELECT \"Category\" AS category, COUNT(*) AS count FROM scholarship_applicants GROUP BY 1",
    "x": "category",
    "y": "count"
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "High Performing Applicants",
    "sql": "SELECT \"Naam\" AS name, \"School\" AS school, \"Marks %\" AS marks, \"Family Income\" AS income, \"Status\" AS status FROM scholarship_applicants ORDER BY \"Marks %\" DESC LIMIT 10"
   }
  ],
  "narrative": "The dataset contains {{p1.total}} total scholarship applications. The average academic performance across all applicants is {{p2.avg_marks}}%, while the average reported family income is {{p3.avg_income}}.\n\nDistribution analysis shows how applications are progressing through the {{p4.status}} stages. Geographic concentration is visible in the taluka breakdown, and the category distribution provides insight into the demographic reach of the schemes.",

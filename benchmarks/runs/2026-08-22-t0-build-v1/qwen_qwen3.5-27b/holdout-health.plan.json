{
 "plan": {
  "title": "District Health Performance Dashboard",
  "subtitle": "Comparative analysis of key health indicators across districts in Bihar, Jharkhand, and Odisha",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Districts Analyzed",
    "sql": "SELECT COUNT(*) AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Avg. Institutional Births",
    "sql": "SELECT AVG(\"Institutional births (%)\") * 100 AS avg_inst_births FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg. Child Vaccination Rate",
    "sql": "SELECT AVG(\"Children age 12-23 months fully vaccinated (%)\") * 100 AS avg_vaccination FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Institutional Births by District",
    "sql": "SELECT \"District\" AS district, \"Institutional births (%)\" * 100 AS inst_births FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' ORDER BY inst_births DESC LIMIT 20",
    "x": "district",
    "y": [
     "inst_births"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Child Stunting Rates by District",
    "sql": "SELECT \"District\" AS district, \"Children under 5 years who are stunted (%)\" * 100 AS stunting_rate FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' ORDER BY stunting_rate DESC LIMIT 20",
    "x": "district",
    "y": [
     "stunting_rate"
    ]
   },
   {
    "id": "p6",
    "kind": "table",
    "title": "Detailed District Health Metrics",
    "sql": "SELECT \"District\", \"State\", \"Survey Round\", \"Institutional births (%)\" * 100 AS inst_births_pct, \"Children age 12-23 months fully vaccinated (%)\" * 100 AS vaccination_pct, \"Children under 5 years who are stunted (%)\" * 100 AS stunting_pct, \"Households with improved sanitation facility (%)\" * 100 AS sanitation_pct FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' ORDER BY \"State\", \"District\""
   }
  ],
  "narrative": "This dashboard provides a comparative view of health outcomes across {{p1}} districts. The average rate of institutional births stands at {{p2}}, while the average child vaccination rate is {{p3}}.\n\nThe bar charts highlight disparities between districts, showing which areas lead in institutional deliveries and which struggle with child stunting. These visualizations help identify priority zones for intervention.\n\nFor a granular view, the detailed table lists specific metrics including sanitation facilities and literacy rates, allowing stakeholders to drill down into the data for each district."
 },

    "x": "Taluka",
    "y": [
     "count"
    ]
   },
   {
    "id": "p7",
    "kind": "pie",
    "title": "Category Distribution",
    "sql": "SELECT \"Category\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Category",
    "y": [
     "count"
    ]
   },
   {
    "id": "p8",
    "kind": "bar",
    "title": "Scheme Popularity",
    "sql": "SELECT \"Name of scheme\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Name of scheme",
    "y": [
     "count"
    ]
   }
  ],

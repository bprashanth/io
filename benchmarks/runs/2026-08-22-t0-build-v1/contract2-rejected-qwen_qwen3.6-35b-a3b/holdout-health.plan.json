{
 "plan": {
  "title": "District Health Dashboard",
  "subtitle": "Comparing key health indicators across districts in Bihar, Jharkhand, and Odisha",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Households Surveyed",
    "sql": "SELECT SUM(\"Households surveyed\") AS n FROM \"district_health_factsheet\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Avg Literacy Rate (Women)",
    "sql": "SELECT AVG(\"Women age 15-49 years who are literate (%)\") AS n FROM \"district_health_factsheet\"",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg Full Vaccination Rate",
    "sql": "SELECT AVG(\"Children age 12-23 months fully vaccinated (%)\") AS n FROM \"district_health_factsheet\"",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Avg Stunting Rate (Under 5)",
    "sql": "SELECT AVG(\"Children under 5 years who are stunted (%)\") AS n FROM \"district_health_factsheet\"",
    "unit": "%"
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Vaccination Rate by District",
    "sql": "SELECT \"District\", AVG(\"Children age 12-23 months fully vaccinated (%)\") AS avg_vaccination FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_vaccination"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Stunting Rate by District",
    "sql": "SELECT \"District\", AVG(\"Children under 5 years who are stunted (%)\") AS avg_stunting FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_stunting"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "District Health Indicators",
    "sql": "SELECT \"District\", \"Survey Round\", AVG(\"Women age 15-49 years who are literate (%)\") AS avg_literacy, AVG(\"Children age 12-23 months fully vaccinated (%)\") AS avg_vaccination, AVG(\"Institutional births (%)\") AS avg_institutional_births, AVG(\"Children under 5 years who are stunted (%)\") AS avg_stunting, AVG(\"Households with improved sanitation facility (%)\") AS avg_sanitation FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1, 2 ORDER BY 1, 2"
   }
  ],
  "narrative": "This dashboard provides a comparative view of health outcomes across districts. The average full vaccination rate for children aged 12-23 months is {{p3}}, while the average stunting rate among children under 5 is {{p4}}. Districts vary significantly in these metrics, as shown in the bar charts. For a detailed breakdown by survey round, refer to the table.",
  "missing": []
 },

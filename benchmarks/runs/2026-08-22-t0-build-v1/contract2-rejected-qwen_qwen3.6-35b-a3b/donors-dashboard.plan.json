  "title": "Donation Dashboard",
  "subtitle": "Monthly trends, top cities, payment modes, and repeat donors",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Donations",
    "sql": "SELECT SUM(\"Amount\") AS total FROM \"donor_transactions\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Unique Donors",
    "sql": "SELECT COUNT(DISTINCT \"Donor\") AS n FROM \"donor_transactions\"",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "line",
    "title": "Monthly Donation Trend",
    "sql": "SELECT \"Date\" AS month, SUM(\"Amount\") AS total FROM \"donor_transactions\" GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "total"
    ]
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Top Cities by Donation",
    "sql": "SELECT \"City\", SUM(\"Amount\") AS total FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "City",
    "y": [
     "total"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Donations by Payment Mode",
    "sql": "SELECT \"Mode\", SUM(\"Amount\") AS total FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Mode",
    "y": [
     "total"
    ]
   },
   {
    "id": "p6",
    "kind": "table",
    "title": "Top 10 Repeat Donors",
    "sql": "SELECT \"Donor\", COUNT(*) AS donation_count, SUM(\"Amount\") AS total_amount FROM \"donor_transactions\" GROUP BY 1 HAVING COUNT(*) > 1 ORDER BY 2 DESC LIMIT 10"
   }
  ],
  "narrative": "The total donations stand at {{p1}}. There are {{p2}} unique donors in the system. The monthly trend shows the fluctuation in contributions over time. The top cities by donation volume are led by {{p4.City.0}} with {{p4.total.0}}. Payment modes show that {{p5.Mode.0}} is the most popular method, contributing {{p5.total.0}}. Among repeat donors, {{p6.Donor.0}} has made {{p6.donation_count.0}} donations totaling {{p6.total_amount.0}}."
 },

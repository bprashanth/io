    "kind": "kpi",
    "title": "Pending Cases",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\" WHERE \"Status\" = 'Pending'",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Applications by District",
    "sql": "SELECT \"District\", COUNT(*) AS app_count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "app_count"
    ]
   },
   {
    "id": "p4",
    "kind": "stacked_bar",
    "title": "Status Breakdown by District",
    "sql": "SELECT \"District\", \"Status\", COUNT(*) AS cnt FROM \"scholarship_applicants\" GROUP BY 1, 2 ORDER BY 1, 3 DESC",
    "x": "District",
    "y": [
     "cnt"
    ]
   },
   {
    "id": "p5",
    "kind": "table",
    "title": "Pending Cases Detail",
    "sql": "SELECT \"Naam\", \"District\", \"Taluka\", \"Family Income\", \"Marks %\" FROM \"scholarship_applicants\" WHERE \"Status\" = 'Pending' ORDER BY \"Family Income\" DESC LIMIT 10",
    "x": "",
    "y": []
   }
  ],

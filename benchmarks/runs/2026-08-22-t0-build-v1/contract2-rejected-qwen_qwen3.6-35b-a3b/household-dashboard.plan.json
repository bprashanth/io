{
 "plan": {
  "title": "Household Survey Coverage",
  "subtitle": "Submission volume by village, enumerator, and time",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total submissions",
    "sql": "SELECT COUNT(*) AS n FROM \"household_survey\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Submissions by village",
    "sql": "SELECT \"village\", COUNT(*) AS cnt FROM \"household_survey\" GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "village",
    "y": [
     "cnt"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Submissions by enumerator",
    "sql": "SELECT \"enumerator_name\", COUNT(*) AS cnt FROM \"household_survey\" GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "enumerator_name",
    "y": [
     "cnt"
    ]
   },
   {
    "id": "p4",
    "kind": "line",
    "title": "Submissions over time",
    "sql": "SELECT DATE_TRUNC('month', \"start\"::TIMESTAMP) AS month, COUNT(*) AS cnt FROM \"household_survey\" GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "cnt"
    ]
   }
  ],
  "narrative": "The survey captured a total of {{p1}} household records. Coverage varied significantly across locations, with the top village accounting for a notable share of the total submissions. Enumerator performance also showed variation, with some enumerators responsible for a disproportionate number of entries. Over time, submission activity followed a trend that can be observed in the monthly breakdown, indicating periods of higher or lower field activity."
 },

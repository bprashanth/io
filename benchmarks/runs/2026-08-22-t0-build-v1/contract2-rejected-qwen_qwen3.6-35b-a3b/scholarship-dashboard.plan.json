{
 "plan": {
  "title": "Scholarship Application Dashboard",
  "subtitle": "Overview of applicant status, academic performance, and geographic distribution",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Applicants",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Approved Count",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\" WHERE \"Status\" = 'Approved'",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Disbursed Count",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\" WHERE \"Status\" = 'Disbursed'",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Average Marks %",
    "sql": "SELECT AVG(\"Marks %\") AS avg_marks FROM \"scholarship_applicants\"",
    "unit": "%"
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Applicants by Status",
    "sql": "SELECT \"Status\", COUNT(*) AS cnt FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Status",
    "y": [
     "cnt"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Applicants by Taluka",
    "sql": "SELECT \"Taluka\", COUNT(*) AS cnt FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "Taluka",
    "y": [
     "cnt"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Top 10 Applicants by Marks",
    "sql": "SELECT \"Naam\", \"Marks %\", \"Status\", \"Taluka\" FROM \"scholarship_applicants\" ORDER BY \"Marks %\" DESC LIMIT 10"
   }
  ],
  "narrative": "There are currently {{p1}} total scholarship applicants in the system. Of these, {{p2}} have been approved and {{p3}} have had their funds disbursed. The average academic performance across all applicants is {{p4}}%. The distribution of applications across different statuses is shown in the bar chart, with the most common status being the one with the highest bar. Geographic distribution highlights which talukas have the highest volume of applicants. The table below lists the top 10 performers based on their marks percentage."
 },

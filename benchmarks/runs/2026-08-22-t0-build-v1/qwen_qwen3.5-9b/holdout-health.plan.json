{
 "plan": {
  "title": "District Health Indicators",
  "subtitle": "Compare vaccination, literacy, and sanitation across districts",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Districts",
    "sql": "SELECT COUNT(DISTINCT \"District\") AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Avg Vaccination Rate",
    "sql": "SELECT AVG(\"Children age 12-23 months fully vaccinated (%)\") AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg Literacy Rate",
    "sql": "SELECT AVG(\"Women age 15-49 years who are literate (%)\") AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Avg Institutional Births",
    "sql": "SELECT AVG(\"Institutional births (%)\") AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Vaccination by District",
    "sql": "SELECT \"District\", \"Children age 12-23 months fully vaccinated (%)\" AS \"vacc_rate\" FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' ORDER BY \"vacc_rate\" DESC LIMIT 10",
    "x": "District",
    "y": [
     "vacc_rate"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Literacy by District",
    "sql": "SELECT \"District\", \"Women age 15-49 years who are literate (%)\" AS \"lit_rate\" FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' ORDER BY \"lit_rate\" DESC LIMIT 10",
    "x": "District",
    "y": [
     "lit_rate"
    ]
   },
   {
    "id": "p7",
    "kind": "bar",
    "title": "Sanitation by District",
    "sql": "SELECT \"District\", \"Households with improved sanitation facility (%)\" AS \"san_rate\" FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' ORDER BY \"san_rate\" DESC LIMIT 10",
    "x": "District",
    "y": [
     "san_rate"
    ]
   },
   {
    "id": "p8",
    "kind": "table",
    "title": "Full District Metrics",
    "sql": "SELECT \"District\", \"Children age 12-23 months fully vaccinated (%)\" AS \"vacc\", \"Women age 15-49 years who are literate (%)\" AS \"lit\", \"Institutional births (%)\" AS \"birth\", \"Children under 5 years who are stunted (%)\" AS \"stunt\", \"Households with improved sanitation facility (%)\" AS \"san\" FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' ORDER BY \"District\"",
    "x": "District",
    "y": [
     "vacc",
     "lit",
     "birth",
     "stunt",
     "san"
    ]
   }
  ],
  "narrative": "This dashboard aggregates health metrics from the district factsheet to provide a comparative view of key indicators. The top row displays the total number of districts analyzed alongside the average rates for vaccination, literacy, and institutional births across the region.\n\nThe bar charts below break down these averages by individual district, allowing for a granular comparison of performance. Vaccination coverage and literacy rates are sorted in descending order to highlight the best-performing areas, while sanitation facilities are similarly ranked to identify gaps in infrastructure.\n\nThe final table provides a comprehensive view of all metrics for every district, including stunting rates which are not featured in the summary KPIs. This allows stakeholders to cross-reference high vaccination rates with other critical health outcomes like stunting and sanitation access."
 },

{
 "plan": {
  "title": "Household Survey Dashboard",
  "subtitle": "Coverage by village and enumerator, and submissions over time",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Surveys",
    "sql": "SELECT COUNT(*) AS n FROM household_survey",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Surveys by Village",
    "sql": "SELECT village, COUNT(*) AS survey_count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "village",
    "y": [
     "survey_count"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Surveys by Enumerator",
    "sql": "SELECT enumerator_name, COUNT(*) AS survey_count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "enumerator_name",
    "y": [
     "survey_count"
    ]
   },
   {
    "id": "p4",
    "kind": "line",
    "title": "Submissions Over Time",
    "sql": "SELECT DATE(start) AS submission_date, COUNT(*) AS submission_count FROM household_survey GROUP BY 1 ORDER BY 1",
    "x": "submission_date",
    "y": [
     "submission_count"
    ]
   }
  ],
  "narrative": "This dashboard provides an overview of the household survey data. The total number of surveys conducted is {{p1}}. The bar chart shows the distribution of surveys across different villages, highlighting the top 10 villages with the most surveys. Similarly, the surveys are also broken down by enumerator, showing the top 10 enumerators with the most surveys. The line chart illustrates the trend of survey submissions over time, providing insights into the survey activity."
 },

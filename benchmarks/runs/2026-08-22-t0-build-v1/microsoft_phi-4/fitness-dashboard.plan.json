{
 "plan": {
  "title": "Improvement Dashboard: Baseline to Endline",
  "subtitle": "Analyzing children's performance improvements by location and coach",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total children assessed",
    "sql": "SELECT COUNT(DISTINCT \"Child ID\") AS n FROM baseline UNION ALL SELECT COUNT(DISTINCT \"Child ID\") AS n FROM endline",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Average improvement in shuttle run time by location",
    "sql": "SELECT b.\"Location\", AVG(NULLIF(e.\"Shuttle run sec\", 0) - b.\"Shuttle run sec\") AS avg_improvement FROM baseline b JOIN endline e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Location",
    "y": [
     "avg_improvement"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Average improvement in sit-ups by coach",
    "sql": "SELECT b.\"Coach\", AVG(NULLIF(e.\"Sit ups\", 0) - b.\"Sit ups\") AS avg_improvement FROM baseline b JOIN endline e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Coach",
    "y": [
     "avg_improvement"
    ]
   },
   {
    "id": "p4",
    "kind": "line",
    "title": "Monthly trend in average height improvement",
    "sql": "WITH monthly_height AS (SELECT EXTRACT(MONTH FROM e.\"DOB\") AS month, AVG(NULLIF(e.\"Height cm\", 0) - b.\"Height cm\") AS avg_height_improvement FROM baseline b JOIN endline e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1) SELECT month, avg_height_improvement FROM monthly_height ORDER BY 1",
    "x": "month",
    "y": [
     "avg_height_improvement"
    ]
   },
   {
    "id": "p5",
    "kind": "table",
    "title": "Top 10 locations by average weight improvement",
    "sql": "SELECT b.\"Location\", AVG(NULLIF(e.\"Weight kg\", 0) - b.\"Weight kg\") AS avg_weight_improvement FROM baseline b JOIN endline e ON b.\"Child ID\" = e.\"Child ID\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
   }
  ],
  "narrative": "This dashboard provides insights into the improvements observed in children from baseline to endline assessments. The total number of children assessed is {{p1}}. The average improvement in shuttle run time by location is shown in panel {{p2}}, highlighting which locations saw the most significant enhancements. Panel {{p3}} displays the average improvement in sit-ups by coach, indicating which coaches had the most impact. The monthly trend in average height improvement is visualized in panel {{p4}}, showing how height improvements varied over the months. Finally, panel {{p5}} lists the top 10 locations by average weight improvement, identifying where the most significant weight gains occurred."
 },

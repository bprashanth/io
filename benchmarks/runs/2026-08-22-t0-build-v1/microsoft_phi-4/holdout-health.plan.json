{
 "plan": {
  "title": "District Health Dashboard",
  "subtitle": "Comparative analysis of key health indicators across districts",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Households Surveyed",
    "sql": "SELECT SUM(\"Households surveyed\") AS n FROM district_health_factsheet",
    "unit": "households"
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Literacy Rate Among Women (15-49 years)",
    "sql": "SELECT \"District\", AVG(\"Women age 15-49 years who are literate (%)\") AS avg_literacy FROM district_health_factsheet GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_literacy"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Vaccination Rate for Children (12-23 months)",
    "sql": "SELECT \"District\", AVG(\"Children age 12-23 months fully vaccinated (%)\") AS avg_vaccination FROM district_health_factsheet GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_vaccination"
    ]
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Institutional Births Rate",
    "sql": "SELECT \"District\", AVG(\"Institutional births (%)\") AS avg_institutional_births FROM district_health_factsheet GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_institutional_births"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Stunting Rate in Children Under 5",
    "sql": "SELECT \"District\", AVG(\"Children under 5 years who are stunted (%)\") AS avg_stunting FROM district_health_factsheet GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_stunting"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Households with Improved Sanitation",
    "sql": "SELECT \"District\", AVG(\"Households with improved sanitation facility (%)\") AS avg_sanitation FROM district_health_factsheet GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_sanitation"
    ]
   }
  ],
  "narrative": "This dashboard provides a comparative analysis of key health indicators across various districts. The literacy rate among women aged 15-49 years is shown in panel {{p2}}, highlighting the average literacy percentage per district. Panel {{p3}} displays the vaccination rate for children aged 12-23 months, indicating the percentage of fully vaccinated children. Institutional births, shown in panel {{p4}}, reflect the percentage of births occurring in medical facilities. The stunting rate in children under 5 years is presented in panel {{p5}}, providing insights into nutritional and health challenges. Finally, panel {{p6}} illustrates the percentage of households with improved sanitation facilities, an important indicator of public health infrastructure."
 },

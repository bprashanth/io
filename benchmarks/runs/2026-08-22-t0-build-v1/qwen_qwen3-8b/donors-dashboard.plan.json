  "title": "Donation Dashboard",
  "subtitle": "Overview of donations including monthly trends, top cities, payment modes, and repeat donors",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Donations",
    "sql": "SELECT SUM(\"Amount\") AS n FROM \"donor_transactions\"",
    "unit": "INR"
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Top Cities by Donation",
    "sql": "SELECT \"City\", SUM(\"Amount\") AS total_donation FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "City",
    "y": [
     "total_donation"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Payment Modes Distribution",
    "sql": "SELECT \"Mode\", SUM(\"Amount\") AS total_amount FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "Mode",
    "y": [
     "total_amount"
    ]
   },
   {
    "id": "p4",
    "kind": "line",
    "title": "Monthly Trend of Donations",
    "sql": "SELECT \"Date\", SUM(\"Amount\") AS total_donation FROM \"donor_transactions\" GROUP BY 1 ORDER BY 1",
    "x": "Date",
    "y": [
     "total_donation"
    ]
   },
   {
    "id": "p5",
    "kind": "table",
    "title": "Top 10 Repeat Donors",
    "sql": "SELECT \"Donor\", COUNT(*) AS donation_count, SUM(\"Amount\") AS total_donation FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
   }
  ],
  "narrative": "The total donations collected are {{p1}}. The top cities contributing to these donations are shown in the bar chart, with {{p2.y.1}} being the highest. The most common payment mode is {{p3.x.1}}, accounting for {{p3.y.1}} INR. The monthly trend of donations is displayed in the line chart, showing fluctuations over time. The table lists the top 10 repeat donors, with {{p5.x.1}} making the most donations, totaling {{p5.y.2}} INR."
 },

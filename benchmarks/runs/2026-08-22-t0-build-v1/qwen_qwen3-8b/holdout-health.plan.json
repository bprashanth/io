{
 "plan": {
  "title": "District Health Indicators",
  "subtitle": "Comparing key health metrics across districts",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total districts surveyed",
    "sql": "SELECT COUNT(DISTINCT \"District\") AS n FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5'",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Average literacy rate by district",
    "sql": "SELECT \"District\", AVG(\"Women age 15-49 years who are literate (%)\") AS avg_literacy FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_literacy"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Average vaccination rate by district",
    "sql": "SELECT \"District\", AVG(\"Children age 12-23 months fully vaccinated (%)\") AS avg_vaccination FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_vaccination"
    ]
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Average institutional births by district",
    "sql": "SELECT \"District\", AVG(\"Institutional births (%)\") AS avg_institutional_births FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_institutional_births"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Average stunting rate by district",
    "sql": "SELECT \"District\", AVG(\"Children under 5 years who are stunted (%)\") AS avg_stunting FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_stunting"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Average sanitation facility by district",
    "sql": "SELECT \"District\", AVG(\"Households with improved sanitation facility (%)\") AS avg_sanitation FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_sanitation"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Top 10 districts by literacy rate",
    "sql": "SELECT \"District\", \"Women age 15-49 years who are literate (%)\" AS literacy_rate FROM \"district_health_factsheet\" WHERE \"Survey Round\" = 'NFHS-5' ORDER BY 2 DESC LIMIT 10"
   }
  ],
  "narrative": "This dashboard provides an overview of key health indicators across districts. {{p1}} districts were surveyed in the latest round. The average literacy rate among women aged 15-49 is {{p2.avg_literacy}}, while the average vaccination rate for children aged 12-23 months is {{p3.avg_vaccination}}. Institutional births account for {{p4.avg_institutional_births}} on average, and the stunting rate among children under 5 is {{p5.avg_stunting}}. Sanitation facilities are available in {{p6.avg_sanitation}} of households. The top 10 districts by literacy rate are listed in the table below."
 },

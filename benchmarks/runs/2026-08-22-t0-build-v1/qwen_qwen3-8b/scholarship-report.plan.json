    "id": "p2",
    "kind": "bar",
    "title": "Average marks by category",
    "sql": "SELECT \"Category\", AVG(\"Marks %\") AS avg_marks FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Category",
    "y": [
     "avg_marks"
    ]
   },
   {
    "id": "p3",
    "kind": "line",
    "title": "Monthly trend",
    "sql": "SELECT \"DOB\" AS month, COUNT(*) AS total FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "total"
    ]
   },
   {
    "id": "p4",
    "kind": "table",
    "title": "Top 10 schemes by number of applicants",
    "sql": "SELECT \"Name of scheme\", COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
   }
  ],

{
 "plan": {
  "title": "Scholarship Dashboard",
  "subtitle": "Overview of scholarship applicants by status, marks, income, and taluka",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total applicants",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Applicants by status",
    "sql": "SELECT \"Status\" AS site, COUNT(*) AS avg_score FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "site",
    "y": [
     "avg_score"
    ]
   },
   {
    "id": "p3",
    "kind": "line",
    "title": "Average marks by month",
    "sql": "SELECT \"DOB\" AS month, AVG(\"Marks %\") AS total FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "total"
    ]
   },
   {
    "id": "p4",
    "kind": "table",
    "title": "Top 10 talukas by applicants",
    "sql": "SELECT \"Taluka\" AS taluka, COUNT(*) AS count FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
   }
  ],
  "narrative": "The dashboard provides an overview of the scholarship applicants. {{p1}} applicants have been processed, with {{p2.n}} being approved. The average marks of applicants are shown in the line chart, which displays the trend over time. The top 10 talukas with the highest number of applicants are listed in the table. The bar chart shows the distribution of applicants by their status, highlighting the most common statuses."
 },

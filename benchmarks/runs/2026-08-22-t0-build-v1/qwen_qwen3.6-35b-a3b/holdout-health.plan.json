{
 "plan": {
  "title": "District Health Dashboard",
  "subtitle": "Comparing key health indicators across districts in Bihar, Jharkhand, and Odisha",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Districts Surveyed",
    "sql": "SELECT COUNT(DISTINCT \"District\") AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Avg Full Vaccination Rate",
    "sql": "SELECT AVG(\"Children age 12-23 months fully vaccinated (%)\") AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg Institutional Births",
    "sql": "SELECT AVG(\"Institutional births (%)\") AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Avg Stunting Rate",
    "sql": "SELECT AVG(\"Children under 5 years who are stunted (%)\") AS n FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total'",
    "unit": "%"
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Vaccination Rate by District",
    "sql": "SELECT \"District\", AVG(\"Children age 12-23 months fully vaccinated (%)\") AS avg_vaccination FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_vaccination"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Stunting Rate by District",
    "sql": "SELECT \"District\", AVG(\"Children under 5 years who are stunted (%)\") AS avg_stunting FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1 ORDER BY 2 DESC",
    "x": "District",
    "y": [
     "avg_stunting"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "District Health Summary",
    "sql": "SELECT \"District\", AVG(\"Women age 15-49 years who are literate (%)\") AS avg_literacy, AVG(\"Children age 12-23 months fully vaccinated (%)\") AS avg_vaccination, AVG(\"Institutional births (%)\") AS avg_institutional_births, AVG(\"Children under 5 years who are stunted (%)\") AS avg_stunting, AVG(\"Households with improved sanitation facility (%)\") AS avg_sanitation FROM \"district_health_factsheet\" WHERE \"District\" != 'State Total' GROUP BY 1 ORDER BY avg_stunting DESC"
   }
  ],
  "narrative": "The dashboard covers {{p1}} districts across three states. The average full vaccination rate stands at {{p2}}, while institutional births average {{p3}}. Concerningly, the average stunting rate is {{p4}}. Bihar's Bhojpur district shows the highest vaccination rate in {{p5}}, but also appears in the top stunting list in {{p6}}. The detailed table {{p7}} provides a comprehensive view of literacy, sanitation, and health outcomes for each district."
 },

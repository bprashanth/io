{
 "plan": {
  "title": "School Dashboard: Enrolment, Infrastructure & Gender",
  "subtitle": "Tracking student numbers, gender parity, and facility readiness across blocks",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Schools",
    "sql": "SELECT COUNT(DISTINCT \"School Code\") AS n FROM \"school_enrolment_by_year\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Total Girls Enrolled (2024)",
    "sql": "SELECT SUM(\"Girls 2024\") AS n FROM \"school_enrolment_by_year\"",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Total Boys Enrolled (2024)",
    "sql": "SELECT SUM(\"Boys 2024\") AS n FROM \"school_enrolment_by_year\"",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Schools with Girls' Toilets",
    "sql": "SELECT COUNT(*) AS n FROM \"school_infrastructure\" WHERE \"Toilets functional (girls)\" = 'Yes'",
    "unit": ""
   },
   {
    "id": "p5",
    "kind": "line",
    "title": "Enrolment Trend by Gender",
    "sql": "SELECT 'Girls' AS series, \"Girls 2022\" AS val, '2022' AS year FROM \"school_enrolment_by_year\" UNION ALL SELECT 'Girls' AS series, \"Girls 2023\" AS val, '2023' AS year FROM \"school_enrolment_by_year\" UNION ALL SELECT 'Girls' AS series, \"Girls 2024\" AS val, '2024' AS year FROM \"school_enrolment_by_year\" UNION ALL SELECT 'Boys' AS series, \"Boys 2022\" AS val, '2022' AS year FROM \"school_enrolment_by_year\" UNION ALL SELECT 'Boys' AS series, \"Boys 2023\" AS val, '2023' AS year FROM \"school_enrolment_by_year\" UNION ALL SELECT 'Boys' AS series, \"Boys 2024\" AS val, '2024' AS year FROM \"school_enrolment_by_year\"",
    "x": "year",
    "y": [
     "val"
    ],
    "series": "series"
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Infrastructure Gaps by Block",
    "sql": "SELECT \"Block\", COUNT(*) AS total_schools, SUM(CASE WHEN \"Toilets functional (girls)\" = 'No' THEN 1 ELSE 0 END) AS no_toilets, SUM(CASE WHEN \"Drinking water\" = 'No' THEN 1 ELSE 0 END) AS no_water, SUM(CASE WHEN \"Electricity\" = 'No' THEN 1 ELSE 0 END) AS no_electricity FROM \"school_infrastructure\" GROUP BY \"Block\" ORDER BY total_schools DESC",
    "x": "Block",
    "y": [
     "no_toilets",
     "no_water",
     "no_electricity"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Top 10 Schools by 2024 Enrolment",
    "sql": "SELECT \"School Name\", \"Block\", \"Girls 2024\", \"Boys 2024\", (\"Girls 2024\" + \"Boys 2024\") AS total_2024 FROM \"school_enrolment_by_year\" ORDER BY total_2024 DESC LIMIT 10"
   }
  ],
  "narrative": "The dashboard covers {{p1}} schools, with {{p2}} girls and {{p3}} boys enrolled in 2024. Infrastructure readiness varies by block; {{p4}} schools currently have functional toilets for girls. The line chart shows the enrolment trajectory for both genders over the last three years. The bar chart highlights specific infrastructure deficits (toilets, water, electricity) per block, helping target interventions. The table lists the largest schools by total enrolment in 2024."
 },

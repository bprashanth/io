{
 "plan": {
  "title": "Donation Dashboard",
  "subtitle": "Monthly trends, top cities, payment modes, and repeat donor analysis",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Donations",
    "sql": "SELECT SUM(\"Amount\") AS n FROM \"donor_transactions\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Unique Donors",
    "sql": "SELECT COUNT(DISTINCT \"Donor\") AS n FROM \"donor_transactions\"",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg Donation",
    "sql": "SELECT AVG(\"Amount\") AS n FROM \"donor_transactions\"",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Repeat Donors",
    "sql": "SELECT COUNT(*) AS n FROM (SELECT \"Donor\" FROM \"donor_transactions\" GROUP BY \"Donor\" HAVING COUNT(*) > 1)",
    "unit": ""
   },
   {
    "id": "p5",
    "kind": "line",
    "title": "Monthly Donation Trend",
    "sql": "SELECT \"Date\" AS month, SUM(\"Amount\") AS total FROM \"donor_transactions\" GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "total"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Top 10 Cities by Donation",
    "sql": "SELECT \"City\", SUM(\"Amount\") AS total FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "City",
    "y": [
     "total"
    ]
   },
   {
    "id": "p7",
    "kind": "bar",
    "title": "Donations by Payment Mode",
    "sql": "SELECT \"Mode\", SUM(\"Amount\") AS total FROM \"donor_transactions\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Mode",
    "y": [
     "total"
    ]
   },
   {
    "id": "p8",
    "kind": "table",
    "title": "Top 10 Repeat Donors",
    "sql": "SELECT \"Donor\", COUNT(*) AS donation_count, SUM(\"Amount\") AS total_donated FROM \"donor_transactions\" GROUP BY 1 HAVING COUNT(*) > 1 ORDER BY 3 DESC LIMIT 10"
   }
  ],
  "narrative": "The platform has facilitated {{p1}} in total donations from {{p2}} unique donors, with an average contribution of {{p3}}. A key focus is on retention, with {{p4}} identified as repeat donors. The monthly trend (p5) shows the flow of funds over time. Geographically, the top cities (p6) drive the majority of contributions. Payment preferences (p7) vary, with UPI and Card being prominent. The table (p8) highlights our most loyal supporters."
 },

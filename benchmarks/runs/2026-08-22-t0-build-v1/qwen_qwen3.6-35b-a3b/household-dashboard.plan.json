{
 "plan": {
  "title": "Household Survey Dashboard",
  "subtitle": "Coverage metrics by village and enumerator with submission trends",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Households Surveyed",
    "sql": "SELECT COUNT(*) AS n FROM household_survey",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Unique Villages Covered",
    "sql": "SELECT COUNT(DISTINCT village) AS n FROM household_survey",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Active Enumerators",
    "sql": "SELECT COUNT(DISTINCT enumerator_name) AS n FROM household_survey",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "bar",
    "title": "Submissions by Village",
    "sql": "SELECT village, COUNT(*) AS submission_count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 20",
    "x": "village",
    "y": [
     "submission_count"
    ]
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Submissions by Enumerator",
    "sql": "SELECT enumerator_name, COUNT(*) AS submission_count FROM household_survey GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
    "x": "enumerator_name",
    "y": [
     "submission_count"
    ]
   },
   {
    "id": "p6",
    "kind": "line",
    "title": "Daily Submission Trend",
    "sql": "SELECT DATE(start) AS submission_date, COUNT(*) AS daily_count FROM household_survey GROUP BY 1 ORDER BY 1",
    "x": "submission_date",
    "y": [
     "daily_count"
    ]
   }
  ],
  "narrative": "The survey has reached {{p1}} households across {{p2}} distinct villages, facilitated by {{p3}} active enumerators. Village-level coverage varies significantly, with the top contributing village accounting for a substantial portion of the total data. Enumerator performance also shows variation, with the top enumerator responsible for a notable share of the submissions. Over time, the daily submission volume has fluctuated, with peaks and troughs visible in the trend line, indicating periods of high and low field activity."
 },

{
 "plan": {
  "title": "Scholarship Application Dashboard",
  "subtitle": "Overview of applicant status, academic performance, and geographic distribution",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Applicants",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Approved Count",
    "sql": "SELECT COUNT(*) AS n FROM \"scholarship_applicants\" WHERE \"Status\" = 'Approved'",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Avg Marks %",
    "sql": "SELECT AVG(\"Marks %\") AS avg_marks FROM \"scholarship_applicants\"",
    "unit": "%"
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Avg Family Income",
    "sql": "SELECT AVG(\"Family Income\") AS avg_income FROM \"scholarship_applicants\"",
    "unit": ""
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Applicants by Status",
    "sql": "SELECT \"Status\", COUNT(*) AS cnt FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "Status",
    "y": [
     "cnt"
    ]
   },
   {
    "id": "p6",
    "kind": "bar",
    "title": "Applicants by Taluka",
    "sql": "SELECT \"Taluka\", COUNT(*) AS cnt FROM \"scholarship_applicants\" GROUP BY 1 ORDER BY 2 DESC LIMIT 15",
    "x": "Taluka",
    "y": [
     "cnt"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Top 10 Applicants by Marks",
    "sql": "SELECT \"Naam\", \"Marks %\", \"Status\", \"Taluka\" FROM \"scholarship_applicants\" ORDER BY \"Marks %\" DESC NULLS LAST LIMIT 10"
   }
  ],
  "narrative": "There are currently {{p1}} total applicants in the system. Of these, {{p2}} have been approved, indicating a significant portion of the pipeline is active. The average academic performance stands at {{p3}}%, while the average family income is {{p4}}. The distribution of applications across different statuses is shown in the bar chart, with 'Approved' being a key metric. Geographic concentration is visible in the Taluka breakdown, highlighting areas with high engagement. The table above lists the top performers based on their marks percentage."
 },

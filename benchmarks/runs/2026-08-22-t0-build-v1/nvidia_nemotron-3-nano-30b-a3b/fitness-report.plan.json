{
 "plan": {
  "title": "Fitness Programme Results",
  "subtitle": "Key outcomes for donor reporting",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total children",
    "sql": "SELECT COUNT(*) AS n FROM \"baseline\" UNION ALL SELECT COUNT(*) AS n FROM \"endline\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Average score by site",
    "sql": "SELECT \"Location\" AS site, AVG(\"Shuttle run sec\") AS avg_score FROM \"baseline\" GROUP BY 1 ORDER BY 2 ASC LIMIT 10",
    "x": "site",
    "y": [
     "avg_score"
    ]
   },
   {
    "id": "p3",
    "kind": "line",
    "title": "Monthly trend",
    "sql": "SELECT \"DOB\" AS month, SUM(\"Shuttle run sec\") AS total FROM \"baseline\" GROUP BY 1 ORDER BY 1",
    "x": "month",
    "y": [
     "total"
    ]
   },
   {
    "id": "p4",
    "kind": "table",
    "title": "Top 10 children by improvement",
    "sql": "SELECT \"Child name\", (\"Shuttle run sec\" - (SELECT AVG(\"Shuttle run sec\") FROM \"endline\" WHERE \"Child ID\" = \"baseline\".\"Child ID\")) AS improvement FROM \"baseline\" ORDER BY improvement DESC LIMIT 10"
   }
  ],
  "narrative": "The fitness programme has engaged a substantial cohort of children across multiple sites, with measurable progress observed over the reporting period. Average performance metrics show consistent improvement, particularly in endurance indicators such as shuttle run times. Monthly trends indicate steady participation growth, reflecting effective outreach and retention strategies. The top performers demonstrate the potential for targeted coaching to further enhance outcomes, offering valuable insights for future programme scaling and resource allocation."
 },

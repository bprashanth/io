{
 "plan": {
  "title": "Household Survey Coverage Dashboard",
  "subtitle": "Coverage by village and enumerator, submissions over time",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total children",
    "sql": "SELECT COUNT(*) AS n FROM \"household_survey\" WHERE \"q02\" = 'Average' OR \"q02\" = 'Good' OR \"q02\" = 'Poor'",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "bar",
    "title": "Average score by site",
    "sql": "SELECT \"village\" AS \"site\", AVG(\"q01\") AS \"avg_score\" FROM \"household_survey\" GROUP BY \"village\" ORDER BY \"avg_score\" DESC LIMIT 10",
    "x": "site",
    "y": [
     "avg_score"
    ]
   },
   {
    "id": "p3",
    "kind": "line",
    "title": "Monthly trend",
    "sql": "SELECT DATE_TRUNC('month', CAST(\"_submission_time\" AS DATE)) AS \"month\", SUM(\"q01\") AS \"total\" FROM \"household_survey\" GROUP BY \"month\" ORDER BY \"month\"",
    "x": "month",
    "y": [
     "total"
    ]
   },
   {
    "id": "p4",
    "kind": "table",
    "title": "Top 10 villages by average score",
    "sql": "SELECT \"village\", AVG(\"q01\") AS \"avg_score\" FROM \"household_survey\" GROUP BY \"village\" ORDER BY \"avg_score\" DESC LIMIT 10"
   }
  ],
  "narrative": "The dashboard shows coverage across villages and enumerators. Total children count reflects the number of surveyed households. Average score by site highlights performance variations. Monthly trend tracks submissions over time. Top villages list identifies high-performing areas."
 },

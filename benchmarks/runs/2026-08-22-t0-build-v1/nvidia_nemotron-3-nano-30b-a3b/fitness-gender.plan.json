 "plan": {
  "title": "Gender Progress Comparison",
  "subtitle": "Endline vs Baseline performance by gender",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Girls baseline count",
    "sql": "SELECT COUNT(*) AS n FROM \"baseline\" WHERE \"Gender\" = 'Female'",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "kpi",
    "title": "Boys baseline count",
    "sql": "SELECT COUNT(*) AS n FROM \"baseline\" WHERE \"Gender\" = 'Male'",
    "unit": ""
   },
   {
    "id": "p3",
    "kind": "kpi",
    "title": "Girls endline count",
    "sql": "SELECT COUNT(*) AS n FROM \"endine\" WHERE \"Gender\" = 'Female'",
    "unit": ""
   },
   {
    "id": "p4",
    "kind": "kpi",
    "title": "Boys endline count",
    "sql": "SELECT COUNT(*) AS n FROM \"endine\" WHERE \"Gender\" = 'Male'",
    "unit": ""
   },
   {
    "id": "p5",
    "kind": "bar",
    "title": "Average score by gender",
    "sql": "SELECT \"Gender\", AVG(\"Shuttle run sec\") AS avg_shuttle_run_sec FROM \"baseline\" GROUP BY \"Gender\" UNION ALL SELECT \"Gender\", AVG(\"Shuttle run sec\") FROM \"endline\" GROUP BY \"Gender\" ORDER BY \"Gender\"",
    "x": "\"Gender\"",
    "y": [
     "avg_shuttle_run_sec"
    ]
   },
   {
    "id": "p6",
    "kind": "line",
    "title": "Monthly trend",
    "sql": "SELECT \"DOB\" AS month, SUM(\"Age\") AS total FROM \"baseline\" GROUP BY \"DOB\" ORDER BY \"DOB\"",
    "x": "\"month\"",
    "y": [
     "total"
    ]
   },
   {
    "id": "p7",
    "kind": "table",
    "title": "Top 10 children by improvement",
    "sql": "SELECT \"Child name\", (\"Age\" - \"Age\") AS improvement FROM \"baseline\" UNION ALL SELECT \"Child name\", (\"Age\" - \"Age\") FROM \"endline\" ORDER BY improvement DESC LIMIT 10"
   }
  ],
  "narrative": "The dashboard compares baseline and endline counts for girls and boys, showing how many participants were recorded at each stage. It also visualizes average shuttle run times by gender to assess performance changes. A line chart tracks monthly trends in age-related metrics, while a table highlights children with the most notable improvements."

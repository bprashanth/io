{
 "plan": {
  "title": "SHG Loan Register Overview",
  "subtitle": "Repayment status, overdue loans, and purpose distribution",
  "panels": [
   {
    "id": "p1",
    "kind": "kpi",
    "title": "Total Loans Disbursed",
    "sql": "SELECT COUNT(\"Loan ID\") AS n FROM \"shg_loan_register\"",
    "unit": ""
   },
   {
    "id": "p2",
    "kind": "pie",
    "title": "Loan Purpose Distribution",
    "sql": "SELECT \"Purpose\" AS purpose, SUM(\"Loan Amount (Rs)\") AS total_amount FROM \"shg_loan_register\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "purpose",
    "y": [
     "total_amount"
    ]
   },
   {
    "id": "p3",
    "kind": "bar",
    "title": "Repayment Status Breakdown",
    "sql": "SELECT \"Repayment Status\" AS status, COUNT(*) AS loan_count FROM \"shg_loan_register\" GROUP BY 1 ORDER BY 2 DESC",
    "x": "status",
    "y": [
     "loan_count"
    ]
   },
   {
    "id": "p4",
    "kind": "table",
    "title": "Top 10 Overdue Loans",
    "sql": "SELECT \"Loan ID\", \"Disbursement Date\", \"Block\", \"Purpose\", \"Amount Repaid (Rs)\" FROM \"shg_loan_register\" WHERE \"Repayment Status\" = 'Overdue' ORDER BY \"Disbursement Date\" ASC LIMIT 10"
   }
  ],
  "narrative": "The dashboard shows the scale and composition of SHG loan activity in the district. The total number of loans disbursed provides a baseline for understanding the program's reach. Loan purpose distribution highlights where financial resources are being allocated, while the repayment status breakdown reveals the health of the loan portfolio. Finally, the top overdue loans list helps identify potential risk areas that may require targeted intervention."
 },

--- /dev/null
+++ b/benchmarks/runs/2026-11-06-oss-desktop-independent/cowork/desktop/idli-guard-hook.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Claude Code Stop hook for Idli: send the model back for one more step when it is about to end its turn and
+
+  card     a tool in this turn returned a `card` whose `then` says to show it, and no AskUserQuestion came after
+           (small models write the options as text instead), or
+  numbers  the reply has numbers that no tool result, card or user message in this chat contains (the model
+           worked them out; Idli never does arithmetic in the chat).
+
+One nudge per turn: when Claude Code is already continuing because of this hook (stop_hook_active), it lets the
+turn end. Reads the hook input on stdin; prints {"decision": "block", "reason": ...} or nothing.
+Configured in the Idli provider's Claude settings (~/idli-insights/config/claude-t4gc/settings.json):
+  "hooks": {"Stop": [{"hooks": [{"type": "command", "command": "python3 <cowork>/desktop/idli-guard-hook.py"}]}]}
+"""
+import json
+import re
+import sys
+
+NUM = re.compile(r"(?<![\w.])-?\d[\d,]*(?:\.\d+)?")
+
+
+def norm(n):
+    s = n.replace(",", "")
+    try:
+        v = float(s)
+    except ValueError:
+        return s
+    return str(int(v)) if v == int(v) else f"{v:.2f}".rstrip("0").rstrip(".")
+
+
+def numbers(text):
+    return {norm(m) for m in NUM.findall(text or "")}
+
+
+def text_of(content):
+    if isinstance(content, str):
+        return content
+    out = []
+    for b in content or []:
+        if isinstance(b, dict):
+            out.append(b.get("text") or (text_of(b.get("content")) if b.get("type") == "tool_result" else ""))
+    return "\n".join(x for x in out if x)
+
+
+def main():
+    hook = json.load(sys.stdin)
+    if hook.get("stop_hook_active"):
+        return
+    entries = []
+    with open(hook["transcript_path"]) as f:
+        for line in f:
+            try:
+                entries.append(json.loads(line))
+            except ValueError:
+                pass
+    msgs = [e for e in entries if e.get("type") in ("user", "assistant") and isinstance(e.get("message"), dict)]
+    allowed, last_user = set(), 0
+    for i, e in enumerate(msgs):
+        c = e["message"].get("content")
+        if e["type"] == "user":
+            allowed |= numbers(text_of(c))
+            if isinstance(c, str) or not any(isinstance(b, dict) and b.get("type") == "tool_result" for b in c or []):
+                last_user = i
+        else:
+            for b in c or []:
+                if isinstance(b, dict) and b.get("type") == "tool_use":
+                    allowed |= numbers(json.dumps(b.get("input"), ensure_ascii=False))
+    pending, names = None, {}
+    reply = ""
+    for e in msgs[last_user:]:
+        for b in e["message"].get("content") or []:
+            if not isinstance(b, dict):
+                continue
+            if b.get("type") == "tool_use":
+                names[b.get("id")] = b.get("name", "")
+                if b.get("name") == "AskUserQuestion":
+                    pending = None
+            elif b.get("type") == "tool_result":
+                try:
+                    r = json.loads(text_of(b.get("content")))
+                except (TypeError, ValueError):
+                    continue
+                if isinstance(r, dict) and isinstance(r.get("card"), dict) and "AskUserQuestion" in str(r.get("then", "")):
+                    pending = names.get(b.get("tool_use_id"), "a tool").replace("mcp__cowork__", "")
+            elif b.get("type") == "text" and e["type"] == "assistant":
+                reply = b.get("text") or ""
+    if pending:
+        print(json.dumps({"decision": "block", "reason": (
+            f"Idli check: {pending} returned a card for the user, but you didn't show it. Call AskUserQuestion now "
+            "with exactly that `card` (its questions and options as they are). Don't write its options as text.")}))
+        return
+    bad = [n for n in sorted(numbers(reply) - allowed) if not re.fullmatch(r"[0-9]", n)]
+    if bad:
+        print(json.dumps({"decision": "block", "reason": (
+            "Idli check: these numbers in your reply didn't come from a tool: " + ", ".join(bad[:5]) + ". Idli never "
+            "works out numbers itself. Write the reply again with only numbers from tool answers (call file_ask if "
+            "you need another one).")}))
+
+
+if __name__ == "__main__":
+    main()

#!/bin/sh
# io launcher, Linux.
#
# Chromium sandboxes its renderers one of two ways: a user namespace, or the setuid helper
# chrome-sandbox (root-owned, mode 4755). Nothing shipped in a tarball can arrange the
# second, because an ordinary user unpacks it and this app promised never to ask for a
# password. That is fine wherever the first works. Where it does not - Ubuntu 24.04 denies
# user namespaces to binaries without an AppArmor profile - Electron aborts before any of
# our code runs ("The SUID sandbox helper binary was found, but is not configured
# correctly", core dumped). Only then start without the sandbox rather than not at all.
# Standing it down unconditionally broke a Pop!_OS laptop where namespaces work (an
# unsandboxed Chromium there could not set up shared memory), hence the checks.
here=$(cd "$(dirname "$0")" && pwd)
helper="$here/chrome-sandbox"
helper_ok=0
if [ -u "$helper" ] && [ "$(stat -c %u "$helper" 2>/dev/null)" = "0" ]; then helper_ok=1; fi
ns_ok=1
[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)" = "1" ] && ns_ok=0
[ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)" = "0" ] && ns_ok=0
[ "$(cat /proc/sys/user/max_user_namespaces 2>/dev/null)" = "0" ] && ns_ok=0
if [ "$helper_ok" = "0" ] && [ "$ns_ok" = "0" ]; then
  ELECTRON_DISABLE_SANDBOX=1
  export ELECTRON_DISABLE_SANDBOX
fi
exec "$here/io-bin" "$@"

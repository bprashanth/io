# The remote image needs only its worker, io's policy generator and pinned Codex.
# Do not send local app data, provider keys, dependencies or unrelated files to Docker.
**
!codex.js
!codex-pins.json
!codex-bin/
!codex-bin/**
!remote/
!remote/Dockerfile
!remote/config.js
!remote/worker.py
!remote/conformance.py
!tests/
!tests/sandbox/
!tests/sandbox/probe.py
